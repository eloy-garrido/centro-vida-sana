  function getAvailableDates(): Array<{ dateStr: string; weekday: number; dayNum: number; monthName: string }> {
    const list: Array<{ dateStr: string; weekday: number; dayNum: number; monthName: string }> = [];
    const monthsEs = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    const now = new Date();

    for (let i = 1; i <= 7; i++) {
      const targetTime = new Date(now.getTime() + i * 24 * 60 * 60 * 1000);
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Santiago',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric'
      }).formatToParts(targetTime);

      const partMap: Record<string, number> = {};
      for (const p of parts) {
        if (p.type !== 'literal') partMap[p.type] = parseInt(p.value, 10);
      }

      const yyyy = partMap.year;
      const mm = String(partMap.month).padStart(2, '0');
      const dd = String(partMap.day).padStart(2, '0');
      const dateStr = `${yyyy}-${mm}-${dd}`;

      const noonUtc = new Date(Date.UTC(yyyy, partMap.month - 1, partMap.day, 12, 0, 0));
      const weekday = noonUtc.getUTCDay();

      if (weekday === 0) continue; // Cerrado domingos

      list.push({
        dateStr,
        weekday,
        dayNum: partMap.day,
        monthName: monthsEs[partMap.month - 1]
      });
    }
    return list;
  }

  function applyDatePillClasses(btn: HTMLButtonElement, isSelected: boolean, triggerPop = false, isFull = false) {
    const popClass = triggerPop ? 'animate-pill-pop' : '';
    if (isSelected) {
      btn.className = `date-pill shrink-0 flex flex-col items-center justify-center w-16 h-20 py-2.5 px-2 rounded-xl border-2 select-none text-center cursor-pointer font-medium transition-all duration-150 ease-out border-slate-900 bg-slate-900 text-white shadow-xs active:scale-[0.94] ${popClass}`;
    } else if (isFull) {
      btn.className = 'date-pill shrink-0 flex flex-col items-center justify-center w-16 h-20 py-2.5 px-2 rounded-xl border border-dashed border-slate-200 bg-slate-50 text-slate-400 select-none text-center cursor-pointer transition-all duration-150 ease-out hover:border-slate-300';
    } else {
      btn.className = 'date-pill shrink-0 flex flex-col items-center justify-center w-16 h-20 py-2.5 px-2 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-400 hover:scale-[1.02] text-slate-700 select-none text-center cursor-pointer transition-all duration-150 ease-out active:scale-[0.94]';
    }
  }

  function renderDatePills() {
    datePillsRow.innerHTML = '';
    const daysEs = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
    const availableDates = getAvailableDates();

    if (!selectedDateString || !availableDates.some((d) => d.dateStr === selectedDateString)) {
      if (availableDates.length > 0) {
        selectedDateString = availableDates[0].dateStr;
      }
    }

    availableDates.forEach((d, index) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-date-str', d.dateStr);
      const isSelected = selectedDateString === d.dateStr;

      const daySlots = slotsByDate.get(d.dateStr) || [];
      const freeCount = daySlots.filter((s) => s.available !== false).length;
      const isCompletelyFull = daySlots.length > 0 && freeCount === 0;

      applyDatePillClasses(btn, isSelected, false, isCompletelyFull);
      btn.classList.add('animate-slot-enter');
      btn.style.animationDelay = `${index * 30}ms`;

      btn.innerHTML = `
        <span class="text-[10px] font-semibold tracking-wider uppercase opacity-80">${daysEs[d.weekday]}</span>
        <span class="text-lg font-bold leading-none my-1">${d.dayNum}</span>
        <span class="text-[10px] font-medium opacity-80">${d.monthName}</span>
        ${isCompletelyFull ? '<span class="text-[9px] font-bold text-red-500 uppercase tracking-tighter mt-0.5">Lleno</span>' : ''}
      `;

      btn.addEventListener('click', () => {
        if (selectedDateString === d.dateStr) return;
        selectedDateString = d.dateStr;
        selectedSlotUtc = null;
        updateStep2NextButton();

        datePillsRow.querySelectorAll<HTMLButtonElement>('.date-pill').forEach((p) => {
          const pDate = p.getAttribute('data-date-str')!;
          const pSlots = slotsByDate.get(pDate) || [];
          const pFull = pSlots.length > 0 && pSlots.filter((s) => s.available !== false).length === 0;
          const isPillSelected = pDate === selectedDateString;
          applyDatePillClasses(p, isPillSelected, isPillSelected, pFull);
        });

        renderSlotsForSelectedDate();
      });

      datePillsRow.appendChild(btn);
    });
  }

  function applySlotButtonClasses(btn: HTMLButtonElement, isSelected: boolean, triggerPop = false) {
    const popClass = triggerPop ? 'animate-slot-pop' : '';
    btn.className = isSelected
      ? `slot-btn min-h-[64px] py-3.5 px-3 rounded-xl border-2 font-semibold text-xs transition-all duration-150 ease-out text-center flex flex-col items-center justify-center cursor-pointer transform scale-[1.02] border-slate-900 bg-slate-900 text-white shadow-md ring-2 ring-slate-900 ring-offset-2 active:scale-[0.97] ${popClass}`
      : 'slot-btn min-h-[64px] py-3.5 px-3 rounded-xl border-2 font-semibold text-xs transition-all duration-150 ease-out text-center flex flex-col items-center justify-center border-slate-200 hover:border-slate-800 hover:scale-[1.02] hover:bg-slate-50 bg-white text-slate-800 cursor-pointer active:scale-[0.95]';
  }

  function updateSlotButtons(triggeredSlotUtc: string | null = null) {
    const allSlots = slotsButtonsGrid.querySelectorAll<HTMLButtonElement>('.slot-btn');
    allSlots.forEach((btn) => {
      const slotUtc = btn.getAttribute('data-slot-utc');
      const isSelected = Boolean(selectedSlotUtc && slotUtc === selectedSlotUtc);
      const isTriggered = Boolean(triggeredSlotUtc && slotUtc === triggeredSlotUtc);
      applySlotButtonClasses(btn, isSelected, isTriggered);
    });

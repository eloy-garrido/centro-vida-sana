  /**
   * Formatea un RUT en tiempo real agregando puntos y guion mientras el usuario escribe.
   */
  function formatRutLive(val: string): string {
    const cleaned = cleanRut(val);
    if (!cleaned) return '';
    if (cleaned.length === 1) return cleaned;

    // Máximo 9 caracteres (8 cuerpo + 1 dv)
    const sliced = cleaned.slice(0, 9);
    const cuerpo = sliced.slice(0, -1);
    const dv = sliced.slice(-1);

    let formattedCuerpo = '';
    let count = 0;
    for (let i = cuerpo.length - 1; i >= 0; i--) {
      formattedCuerpo = cuerpo[i] + formattedCuerpo;
      count++;
      if (count % 3 === 0 && i > 0) {
        formattedCuerpo = '.' + formattedCuerpo;
      }
    }

    return `${formattedCuerpo}-${dv}`;
  }

  /**
   * Formatea el teléfono móvil chileno anteponiendo automáticamente '+56 9 ' y separando dígitos.
   */
  function formatPhoneLive(val: string): string {
    const trimmed = val.trim();
    if (!trimmed) return '';

    // Extraer únicamente los dígitos numéricos
    let digits = val.replace(/\D/g, '');

    // Descontar prefijo país 569 o 56 si el usuario lo incluyó
    if (digits.startsWith('569')) {
      digits = digits.slice(3);
    } else if (digits.startsWith('56')) {
      digits = digits.slice(2);
    } else if (digits.length === 9 && digits.startsWith('9')) {
      // Si escribió 9XXXXXXXX (9 dígitos incluyendo el 9)
      digits = digits.slice(1);
    }

    // Máximo 8 dígitos de número de abonado móvil chileno
    digits = digits.slice(0, 8);

    if (digits.length === 0) {
      return '+56 9 ';
    }
    if (digits.length <= 4) {
      return `+56 9 ${digits}`;
    }
    return `+56 9 ${digits.slice(0, 4)} ${digits.slice(4)}`;
  }

  // Auto-formato de RUT en vivo
  stepInputRut.addEventListener('input', () => {
    if (stepInputDocType.value === 'rut') {
      const formatted = formatRutLive(stepInputRut.value);
      stepInputRut.value = formatted;

      // Si ya tiene longitud completa (mínimo 7 u 8 dígitos cuerpo + dv)
      const cleaned = cleanRut(stepInputRut.value);
      if (cleaned.length >= 8) {
        if (validateChileanRut(cleaned)) {
          errStepRut.classList.add('hidden');
          stepInputRut.classList.remove('border-red-400');
        }
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
      }
    }
  });

  // Validación de RUT al perder el foco (blur)
  stepInputRut.addEventListener('blur', () => {
    const raw = stepInputRut.value.trim();
    if (!raw) {
      errStepRut.classList.add('hidden');
      stepInputRut.classList.remove('border-red-400');
      return;
    }

    if (stepInputDocType.value === 'rut') {
      const isValid = validateChileanRut(raw);
      if (!isValid) {
        errStepRut.textContent = 'El RUT ingresado no es válido. Revisa los dígitos y el dígito verificador.';
        errStepRut.classList.remove('hidden');
        stepInputRut.classList.add('border-red-400');
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
        stepInputRut.value = formatChileanRut(raw);
      }
    } else {
      // Pasaporte
      if (!/^[A-Za-z0-9\-]{4,20}$/.test(raw)) {
        errStepRut.textContent = 'El pasaporte debe tener entre 4 y 20 caracteres alfanuméricos.';
        errStepRut.classList.remove('hidden');
        stepInputRut.classList.add('border-red-400');
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
        stepInputRut.value = raw.toUpperCase();
      }
    }
  });

  // Cambio de tipo de documento (RUT / Pasaporte)
  stepInputDocType.addEventListener('change', () => {
    if (stepInputDocType.value === 'rut') {
      stepInputRut.placeholder = '12.345.678-5';
      if (stepInputRut.value.trim()) {
        stepInputRut.value = formatRutLive(stepInputRut.value);
      }
    } else {
      stepInputRut.placeholder = 'Pasaporte (ej: A1234567)';
      stepInputRut.value = stepInputRut.value.replace(/[^A-Za-z0-9\-]/g, '').toUpperCase();
    }
    errStepRut.classList.add('hidden');
    stepInputRut.classList.remove('border-red-400');
  });

  // Auto-prefijo y formato de Teléfono en vivo
  stepInputPhone.addEventListener('focus', () => {
    if (!stepInputPhone.value.trim()) {
      stepInputPhone.value = '+56 9 ';
    }
  });

  stepInputPhone.addEventListener('input', () => {
    const current = stepInputPhone.value;
    if (!current || current === '+' || current === '+5' || current === '+56' || current === '+56 ') {
      return; // permitir borrar libremente sin atrapar al usuario
    }
    stepInputPhone.value = formatPhoneLive(current);

    const digits = stepInputPhone.value.replace(/\D/g, '');
    if (digits.length >= 11 || digits.length === 8) {
      errStepPhone.classList.add('hidden');
      stepInputPhone.classList.remove('border-red-400');
    }
  });

  stepInputPhone.addEventListener('blur', () => {
    const trimmed = stepInputPhone.value.trim();
    if (trimmed === '+56 9' || trimmed === '+56 9 ' || trimmed === '+56' || trimmed === '+') {
      stepInputPhone.value = '';
      errStepPhone.classList.add('hidden');
      stepInputPhone.classList.remove('border-red-400');
      return;
    }

    if (trimmed) {
      const digits = trimmed.replace(/\D/g, '');
      if (digits.length < 11 && digits.length < 8) {
        errStepPhone.textContent = 'Ingresa un número telefónico válido (ej: +56 9 1234 5678).';
        errStepPhone.classList.remove('hidden');
        stepInputPhone.classList.add('border-red-400');
      } else {
        errStepPhone.classList.add('hidden');
        stepInputPhone.classList.remove('border-red-400');
      }
    }
  });

  btnStep3Next.addEventListener('click', () => {
    // Validar campos
    let valid = true;

    const nameVal = stepInputName.value.trim();
    if (!nameVal) {
      errStepName.textContent = 'Ingresa el nombre y apellido del paciente.';
      errStepName.classList.remove('hidden');
      stepInputName.classList.add('border-red-400');
      valid = false;
    } else if (nameVal.split(/\s+/).length < 2) {
      errStepName.textContent = 'Ingresa al menos un nombre y un apellido (ej: Eloy Garrido).';
      errStepName.classList.remove('hidden');
      stepInputName.classList.add('border-red-400');
      valid = false;
    } else {
      errStepName.classList.add('hidden');
      stepInputName.classList.remove('border-red-400');
    }

    if (!stepInputRut.value.trim()) {
      errStepRut.textContent = 'Ingresa el documento de identidad.';
      errStepRut.classList.remove('hidden');
      stepInputRut.classList.add('border-red-400');
      valid = false;
    } else if (stepInputDocType.value === 'rut') {
      const isValid = validateChileanRut(stepInputRut.value);
      if (!isValid) {
        errStepRut.textContent = 'El RUT ingresado no es válido. Revisa los dígitos y el dígito verificador.';
        errStepRut.classList.remove('hidden');
        stepInputRut.classList.add('border-red-400');
        valid = false;
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
      }
    } else {
      if (!/^[A-Za-z0-9\-]{4,20}$/.test(stepInputRut.value.trim())) {
        errStepRut.textContent = 'El pasaporte debe tener entre 4 y 20 caracteres alfanuméricos.';
        errStepRut.classList.remove('hidden');
        stepInputRut.classList.add('border-red-400');
        valid = false;
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
      }
    }

    if (!stepInputEmail.value.trim() || !stepInputEmail.value.includes('@')) {
      errStepEmail.textContent = 'Ingresa un correo electrónico válido.';
      errStepEmail.classList.remove('hidden');
      stepInputEmail.classList.add('border-red-400');
      valid = false;
    } else {
      errStepEmail.classList.add('hidden');
      stepInputEmail.classList.remove('border-red-400');
    }

    if (!stepInputPhone.value.trim()) {
      errStepPhone.textContent = 'Ingresa un teléfono de contacto.';
      errStepPhone.classList.remove('hidden');
      stepInputPhone.classList.add('border-red-400');
      valid = false;
    } else {
      const phoneDigits = stepInputPhone.value.replace(/\D/g, '');
      if (phoneDigits.length < 11 && phoneDigits.length < 8) {
        errStepPhone.textContent = 'Ingresa un número telefónico válido (ej: +56 9 1234 5678).';
        errStepPhone.classList.remove('hidden');
        stepInputPhone.classList.add('border-red-400');
        valid = false;
      } else {
        errStepPhone.classList.add('hidden');
        stepInputPhone.classList.remove('border-red-400');
      }
    }

    if (!currentSession || !currentSession.authenticated) {
      alert('Debes identificarte con tu cuenta Google para continuar.');
      return;
    }

    if (!valid) return;

    // Actualizar Resumen en Paso 4
    finalSummaryPro.textContent = selectedProfessionalId === 'felipe'
      ? 'Felipe Méndez · Quiropraxia & Kinesiología'
      : 'Eduardo Lagos · Acupuntura & Medicina China';
    finalSummaryPro.className = 'font-bold text-slate-900 text-sm';

    const d = new Date(selectedSlotUtc!);
    const dateFormatted = d.toLocaleDateString('es-CL', { timeZone: 'America/Santiago', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const timeFormatted = d.toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hour12: false });
    finalSummaryTime.textContent = `${dateFormatted}, ${timeFormatted} hrs`;

    finalSummaryPatient.textContent = `${stepInputName.value.trim()} (${stepInputRut.value.trim()})`;
    finalSummaryContact.textContent = `${stepInputPhone.value.trim()} · ${stepInputEmail.value.trim()}`;

    regenerateIdempotencyKey();
    goToStep(4);
  });

  // ==========================================================================
  // PASO 4: CONFIRMACIÓN Y COMMIT ATÓMICO
  // ==========================================================================
  btnStep4Back.addEventListener('click', () => goToStep(3));

  finalConsentCheck.addEventListener('change', () => {
    const isChecked = finalConsentCheck.checked;
    btnFinalConfirm.disabled = !isChecked;
    if (isChecked) {
      btnFinalConfirm.removeAttribute('disabled');
      btnFinalConfirm.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      btnFinalConfirm.setAttribute('disabled', 'true');
      btnFinalConfirm.classList.add('opacity-50', 'cursor-not-allowed');
    }
  });

  btnFinalConfirm.addEventListener('click', async () => {
    if (!currentSession || !currentSession.csrfToken) return;

    btnFinalConfirm.disabled = true;
    btnFinalText.textContent = 'Confirmando tu reserva...';
    btnFinalSpinner.classList.remove('hidden');
    finalBookingError.classList.add('hidden');

    try {
      // Guardar perfil si se seleccionó recordar
      if (stepCheckRemember.checked) {
        try {
          await AgendamientoClient.savePatientProfile(
            {
              name: stepInputName.value.trim(),
              email: stepInputEmail.value.trim(),
              rut: stepInputRut.value.trim(),
              documentType: stepInputDocType.value as any,
              phone: stepInputPhone.value.trim()
            },
            rememberedProfileVersion,
            currentSession.csrfToken
          );
        } catch {
          // Fallo de guardado de perfil no impide la reserva
        }
      }

      // Enviar comando atómico con idempotencia
      const res = await AgendamientoClient.createBooking(
        {
          professionalId: selectedProfessionalId!,
          startAt: selectedSlotUtc!,
          patient: {
            name: stepInputName.value.trim(),
            email: stepInputEmail.value.trim(),
            rut: stepInputRut.value.trim(),
            documentType: stepInputDocType.value as any,
            phone: stepInputPhone.value.trim()
          },
          consentVersion: 'v1.0'
        },
        currentIdempotencyKey,
        currentSession.csrfToken
      );

      // Mostrar pantalla de éxito (Paso 5)
      showSuccessView(res.result.resourceId);
    } catch (err: any) {
      btnFinalConfirm.disabled = false;
      btnFinalText.textContent = 'Confirmar y Agendar Cita';
      btnFinalSpinner.classList.add('hidden');

      if (err instanceof ApiError && err.code === 'SLOT_CONFLICT') {
        loadedAvailabilityForPro = null;
        slotsByDate.clear();
        selectedSlotUtc = null;
        regenerateIdempotencyKey();
        finalBookingError.textContent = 'El horario seleccionado ya no está disponible. Por favor regresa al paso 2 y elige otro cupo.';
      } else {
        finalBookingError.textContent = err.message || 'Error al confirmar la reserva. Intenta nuevamente.';
      }
      finalBookingError.classList.remove('hidden');
    }
  });

  // ==========================================================================
  // PASO 5: ÉXITO Y COPIA A CALENDARIO
  // ==========================================================================
  function setupCalendarExportUI(googleUrl: string, icsUrl: string) {
    const ua = navigator.userAgent || '';
    const platform = (navigator as any).userAgentData?.platform || navigator.platform || '';
    const isIOS = /iPhone|iPad|iPod/i.test(ua) || (platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isMac = (/Macintosh|Mac OS X/i.test(ua) || platform === 'macOS') && !isIOS;
    const isApple = isIOS || isMac;
    const isAndroid = /Android/i.test(ua);
    const isMobile = isIOS || isAndroid || /Mobile|Tablet/i.test(ua);

    const btnGoogle = document.getElementById('btn-google-calendar') as HTMLAnchorElement | null;
    const btnGoogleText = document.getElementById('btn-google-text');
    const btnIcs = document.getElementById('btn-ics-calendar') as HTMLAnchorElement | null;
    const btnIcsText = document.getElementById('btn-ics-text');
    const btnIcsIconCalendar = document.getElementById('btn-ics-icon-calendar');
    const btnIcsIconApple = document.getElementById('btn-ics-icon-apple');

    const secondaryWrap = document.getElementById('calendar-secondary-wrap');
    const secondaryIntro = document.getElementById('calendar-secondary-intro');
    const secondaryLink = document.getElementById('btn-calendar-secondary-link') as HTMLAnchorElement | null;

    if (!btnGoogle || !btnIcs) return;

    btnGoogle.href = googleUrl;
    btnIcs.href = icsUrl;

    if (isApple) {
      // Dispositivos Apple: abrir directamente la hoja de evento sin forzar descarga a archivo
      btnIcs.removeAttribute('download');
      btnIcs.setAttribute('rel', 'noopener');
      if (btnIcsIconApple) btnIcsIconApple.classList.remove('hidden');
      if (btnIcsIconCalendar) btnIcsIconCalendar.classList.add('hidden');
      if (btnIcsText) btnIcsText.textContent = isIOS ? 'Añadir a Apple Calendar' : 'Guardar en Apple Calendar';

      if (isIOS || isMobile) {
        // En iOS / móvil Apple: Apple Calendar como botón principal destacado
        btnIcs.className = 'w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-[0.97] text-white text-xs font-semibold shadow-xs transition-all duration-150 ease-out';
        btnGoogle.classList.add('hidden');
        btnIcs.classList.remove('hidden');

        if (secondaryWrap && secondaryIntro && secondaryLink) {
          secondaryWrap.classList.remove('hidden');
          secondaryIntro.textContent = '¿Prefieres Google Calendar? ';
          secondaryLink.textContent = 'Guardar en Google';
          secondaryLink.href = googleUrl;
          secondaryLink.target = '_blank';
          secondaryLink.rel = 'noopener noreferrer';
          secondaryLink.removeAttribute('download');
        }
      } else {
        // Mac desktop: mostrar ambos botones ordenados
        btnGoogle.classList.remove('hidden');
        btnIcs.classList.remove('hidden');
        if (btnGoogleText) btnGoogleText.textContent = 'Google Calendar';
        btnIcs.className = 'w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-slate-300 hover:bg-slate-50 active:scale-[0.97] text-slate-700 text-xs font-semibold shadow-2xs transition-all duration-150 ease-out';
        if (secondaryWrap) secondaryWrap.classList.add('hidden');
      }
    } else if (isAndroid) {
      // Dispositivos Android: Google Calendar como botón principal
      btnIcs.setAttribute('download', 'cita-vidasana.ics');
      if (btnGoogleText) btnGoogleText.textContent = 'Guardar en Google Calendar';
      btnGoogle.className = 'w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-[0.97] text-white text-xs font-semibold shadow-xs transition-all duration-150 ease-out';
      btnGoogle.classList.remove('hidden');
      btnIcs.classList.add('hidden');

      if (secondaryWrap && secondaryIntro && secondaryLink) {
        secondaryWrap.classList.remove('hidden');
        secondaryIntro.textContent = '¿Usas otro calendario? ';
        secondaryLink.textContent = 'Guardar en Outlook / otro';
        secondaryLink.href = icsUrl;
        secondaryLink.removeAttribute('target');
        secondaryLink.setAttribute('download', 'cita-vidasana.ics');
      }
    } else {
      // Escritorio / Windows / Otros
      btnIcs.setAttribute('download', 'cita-vidasana.ics');
      btnGoogle.classList.remove('hidden');
      btnIcs.classList.remove('hidden');
      if (btnGoogleText) btnGoogleText.textContent = 'Google Calendar';
      if (btnIcsText) btnIcsText.textContent = 'Apple Calendar / Outlook';
      if (btnIcsIconApple) btnIcsIconApple.classList.add('hidden');
      if (btnIcsIconCalendar) btnIcsIconCalendar.classList.remove('hidden');
      if (secondaryWrap) secondaryWrap.classList.add('hidden');
    }
  }

  async function showSuccessView(bookingId: string) {
    successPro.textContent = finalSummaryPro.textContent;
    successTime.textContent = finalSummaryTime.textContent;
    successPatient.textContent = finalSummaryPatient.textContent;

    const successIconWrap = document.getElementById('success-icon-wrap');
    if (successIconWrap) {
      successIconWrap.className = 'w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto mb-4 animate-success-bounce';
      stepViewSuccess.className = 'wizard-step bg-white rounded-2xl p-6 sm:p-10 shadow-lg border border-emerald-200 text-center animate-step';
    }

    try {
      const cal = await AgendamientoClient.getCalendarExport(bookingId);
      setupCalendarExportUI(cal.googleUrl, `/api/bookings/${bookingId}/calendar?format=ics`);
    } catch (err) {
      console.error('Error al obtener enlaces de calendario:', err);
    }

    goToStep(5);
  }

  btnRestartWizard.addEventListener('click', () => {
    window.location.reload();
  });

  // ==========================================================================
  // INICIALIZACIÓN DE SESIÓN
  // ==========================================================================
  async function initSession() {
    try {
      const session = await AgendamientoClient.getSession();
      currentSession = session;
      renderSessionState();
      if (session.authenticated) {
        await loadProfile();
      }
    } catch (err) {
      console.error('Error al consultar sesión:', err);
    }
  }

  function renderSessionState() {
    if (currentSession && currentSession.authenticated) {
      step3AuthOut.classList.add('hidden');
      step3AuthIn.classList.remove('hidden');
      step3Name.textContent = currentSession.user.name;
      step3Email.textContent = currentSession.user.email;
      step3Avatar.textContent = (currentSession.user.name[0] || 'U').toUpperCase();
    } else {
      step3AuthOut.classList.remove('hidden');
      step3AuthIn.classList.add('hidden');
    }
  }

  async function loadProfile() {
    try {
      const p = await AgendamientoClient.getPatientProfile();
      if (p.profile) {
        stepInputName.value = p.profile.name || '';
        stepInputDocType.value = p.profile.documentType || 'rut';
        stepInputRut.value = p.profile.rut
          ? (p.profile.documentType === 'rut' ? formatChileanRut(p.profile.rut) : p.profile.rut)
          : '';
        stepInputEmail.value = p.profile.email || '';
        stepInputPhone.value = p.profile.phone ? formatPhoneLive(p.profile.phone) : '';
        rememberedProfileVersion = p.version;
      } else if (currentSession && currentSession.user) {
        stepInputName.value = currentSession.user.name || '';
        stepInputEmail.value = currentSession.user.email || '';
      }
    } catch (err) {
      console.error('Error al precargar perfil:', err);
    }
  }

  if (btnStep3QuickLogin) {
    if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
      btnStep3QuickLogin.classList.remove('hidden');
      btnStep3QuickLogin.addEventListener('click', async () => {
        try {
          await AgendamientoClient.mockLogin('patient');
          await initSession();
        } catch (err) {
          console.error('Error en quick login:', err);
        }
      });
    }
  }

  // Inicialización de sesión y paso inicial
  initSession();

  const urlParams = new URLSearchParams(window.location.search);
  const paramPro = urlParams.get('pro');
  if (paramPro === 'felipe' || paramPro === 'eduardo') {
    selectProfessional(paramPro);
    goToStep(2, true);
    loadWeekAvailability(paramPro);
  } else {
    goToStep(1, true);
  }
</script>

<style>
  :root {
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Suave entrada unificada del wizard al cargar la página (sin parpadeos) */
  @keyframes wizardEntrance {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #wizard-container {
    animation: wizardEntrance 0.3s var(--ease-out-expo) both;
  }

  /* Transición fluida y física entre pasos */
  @keyframes stepFadeIn {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-step {
    animation: stepFadeIn 0.24s var(--ease-out-expo) forwards;
  }

  /* Pop elástico de checkmark completado en stepper */
  @keyframes checkmarkPop {
    0% {
      transform: scale(0.65);
      opacity: 0;
    }
    60% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-check-pop {
    animation: checkmarkPop 0.28s var(--ease-spring) forwards;
  }

  @keyframes numberPop {
    0% {
      transform: scale(0.85);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-number-pop {
    animation: numberPop 0.2s var(--ease-out-expo) forwards;
  }

  /* Cascada suave escalonada para slots de horario */
  @keyframes slotSlideUp {
    0% {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .animate-slot-enter {
    animation: slotSlideUp 0.26s var(--ease-out-expo) backwards;
  }

  /* Feedback táctil de selección instantánea (Micro-pop de confirmación) */
  @keyframes selectPop {
    0% {
      transform: scale(0.95);
    }
    50% {
      transform: scale(1.035);
    }
    100% {
      transform: scale(1.02);
    }
  }

  .animate-slot-pop {
    animation: selectPop 0.22s var(--ease-spring) forwards;
  }

  @keyframes pillPop {
    0% {
      transform: scale(0.94);
    }
    55% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-pill-pop {
    animation: pillPop 0.22s var(--ease-spring) forwards;
  }

  /* Celebración en pantalla de confirmación exitosa */
  @keyframes successBounce {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    50% {
      transform: scale(1.15);
    }
    75% {
      transform: scale(0.96);
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-success-bounce {
    animation: successBounce 0.48s var(--ease-spring) forwards;
  }

  /* Tarjetas seleccionadas con micro-latido inicial */
  @keyframes cardSelectPulse {
    0% {
      transform: scale(0.98);
    }
    50% {
      transform: scale(1.012);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-card-select {
    animation: cardSelectPulse 0.24s var(--ease-spring) forwards;
  }

  /* Accesibilidad: Respeta la preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .animate-step,
    .animate-check-pop,
    .animate-number-pop,
    .animate-slot-enter,
    .animate-slot-pop,
    .animate-pill-pop,
    .animate-success-bounce,
    .animate-card-select {
      animation: none !important;
      transform: none !important;
      transition: opacity 0.15s ease !important;
    }
  }
</style>

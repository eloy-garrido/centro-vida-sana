            />
            <label for="final-consent-check" class="text-xs text-slate-600 leading-normal select-none">
              Confirmo que los datos ingresados son correctos y acepto la política de atención clínica de Centro Vida Sana Austral.
            </label>
          </div>

          <!-- Mensaje de Error si ocurre -->
          <p id="final-booking-error" class="hidden text-xs text-center text-red-600 font-semibold mb-4" role="alert"></p>

          <!-- Barra de Navegación del Paso 4 -->
          <div class="flex items-center justify-between pt-4 border-t border-slate-100">
            <button
              type="button"
              id="btn-step-4-back"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-semibold transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>

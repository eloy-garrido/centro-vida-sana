  }

  .animate-card-select {
    animation: cardSelectPulse 0.24s var(--ease-spring) forwards;
  }

  /* Accesibilidad: Respeta la preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .animate-step,
    .animate-check-pop,
    .animate-number-pop,
    .animate-slot-enter,
    .animate-slot-pop,
    .animate-pill-pop,
    .animate-success-bounce,
    .animate-card-select {
      animation: none !important;

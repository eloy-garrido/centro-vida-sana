---
/**
 * Centro Vida Sana Austral — Pasarela de Reserva por Pasos (Wizard)
 * Conforme a S04, S09, D01, D02, D05 y S06.
 * Incluye noindex, validación de RUT en tiempo real, gestión de foco, accesibilidad AA y transiciones suaves.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { clinicInfo } from '../data/clinic';
import { professionals } from '../data/professionals';
---

<BaseLayout
  title={`Reservar Atención | ${clinicInfo.name}`}
  description="Reserva tu hora de atención de Quiropraxia, Kinesiología o Acupuntura en Centro Vida Sana Austral, Temuco."
  noindex={true}
>
  <div class="min-h-screen flex flex-col bg-[#F8F9F6]">
    <!-- Barra Superior Minimalista de Pasarela (Distraction-free) -->
    <header class="bg-white border-b border-slate-200/90 sticky top-0 z-30 shadow-xs shrink-0">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group transition-opacity hover:opacity-85" aria-label="Volver al inicio">
          <img
            src="/pix/logo-sin-texto-96.webp"
            alt="Centro Vida Sana Logo"
            class="w-8 h-8 rounded-full object-cover shadow-xs border border-slate-100"
          />
          <span class="font-serif font-bold text-base sm:text-lg text-slate-900 tracking-tight">
            Centro Vida Sana
          </span>
        </a>

        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors py-1.5 px-3 rounded-lg hover:bg-slate-100/70"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Volver al sitio web</span>
        </a>
      </div>
    </header>

    <div class="flex-1 py-8 sm:py-12 px-4 sm:px-6 lg:px-8 flex flex-col justify-between">
    <div id="wizard-wrapper" class="max-w-3xl w-full mx-auto">
      
      <!-- Encabezado Clínico -->
      <header class="text-center mb-8">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-emerald-50 text-emerald-800 border border-emerald-200 mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Agenda Oficial en Línea
        </span>
        <h1 class="text-3xl sm:text-4xl font-serif text-[#151C17] tracking-tight">
          Reserva tu Atención
        </h1>
        <p class="mt-2 text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
          Atención personalizada en Los Armiños 1620, Temuco.
        </p>
      </header>

      <!-- BARRA DE PROGRESO DEL WIZARD (1 -> 2 -> 3 -> 4) -->
      <nav aria-label="Progreso de la reserva" class="mb-8">
        <!-- Vista Desktop / Tablet -->
        <ol class="hidden sm:grid grid-cols-4 gap-2 bg-white p-2.5 rounded-2xl border border-slate-200 shadow-xs">
          <li id="step-nav-1" class="step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all select-none bg-slate-900 text-white">
            <span class="step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-white/20 text-white text-xs font-bold shrink-0">1</span>
            <span class="step-nav-label truncate">Especialista</span>
          </li>
          <li id="step-nav-2" class="step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 transition-all select-none">
            <span class="step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold shrink-0">2</span>
            <span class="step-nav-label truncate">Día y Hora</span>
          </li>
          <li id="step-nav-3" class="step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 transition-all select-none">
            <span class="step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold shrink-0">3</span>
            <span class="step-nav-label truncate">Tus Datos</span>
          </li>
          <li id="step-nav-4" class="step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 transition-all select-none">
            <span class="step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold shrink-0">4</span>
            <span class="step-nav-label truncate">Confirmación</span>
          </li>
        </ol>

        <!-- Vista Móvil Compacta -->
        <div class="sm:hidden bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
          <div>
            <span id="mobile-step-indicator" class="text-xs font-bold uppercase tracking-wider text-slate-500">Paso 1 de 4</span>
            <h2 id="mobile-step-title" class="text-base font-serif font-bold text-slate-900">Selecciona Especialista</h2>
          </div>
          <div class="flex gap-1.5" id="mobile-step-dots">
            <span class="w-2.5 h-2.5 rounded-full bg-slate-900"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-slate-200"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-slate-200"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-slate-200"></span>
          </div>
        </div>
      </nav>

      <!-- CONTENEDOR DE PASOS DEL WIZARD -->
      <div id="wizard-container" class="relative">

        <!-- ================================================================== -->
        <!-- PASO 1: SELECCIÓN DE ESPECIALISTA Y ÁREA                             -->
        <!-- ================================================================== -->
        <section id="step-view-1" class="wizard-step bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200">
          <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-xl font-serif text-slate-900 font-medium">1. Elige tu Profesional</h2>
            <p class="text-xs text-slate-500 mt-1">Selecciona al especialista de acuerdo al área de tratamiento o síntoma que requieres.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <!-- Tarjeta Felipe (Quiropraxia & Kinesiología) -->
            <label
              class="pro-card relative flex flex-col justify-between p-5 rounded-2xl border-2 border-slate-200 hover:border-slate-400 hover:shadow-sm cursor-pointer transition-all duration-150 ease-out select-none group bg-white shadow-xs active:scale-[0.985]"
              data-pro="felipe"
            >
              <input type="radio" name="selectedPro" value="felipe" class="sr-only" />
              <div>
                <div class="flex items-center gap-3.5 mb-3.5">
                  <img
                    src={professionals.felipe.photoUrl}
                    alt={professionals.felipe.name}
                    class="w-14 h-14 rounded-xl object-cover shrink-0 shadow-xs border border-slate-100 group-hover:scale-105 transition-transform duration-200 ease-out"
                    loading="eager"
                  />
                  <div class="min-w-0">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#EBF5F8] text-[#134E5E] border border-[#C2DFE8] mb-1">
                      Quiropraxia & Kinesiología
                    </span>
                    <h3 class="font-serif text-lg text-slate-900 font-bold leading-tight group-hover:text-slate-900 transition-colors">{professionals.felipe.name}</h3>
                    <p class="text-xs text-slate-600 font-medium">{professionals.felipe.title}</p>
                  </div>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed mb-3">
                  Especialista en ajustes vertebrales de alta precisión, descompresión articular, lumbago, ciática y rehabilitación de columna.
                </p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">Atención personalizada</span>
                <span class="select-indicator font-bold text-slate-600 opacity-75 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-150">Seleccionar →</span>
              </div>
            </label>

            <!-- Tarjeta Eduardo (Acupuntura & Medicina Tradicional China) -->
            <label
              class="pro-card relative flex flex-col justify-between p-5 rounded-2xl border-2 border-slate-200 hover:border-slate-400 hover:shadow-sm cursor-pointer transition-all duration-150 ease-out select-none group bg-white shadow-xs active:scale-[0.985]"
              data-pro="eduardo"
            >
              <input type="radio" name="selectedPro" value="eduardo" class="sr-only" />
              <div>
                <div class="flex items-center gap-3.5 mb-3.5">
                  <img
                    src={professionals.eduardo.photoUrl}
                    alt={professionals.eduardo.name}
                    class="w-14 h-14 rounded-xl object-cover shrink-0 shadow-xs border border-slate-100 group-hover:scale-105 transition-transform duration-200 ease-out"
                    loading="eager"
                  />
                  <div class="min-w-0">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#EEF5F0] text-[#2E4D38] border border-[#CCE2D2] mb-1">
                      Acupuntura & Medicina China
                    </span>
                    <h3 class="font-serif text-lg text-slate-900 font-bold leading-tight group-hover:text-slate-900 transition-colors">{professionals.eduardo.name}</h3>
                    <p class="text-xs text-slate-600 font-medium">{professionals.eduardo.title}</p>
                  </div>
                </div>
                <p class="text-xs text-slate-600 leading-relaxed mb-3">
                  Medicina Tradicional China y Acupuntura clínica para modulación del dolor crónico, estrés, insomnio, cefaleas y bienestar integral.
                </p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">Atención personalizada</span>
                <span class="select-indicator font-bold text-slate-600 opacity-75 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-150">Seleccionar →</span>
              </div>
            </label>
          </div>

          <!-- Barra de Navegación del Paso 1 -->
          <div class="flex justify-end pt-4 border-t border-slate-100">
            <button
              type="button"
              id="btn-step-1-next"
              disabled
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-[0.97] disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed disabled:active:scale-100 opacity-50 cursor-not-allowed text-white text-xs font-semibold transition-all duration-150 ease-out shadow-sm"
            >
              <span>Continuar a Fecha y Horario</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>
        </section>

        <!-- ================================================================== -->
        <!-- PASO 2: SELECCIÓN DE DÍA Y HORA                                    -->
        <!-- ================================================================== -->
        <!-- PASO 2: SELECCIÓN DE DÍA Y HORA                                      -->
        <!-- ================================================================== -->
        <section id="step-view-2" class="wizard-step hidden bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
            <div>
              <h2 class="text-xl font-serif text-slate-900 font-medium">2. Selecciona Día y Horario</h2>
              <p class="text-xs text-slate-500 mt-1">Ventana oficial de reserva: desde mañana hasta 7 días hacia adelante.</p>
            </div>
            <!-- Badge recordatorio del especialista elegido -->
            <div id="step-2-pro-chip" class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800">
              <span id="step-2-pro-dot" class="w-2 h-2 rounded-full bg-slate-600"></span>
              <span id="step-2-pro-name">Especialista</span>
            </div>
          </div>

          <!-- Loading Unificado del Paso 2 (Animación de Carga) -->
          <div id="step-2-loading" class="py-12 flex flex-col items-center justify-center text-center">
            <div class="relative w-11 h-11 mb-3.5">
              <div class="w-11 h-11 rounded-full border-2 border-slate-200"></div>
              <div class="w-11 h-11 rounded-full border-2 border-[#134E5E] border-t-transparent animate-spin absolute top-0 left-0"></div>
            </div>
            <p class="text-xs font-bold text-slate-800">Cargando disponibilidad oficial...</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Consultando turnos en tiempo real</p>

            <!-- Skeleton Placeholder coordinado -->
            <div class="w-full mt-6 space-y-4 max-w-lg mx-auto opacity-40 select-none pointer-events-none">
              <div class="flex gap-2 justify-center overflow-hidden">
                <div class="w-16 h-18 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="w-16 h-18 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="w-16 h-18 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="w-16 h-18 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="w-16 h-18 rounded-xl bg-slate-200 animate-pulse"></div>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2">
                <div class="h-14 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="h-14 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="h-14 rounded-xl bg-slate-200 animate-pulse"></div>
                <div class="h-14 rounded-xl bg-slate-200 animate-pulse"></div>
              </div>
            </div>
          </div>

          <!-- Contenido del Paso 2 (se muestra coordinado cuando todo está cargado) -->
          <div id="step-2-content" class="hidden">
            <!-- Selector de Días (Píldoras D+1 a D+7) -->
            <div class="mb-6">
              <p class="text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2.5">Elige un día:</p>
              <div id="date-pills-row" class="flex gap-2.5 overflow-x-auto pb-2 scrollbar-none">
                <!-- Se inyecta dinámicamente con JS -->
              </div>
            </div>

            <!-- Horarios Disponibles -->
            <div class="mb-8">
              <div class="flex items-center justify-between mb-3">
                <p class="text-xs font-semibold text-slate-700 uppercase tracking-wider">Horarios Disponibles:</p>
                <span id="step-2-date-label" class="text-xs text-slate-500 font-medium"></span>
              </div>

              <!-- Grilla de Slots -->
              <div id="slots-buttons-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <!-- Se inyecta dinámicamente -->
              </div>

              <!-- Mensaje Vacío -->
              <div id="slots-none-box" class="hidden py-8 text-center bg-slate-50 rounded-xl border border-dashed border-slate-200">
                <p class="text-xs text-slate-600 font-medium">No hay turnos disponibles para este día.</p>
                <p class="text-[11px] text-slate-400 mt-0.5">Por favor selecciona otra fecha en el calendario superior.</p>
              </div>
            </div>

            <!-- Barra de Navegación del Paso 2 -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
              <button
                type="button"
                id="btn-step-2-back"
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 active:scale-[0.96] text-xs font-semibold transition-all duration-150 ease-out"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                <span>Cambiar Especialista</span>
              </button>

              <button
                type="button"
                id="btn-step-2-next"
                disabled
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 text-white font-semibold text-xs shadow-xs hover:bg-slate-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-150 ease-out active:scale-[0.97]"
              >
                <span>Continuar a Mis Datos</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>
            </div>
          </div>
        </section>

        <!-- ================================================================== -->
        <!-- PASO 3: IDENTIFICACIÓN Y DATOS DEL PACIENTE                       -->
        <!-- ================================================================== -->
        <section id="step-view-3" class="wizard-step hidden bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 animate-step">
          <div class="border-b border-slate-100 pb-4 mb-6">
            <h2 class="text-xl font-serif text-slate-900 font-medium">3. Tus Datos y Contacto</h2>
            <p class="text-xs text-slate-500 mt-1">Ingresa la información de la persona que recibirá la atención clínica.</p>
          </div>

          <!-- Estado de Cuenta / Sesión -->
          <div class="mb-6 p-4 rounded-xl bg-slate-50 border border-slate-200">
            <!-- No autenticado -->
            <div id="step-3-auth-out" class="space-y-3">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center shrink-0 text-xs font-bold">
                  G
                </div>
                <div>
                  <h3 class="text-xs font-bold text-slate-900">Identificación con Google requerida</h3>
                  <p class="text-[11px] text-slate-500 leading-relaxed mt-0.5">
                    Permite proteger tu cita contra dobles reservas y recordar tus datos. No enviamos correos ni solicitamos acceso a tu calendario.
                  </p>
                </div>
              </div>
              <div class="flex flex-wrap gap-2 pt-1">
                <a
                  href="/auth/google/start?returnTo=/reservar"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-xs"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                    <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                    <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9z"/>
                    <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z"/>
                  </svg>
                  <span>Identificarme con Google</span>
                </a>
                <button
                  type="button"
                  id="btn-step-3-quick-login"
                  class="hidden px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-300"
                >
                  ⚡ Acceso Rápido de Prueba (Dev)
                </button>
              </div>
            </div>

            <!-- Sí autenticado -->
            <div id="step-3-auth-in" class="hidden flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div id="step-3-avatar" class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">U</div>
                <div>
                  <p id="step-3-name" class="text-xs font-bold text-slate-900">Usuario Identificado</p>
                  <p id="step-3-email" class="text-[11px] text-slate-500">usuario@correo.com</p>
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 text-emerald-800">
                ✓ Sesión Activa
              </span>
            </div>
          </div>

          <!-- Formulario de Datos del Paciente -->
          <form id="step-3-form" class="space-y-4 mb-8" novalidate>
            <!-- Nombre Completo -->
            <div>
              <label for="step-input-name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                Nombre y Apellido del Paciente *
              </label>
              <input
                type="text"
                id="step-input-name"
                required
                placeholder="Ej: Camila González Soto"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-colors"
              />
              <p class="text-[11px] text-slate-500 mt-1">Ingresa al menos un nombre y un apellido para tu ficha clínica.</p>
              <p id="err-step-name" class="hidden text-xs text-red-600 mt-1 font-medium"></p>
            </div>

            <!-- Documento (RUT / Pasaporte) -->
            <div>
              <label for="step-input-rut" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                Documento de Identidad *
              </label>
              <div class="grid grid-cols-3 gap-2">
                <select
                  id="step-input-doc-type"
                  class="col-span-1 px-3 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs font-medium bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900"
                >
                  <option value="rut">RUT</option>
                  <option value="passport">Pasaporte</option>
                </select>
                <input
                  type="text"
                  id="step-input-rut"
                  required
                  placeholder="12.345.678-5"
                  class="col-span-2 px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-colors"
                />
              </div>
              <p id="err-step-rut" class="hidden text-xs text-red-600 mt-1 font-medium"></p>
            </div>

            <!-- Correo y Teléfono -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="step-input-email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                  Correo de Contacto *
                </label>
                <input
                  type="email"
                  id="step-input-email"
                  required
                  placeholder="ejemplo@correo.cl"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-colors"
                />

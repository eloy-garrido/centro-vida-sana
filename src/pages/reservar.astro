  function updateStep2NextButton() {
    const canProceed = Boolean(selectedDateString && selectedSlotUtc);
    btnStep2Next.disabled = !canProceed;
    if (canProceed) {
      btnStep2Next.removeAttribute('disabled');
      btnStep2Next.setAttribute('aria-disabled', 'false');
      btnStep2Next.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      btnStep2Next.setAttribute('disabled', 'true');
      btnStep2Next.setAttribute('aria-disabled', 'true');
      btnStep2Next.classList.add('opacity-50', 'cursor-not-allowed');
    }
  }

  function renderSlotsForSelectedDate() {
    if (!selectedDateString) return;

    const [y, m, d] = selectedDateString.split('-').map(Number);
    const dateObj = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
    const friendlyDate = dateObj.toLocaleDateString('es-CL', {
      weekday: 'long',
      day: 'numeric',
      month: 'long'
    });
    step2DateLabel.textContent = friendlyDate.charAt(0).toUpperCase() + friendlyDate.slice(1);

    slotsButtonsGrid.innerHTML = '';
    const displaySlots = slotsByDate.get(selectedDateString) || [];

    if (displaySlots.length === 0) {
      slotsNoneBox.classList.remove('hidden');
      selectedSlotUtc = null;
      updateStep2NextButton();
      return;
    }

    slotsNoneBox.classList.add('hidden');

    const hasAnyAvailable = displaySlots.some((s) => s.available !== false);
    if (!hasAnyAvailable) {
      const fullNotice = document.createElement('div');
      fullNotice.className = 'col-span-full py-3 px-4 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-800 text-xs flex items-center gap-2.5 mb-1';
      fullNotice.innerHTML = `
        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span class="font-medium">Todos los horarios de este día ya han sido reservados. Por favor selecciona otra fecha arriba.</span>
      `;
      slotsButtonsGrid.appendChild(fullNotice);
    }

    displaySlots.forEach((slot, index) => {
      const slotDate = new Date(slot.startAt);
      const timeStr = slotDate.toLocaleTimeString('es-CL', {
        timeZone: 'America/Santiago',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      });
      const isOccupied = slot.available === false;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-slot-utc', slot.startAt);

      btn.classList.add('animate-slot-enter');
      btn.style.animationDelay = `${index * 22}ms`;

      if (isOccupied) {
        if (selectedSlotUtc === slot.startAt) {
          selectedSlotUtc = null;
        }
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.setAttribute('aria-label', `${timeStr} hrs, hora ya reservada por otro paciente`);
        btn.title = 'Esta hora ya fue reservada por otro paciente';
        btn.className = 'slot-btn-occupied min-h-[64px] py-2.5 px-3 rounded-xl border border-dashed border-slate-300/80 bg-slate-100/70 text-slate-400 select-none text-center flex flex-col items-center justify-center cursor-not-allowed opacity-80';
        btn.innerHTML = `
          <span class="text-sm font-semibold text-slate-400 line-through leading-tight">${timeStr} hrs</span>
          <span class="inline-flex items-center gap-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1 px-1.5 py-0.5 rounded bg-slate-200/60">
            <svg class="w-2.5 h-2.5 text-slate-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
            </svg>
            <span>Reservada</span>
          </span>
        `;
      } else {
        const isSelected = selectedSlotUtc === slot.startAt;
        applySlotButtonClasses(btn, isSelected);

        btn.innerHTML = `
          <span class="text-sm font-bold leading-tight">${timeStr} hrs</span>
        `;

        btn.addEventListener('click', () => {
          selectedSlotUtc = slot.startAt;
          regenerateIdempotencyKey();
          updateSlotButtons(slot.startAt);
          updateStep2NextButton();
        });
      }

      slotsButtonsGrid.appendChild(btn);
    });

    updateStep2NextButton();
  }

  async function loadWeekAvailability(proId: 'felipe' | 'eduardo') {
    // Si ya tenemos la disponibilidad cargada para este profesional, reusar inmediatamente sin red
    if (loadedAvailabilityForPro === proId && slotsByDate.size > 0) {
      step2Loading.classList.add('hidden');
      step2Content.classList.remove('hidden');
      renderDatePills();
      renderSlotsForSelectedDate();
      return;
    }

    // Mostrar estado de carga coordinado y ocultar contenido hasta que todo esté listo
    step2Loading.classList.remove('hidden');
    step2Content.classList.add('hidden');
    slotsButtonsGrid.innerHTML = '';
    updateStep2NextButton();

    const availableDates = getAvailableDates();
    if (availableDates.length === 0) {
      step2Loading.classList.add('hidden');
      step2Content.classList.remove('hidden');
      return;
    }

    const fromDate = availableDates[0].dateStr;
    const lastDate = availableDates[availableDates.length - 1].dateStr;
    const lastDateObj = new Date(`${lastDate}T12:00:00Z`);
    const nextToDate = new Date(lastDateObj.getTime() + 24 * 3600 * 1000);
    const toDate = `${nextToDate.getUTCFullYear()}-${String(nextToDate.getUTCMonth() + 1).padStart(2, '0')}-${String(nextToDate.getUTCDate()).padStart(2, '0')}`;

    try {
      const res = await AgendamientoClient.getAvailability(proId, fromDate, toDate);
      slotsByDate.clear();
      loadedAvailabilityForPro = proId;

      const all = res.allSlots || [];
      for (const slot of all) {
        const d = new Date(slot.startAt);
        const slotDateStr = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Santiago',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).format(d);

        if (!slotsByDate.has(slotDateStr)) {
          slotsByDate.set(slotDateStr, []);
        }
        slotsByDate.get(slotDateStr)!.push(slot);
      }

      // Si la fecha elegida no existe en este rango, auto-seleccionar la primera con cupos libres
      if (!selectedDateString || !availableDates.some((d) => d.dateStr === selectedDateString)) {
        const firstAvailable = availableDates.find((d) => {
          const slots = slotsByDate.get(d.dateStr) || [];
          return slots.some((s) => s.available !== false);
        });
        selectedDateString = firstAvailable ? firstAvailable.dateStr : availableDates[0].dateStr;
      }

      renderDatePills();
      renderSlotsForSelectedDate();
    } catch (err) {
      console.error('Error al cargar disponibilidad de la semana:', err);
      slotsButtonsGrid.innerHTML = `
        <p class="col-span-full text-xs text-red-600 py-4 text-center font-medium">
          Error al consultar horarios disponibles. Intenta nuevamente.
        </p>
      `;
      selectedSlotUtc = null;
      updateStep2NextButton();
    } finally {
      // Revelación suave coordinada del contenido ya renderizado
      step2Loading.classList.add('hidden');
      step2Content.classList.remove('hidden');
      step2Content.classList.remove('animate-step');
      void step2Content.offsetWidth;
      step2Content.classList.add('animate-step');
    }
  }

  btnStep2Next.addEventListener('click', () => {
    if (!selectedDateString || !selectedSlotUtc) return;
    goToStep(3);
  });


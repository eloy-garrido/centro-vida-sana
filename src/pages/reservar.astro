      transform: scale(1);
    }
  }

  .animate-pill-pop {
    animation: pillPop 0.22s var(--ease-spring) forwards;
  }

  /* Celebración en pantalla de confirmación exitosa */
  @keyframes successBounce {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    50% {
      transform: scale(1.15);
    }
    75% {
      transform: scale(0.96);

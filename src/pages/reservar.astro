  function selectProfessional(pro: 'felipe' | 'eduardo') {
    if (selectedProfessionalId !== pro) {
      regenerateIdempotencyKey();
    }
    selectedProfessionalId = pro;

    proCards.forEach((c) => {
      c.classList.remove('border-slate-900', 'bg-slate-50', 'ring-2', 'ring-slate-900', 'shadow-sm', 'animate-card-select');
      c.classList.add('border-slate-200', 'bg-white');
      const radio = c.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = false;
      const ind = c.querySelector('.select-indicator') as HTMLElement;
      if (ind) {
        ind.textContent = 'Seleccionar →';
        ind.className = 'select-indicator font-bold text-slate-600 opacity-75 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-150';
      }
    });

    const activeCard = Array.from(proCards).find((c) => c.getAttribute('data-pro') === pro) as HTMLElement | undefined;
    if (activeCard) {
      activeCard.classList.remove('border-slate-200', 'bg-white');
      void activeCard.offsetWidth;
      activeCard.classList.add('border-slate-900', 'bg-slate-50', 'ring-2', 'ring-slate-900', 'shadow-sm', 'animate-card-select');

      const radio = activeCard.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;
      const activeInd = activeCard.querySelector('.select-indicator') as HTMLElement;
      if (activeInd) {
        activeInd.textContent = '✓ Seleccionado';
        activeInd.className = 'select-indicator font-bold text-slate-900';

        <!-- ================================================================== -->
        <!-- PASO 5: PANTALLA DE ÉXITO Y COPIA A CALENDARIO (S06)               -->
        <!-- ================================================================== -->
        <section id="step-view-success" class="wizard-step hidden bg-white rounded-2xl p-6 sm:p-10 shadow-lg border border-emerald-200 text-center animate-step">
          <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>

        </section>

      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<script>
  import { AgendamientoClient, ApiError } from '../lib/agendamiento/client.ts';
  import { formatChileanRut, validateChileanRut } from '../lib/agendamiento/validation.ts';

  // ESTADO DEL WIZARD
  let currentStep = 1;
  let currentSession: any = null;
  let rememberedProfileVersion: string | null = null;
  let selectedProfessionalId: 'felipe' | 'eduardo' | null = null;
  let selectedDateString: string | null = null;
  let selectedSlotUtc: string | null = null;
  let currentIdempotencyKey = 'idemp_' + Math.random().toString(36).substring(2, 12) + Date.now().toString(36);

  // VISTAS DEL WIZARD
  const stepView1 = document.getElementById('step-view-1')!;
  const stepView2 = document.getElementById('step-view-2')!;
  const stepView3 = document.getElementById('step-view-3')!;
  const stepView4 = document.getElementById('step-view-4')!;
  const stepViewSuccess = document.getElementById('step-view-success')!;

  // NAV INDICATORS
  const stepNavItems = [
    document.getElementById('step-nav-1')!,
    document.getElementById('step-nav-2')!,
    document.getElementById('step-nav-3')!,
    document.getElementById('step-nav-4')!
  ];
  const mobileStepIndicator = document.getElementById('mobile-step-indicator')!;
  const mobileStepTitle = document.getElementById('mobile-step-title')!;
  const mobileDots = document.getElementById('mobile-step-dots')!.children;

  const stepTitles = [
    'Selecciona Especialista',
    'Día y Horario',
    'Tus Datos y Contacto',
    'Revisar y Confirmar'
  ];

  // PASO 1 DOM
  const btnStep1Next = document.getElementById('btn-step-1-next') as HTMLButtonElement;
  const proCards = document.querySelectorAll('.pro-card');

  // PASO 2 DOM
  const btnStep2Back = document.getElementById('btn-step-2-back')!;
  const btnStep2Next = document.getElementById('btn-step-2-next') as HTMLButtonElement;
  const step2ProChip = document.getElementById('step-2-pro-chip')!;
  const step2ProName = document.getElementById('step-2-pro-name')!;
  const datePillsRow = document.getElementById('date-pills-row')!;
  const step2DateLabel = document.getElementById('step-2-date-label')!;
  const slotsSkeleton = document.getElementById('slots-skeleton')!;
  const slotsButtonsGrid = document.getElementById('slots-buttons-grid')!;
  const slotsNoneBox = document.getElementById('slots-none-box')!;

  // PASO 3 DOM
  const btnStep3Back = document.getElementById('btn-step-3-back')!;
  const btnStep3Next = document.getElementById('btn-step-3-next') as HTMLButtonElement;
  const step3AuthOut = document.getElementById('step-3-auth-out')!;
  const step3AuthIn = document.getElementById('step-3-auth-in')!;
  const step3Avatar = document.getElementById('step-3-avatar')!;
  const step3Name = document.getElementById('step-3-name')!;
  const step3Email = document.getElementById('step-3-email')!;
  const btnStep3QuickLogin = document.getElementById('btn-step-3-quick-login');

  const stepInputName = document.getElementById('step-input-name') as HTMLInputElement;
  const stepInputDocType = document.getElementById('step-input-doc-type') as HTMLSelectElement;
  const stepInputRut = document.getElementById('step-input-rut') as HTMLInputElement;
  const stepInputEmail = document.getElementById('step-input-email') as HTMLInputElement;
  const stepInputPhone = document.getElementById('step-input-phone') as HTMLInputElement;
  const stepCheckRemember = document.getElementById('step-check-remember') as HTMLInputElement;

  const errStepName = document.getElementById('err-step-name')!;
  const errStepRut = document.getElementById('err-step-rut')!;
  const errStepEmail = document.getElementById('err-step-email')!;
  const errStepPhone = document.getElementById('err-step-phone')!;

  // PASO 4 DOM
  const btnStep4Back = document.getElementById('btn-step-4-back')!;
  const finalSummaryPro = document.getElementById('final-summary-pro')!;
  const finalSummaryTime = document.getElementById('final-summary-time')!;
  const finalSummaryPatient = document.getElementById('final-summary-patient')!;
  const finalSummaryContact = document.getElementById('final-summary-contact')!;
  const finalConsentCheck = document.getElementById('final-consent-check') as HTMLInputElement;
  const btnFinalConfirm = document.getElementById('btn-final-confirm') as HTMLButtonElement;
  const btnFinalText = document.getElementById('btn-final-text')!;
  const btnFinalSpinner = document.getElementById('btn-final-spinner')!;
  const finalBookingError = document.getElementById('final-booking-error')!;

  // PASO 5 (ÉXITO) DOM
  const successCode = document.getElementById('success-code')!;
  const successPro = document.getElementById('success-pro')!;
  const successTime = document.getElementById('success-time')!;
  const successPatient = document.getElementById('success-patient')!;
  const btnGoogleCalendar = document.getElementById('btn-google-calendar') as HTMLAnchorElement;
  const btnIcsCalendar = document.getElementById('btn-ics-calendar') as HTMLAnchorElement;
  const btnRestartWizard = document.getElementById('btn-restart-wizard')!;

  // ==========================================================================
  // FUNCIÓN CENTRAL: NAVEGACIÓN ENTRE PASOS
  // ==========================================================================
  function goToStep(step: number) {
    currentStep = step;

    // Ocultar todas las vistas
    stepView1.classList.add('hidden');
    stepView2.classList.add('hidden');
    stepView3.classList.add('hidden');
    stepView4.classList.add('hidden');
    stepViewSuccess.classList.add('hidden');

    // Mostrar vista activa
    if (step === 1) stepView1.classList.remove('hidden');
    if (step === 2) stepView2.classList.remove('hidden');
    if (step === 3) stepView3.classList.remove('hidden');
    if (step === 4) stepView4.classList.remove('hidden');
    if (step === 5) stepViewSuccess.classList.remove('hidden');

    // Actualizar barra de progreso (Desktop)
    stepNavItems.forEach((item, index) => {
      const stepNum = index + 1;
      const numSpan = item.querySelector('.step-nav-number') as HTMLElement;

      if (stepNum < step) {
        // Completado
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 transition-all select-none';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-emerald-600 text-white text-xs font-bold shrink-0';
        numSpan.innerHTML = '✓';
      } else if (stepNum === step) {
        // Activo
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-white shadow-xs transition-all select-none';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-white/20 text-white text-xs font-bold shrink-0';
        numSpan.textContent = String(stepNum);
      } else {
        // Pendiente
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 transition-all select-none';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold shrink-0';
        numSpan.textContent = String(stepNum);
      }
    });

    // Actualizar barra móvil
    if (step <= 4) {
      mobileStepIndicator.textContent = `Paso ${step} de 4`;
      mobileStepTitle.textContent = stepTitles[step - 1];
      for (let i = 0; i < 4; i++) {
        mobileDots[i].className = i + 1 === step ? 'w-2.5 h-2.5 rounded-full bg-slate-900' : (i + 1 < step ? 'w-2.5 h-2.5 rounded-full bg-emerald-500' : 'w-2.5 h-2.5 rounded-full bg-slate-200');
      }
    }

    // Scroll suave hacia arriba
    window.scrollTo({ top: 120, behavior: 'smooth' });
  }

  // ==========================================================================
  // PASO 1: SELECCIÓN DE ESPECIALISTA
  // ==========================================================================
  proCards.forEach((card) => {
    card.addEventListener('click', () => {
      const pro = card.getAttribute('data-pro') as 'felipe' | 'eduardo';
      selectedProfessionalId = pro;

      proCards.forEach((c) => {
        c.classList.remove('border-slate-900', 'bg-slate-50', 'ring-2', 'ring-slate-900');
        const radio = c.querySelector('input[type="radio"]') as HTMLInputElement;
        if (radio) radio.checked = false;
        const ind = c.querySelector('.select-indicator') as HTMLElement;
        if (ind) ind.textContent = 'Seleccionar →';
      });

      card.classList.add('border-slate-900', 'bg-slate-50', 'ring-2', 'ring-slate-900');
      const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;
      const activeInd = card.querySelector('.select-indicator') as HTMLElement;
      if (activeInd) activeInd.textContent = '✓ Seleccionado';

      btnStep1Next.disabled = false;
      btnStep1Next.removeAttribute('disabled');
      btnStep1Next.classList.remove('opacity-50', 'cursor-not-allowed');
    });
  });

  btnStep1Next.addEventListener('click', () => {
    if (!selectedProfessionalId) return;

    // Actualizar chip en Paso 2
    step2ProName.textContent = selectedProfessionalId === 'felipe'
      ? 'Felipe Méndez (Box 1)'
      : 'Eduardo Lagos (Box 2)';
    step2ProChip.classList.remove('hidden');

    // Resetear hora al entrar al paso 2 y bloquear botón continuar
    selectedSlotUtc = null;
    updateStep2NextButton();
    loadSlots();
    goToStep(2);
  });

  // ==========================================================================
  // PASO 2: DÍA Y HORA
  // ==========================================================================
  btnStep2Back.addEventListener('click', () => goToStep(1));

  function getAvailableDates(): Array<{ dateStr: string; weekday: number; dayNum: number; monthName: string }> {
    const list: Array<{ dateStr: string; weekday: number; dayNum: number; monthName: string }> = [];
    const now = new Date();
    const monthsEs = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    for (let i = 1; i <= 7; i++) {
      const date = new Date(now.getTime() + i * 24 * 60 * 60 * 1000);
      const yyyy = date.getFullYear();
      const mm = String(date.getMonth() + 1).padStart(2, '0');
      const dd = String(date.getDate()).padStart(2, '0');
      const dateStr = `${yyyy}-${mm}-${dd}`;
      const weekday = date.getDay();

      if (weekday === 0) continue; // Cerrado domingos

      list.push({
        dateStr,
        weekday,
        dayNum: date.getDate(),
        monthName: monthsEs[date.getMonth()]
      });
    }
    return list;
  }

  function applyDatePillClasses(btn: HTMLButtonElement, isSelected: boolean) {
    btn.className = isSelected
      ? 'date-pill shrink-0 flex flex-col items-center justify-center w-16 h-18 py-2.5 px-2 rounded-xl border-2 border-slate-900 bg-slate-900 text-white shadow-xs select-none text-center cursor-pointer font-medium'
      : 'date-pill shrink-0 flex flex-col items-center justify-center w-16 h-18 py-2.5 px-2 rounded-xl border-2 border-slate-200 bg-white hover:border-slate-400 text-slate-700 select-none text-center cursor-pointer transition-colors';
  }

  function renderDatePills() {
    datePillsRow.innerHTML = '';
    const daysEs = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
    const availableDates = getAvailableDates();

    if (!selectedDateString || !availableDates.some(d => d.dateStr === selectedDateString)) {
      if (availableDates.length > 0) {
        selectedDateString = availableDates[0].dateStr;
      }
    }

    availableDates.forEach((d) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-date-str', d.dateStr);
      const isSelected = selectedDateString === d.dateStr;
      applyDatePillClasses(btn, isSelected);
      btn.innerHTML = `
        <span class="text-[10px] font-semibold tracking-wider uppercase opacity-80">${daysEs[d.weekday]}</span>
        <span class="text-lg font-bold leading-none my-1">${d.dayNum}</span>
        <span class="text-[10px] font-medium opacity-80">${d.monthName}</span>
      `;

      btn.addEventListener('click', () => {
        if (selectedDateString === d.dateStr) return;
        selectedDateString = d.dateStr;
        selectedSlotUtc = null; // Reiniciar selección de hora al cambiar día
        updateStep2NextButton();
        renderDatePills();
        loadSlots();
      });

      datePillsRow.appendChild(btn);
    });
  }

  function applySlotButtonClasses(btn: HTMLButtonElement, isSelected: boolean) {
    btn.className = isSelected
      ? 'slot-btn py-3 px-3 rounded-xl border-2 font-semibold text-xs transition-all text-center flex flex-col items-center justify-center border-slate-900 bg-slate-900 text-white shadow-md ring-2 ring-slate-900 ring-offset-2 cursor-pointer transform scale-[1.02]'
      : 'slot-btn py-3 px-3 rounded-xl border-2 font-semibold text-xs transition-all text-center flex flex-col items-center justify-center border-slate-200 hover:border-slate-800 hover:bg-slate-50 bg-white text-slate-800 cursor-pointer';
  }

  function updateSlotButtons() {
    const allSlots = slotsButtonsGrid.querySelectorAll<HTMLButtonElement>('.slot-btn');
    allSlots.forEach((btn) => {
      const slotUtc = btn.getAttribute('data-slot-utc');
      const isSelected = Boolean(selectedSlotUtc && slotUtc === selectedSlotUtc);
      applySlotButtonClasses(btn, isSelected);
    });
  }

  function updateStep2NextButton() {
    const canProceed = Boolean(selectedDateString && selectedSlotUtc);
    btnStep2Next.disabled = !canProceed;
    if (canProceed) {
      btnStep2Next.removeAttribute('disabled');
      btnStep2Next.setAttribute('aria-disabled', 'false');
      btnStep2Next.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      btnStep2Next.setAttribute('disabled', 'true');
      btnStep2Next.setAttribute('aria-disabled', 'true');
      btnStep2Next.classList.add('opacity-50', 'cursor-not-allowed');
    }
  }

  async function loadSlots() {
    if (!selectedProfessionalId || !selectedDateString) return;

    step2DateLabel.textContent = `Fecha: ${selectedDateString}`;
    slotsButtonsGrid.innerHTML = '';
    slotsSkeleton.classList.remove('hidden');
    slotsNoneBox.classList.add('hidden');
    updateStep2NextButton(); // Garantizar que continúe bloqueado mientras carga

    try {
      const nextDate = new Date(new Date(selectedDateString + 'T12:00:00Z').getTime() + 24 * 3600 * 1000);
      const toDateStr = `${nextDate.getUTCFullYear()}-${String(nextDate.getUTCMonth() + 1).padStart(2, '0')}-${String(nextDate.getUTCDate()).padStart(2, '0')}`;

      const res = await AgendamientoClient.getAvailability(selectedProfessionalId, selectedDateString, toDateStr);
      slotsSkeleton.classList.add('hidden');

      if (!res.slots || res.slots.length === 0) {
        slotsNoneBox.classList.remove('hidden');
        selectedSlotUtc = null;
        updateStep2NextButton();
        return;
      }

      slotsNoneBox.classList.add('hidden');

      res.slots.forEach((slot) => {
        const d = new Date(slot.startAt);
        const timeStr = d.toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hour12: false });
        const endD = new Date(new Date(slot.startAt).getTime() + 3600 * 1000);
        const endTimeStr = endD.toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hour12: false });

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-slot-utc', slot.startAt);
        const isSelected = selectedSlotUtc === slot.startAt;
        applySlotButtonClasses(btn, isSelected);

        btn.innerHTML = `
          <span class="text-sm font-bold">${timeStr}</span>
          <span class="text-[10px] opacity-75 font-normal">hasta ${endTimeStr}</span>
        `;

        btn.addEventListener('click', () => {
          selectedSlotUtc = slot.startAt;
          updateSlotButtons();
          updateStep2NextButton();
        });

        slotsButtonsGrid.appendChild(btn);
      });

      // Asegurar que el botón siguiente refleje el estado
      updateStep2NextButton();
    } catch {
      slotsSkeleton.classList.add('hidden');
      slotsButtonsGrid.innerHTML = `
        <p class="col-span-full text-xs text-red-600 py-4 text-center font-medium">
          Error al consultar horarios disponibles. Intenta nuevamente.
        </p>
      `;
      selectedSlotUtc = null;
      updateStep2NextButton();
    }
  }

  btnStep2Next.addEventListener('click', () => {
    if (!selectedDateString || !selectedSlotUtc) return;
    goToStep(3);
  });

  // ==========================================================================
  // PASO 3: TUS DATOS Y CONTACTO
  // ==========================================================================
  btnStep3Back.addEventListener('click', () => {
    updateStep2NextButton();
    goToStep(2);
  });

  // Validación y formato de RUT en tiempo real
  stepInputRut.addEventListener('blur', () => {
    if (stepInputDocType.value === 'rut' && stepInputRut.value.trim()) {
      const val = validateChileanRut(stepInputRut.value);
      if (!val.valid) {
        errStepRut.textContent = val.error || 'RUT inválido';
        errStepRut.classList.remove('hidden');
        stepInputRut.classList.add('border-red-400');
      } else {
        errStepRut.classList.add('hidden');
        stepInputRut.classList.remove('border-red-400');
        stepInputRut.value = formatChileanRut(stepInputRut.value);
      }
    }
  });

  btnStep3Next.addEventListener('click', () => {
    // Validar campos
    let valid = true;

    if (!stepInputName.value.trim()) {
      errStepName.textContent = 'Ingresa el nombre completo.';
      errStepName.classList.remove('hidden');
      valid = false;
    } else {
      errStepName.classList.add('hidden');
    }

    if (!stepInputRut.value.trim()) {
      errStepRut.textContent = 'Ingresa el documento de identidad.';
      errStepRut.classList.remove('hidden');
      valid = false;
    } else if (stepInputDocType.value === 'rut') {
      const rutVal = validateChileanRut(stepInputRut.value);
      if (!rutVal.valid) {
        errStepRut.textContent = rutVal.error || 'RUT inválido.';
        errStepRut.classList.remove('hidden');
        valid = false;
      } else {
        errStepRut.classList.add('hidden');
      }
    } else {
      errStepRut.classList.add('hidden');
    }

    if (!stepInputEmail.value.trim() || !stepInputEmail.value.includes('@')) {
      errStepEmail.textContent = 'Ingresa un correo electrónico válido.';
      errStepEmail.classList.remove('hidden');
      valid = false;
    } else {
      errStepEmail.classList.add('hidden');
    }

    if (!stepInputPhone.value.trim()) {
      errStepPhone.textContent = 'Ingresa un teléfono de contacto.';
      errStepPhone.classList.remove('hidden');
      valid = false;
    } else {
      errStepPhone.classList.add('hidden');
    }

    if (!currentSession || !currentSession.authenticated) {
      alert('Debes identificarte con tu cuenta Google para continuar.');
      return;
    }

    if (!valid) return;

    // Actualizar Resumen en Paso 4
    finalSummaryPro.textContent = selectedProfessionalId === 'felipe'
      ? 'Felipe Méndez (Box 1 · Quiropraxia)'
      : 'Eduardo Lagos (Box 2 · Acupuntura)';

    const d = new Date(selectedSlotUtc!);
    const dateFormatted = d.toLocaleDateString('es-CL', { timeZone: 'America/Santiago', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const timeFormatted = d.toLocaleTimeString('es-CL', { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hour12: false });
    finalSummaryTime.textContent = `${dateFormatted}, ${timeFormatted} hrs`;

    finalSummaryPatient.textContent = `${stepInputName.value.trim()} (${stepInputRut.value.trim()})`;
    finalSummaryContact.textContent = `${stepInputPhone.value.trim()} · ${stepInputEmail.value.trim()}`;

    goToStep(4);
  });

  // ==========================================================================
  // PASO 4: CONFIRMACIÓN Y COMMIT ATÓMICO
  // ==========================================================================
  btnStep4Back.addEventListener('click', () => goToStep(3));

  finalConsentCheck.addEventListener('change', () => {
    const isChecked = finalConsentCheck.checked;
    btnFinalConfirm.disabled = !isChecked;
    if (isChecked) {
      btnFinalConfirm.removeAttribute('disabled');
      btnFinalConfirm.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      btnFinalConfirm.setAttribute('disabled', 'true');
      btnFinalConfirm.classList.add('opacity-50', 'cursor-not-allowed');
    }
  });

  btnFinalConfirm.addEventListener('click', async () => {
    if (!currentSession || !currentSession.csrfToken) return;

    btnFinalConfirm.disabled = true;
    btnFinalText.textContent = 'Confirmando tu reserva...';
    btnFinalSpinner.classList.remove('hidden');
    finalBookingError.classList.add('hidden');

    try {
      // Guardar perfil si se seleccionó recordar
      if (stepCheckRemember.checked) {
        try {
          await AgendamientoClient.savePatientProfile(
            {
              name: stepInputName.value.trim(),
              email: stepInputEmail.value.trim(),
              rut: stepInputRut.value.trim(),
              documentType: stepInputDocType.value as any,
              phone: stepInputPhone.value.trim()
            },
            rememberedProfileVersion,
            currentSession.csrfToken
          );
        } catch {
          // Fallo de guardado de perfil no impide la reserva
        }
      }

      // Enviar comando atómico con idempotencia
      const res = await AgendamientoClient.createBooking(
        {
          professionalId: selectedProfessionalId!,
          startAt: selectedSlotUtc!,
          patient: {
            name: stepInputName.value.trim(),
            email: stepInputEmail.value.trim(),
            rut: stepInputRut.value.trim(),
            documentType: stepInputDocType.value as any,
            phone: stepInputPhone.value.trim()
          },
          consentVersion: 'v1.0'
        },
        currentIdempotencyKey,
        currentSession.csrfToken
      );

      // Mostrar pantalla de éxito (Paso 5)
      showSuccessView(res.result.resourceId);
    } catch (err: any) {
      btnFinalConfirm.disabled = false;
      btnFinalText.textContent = 'Confirmar y Agendar Cita';
      btnFinalSpinner.classList.add('hidden');

      if (err instanceof ApiError && err.code === 'SLOT_CONFLICT') {
        finalBookingError.textContent = 'El horario seleccionado ya no está disponible. Por favor regresa al paso 2 y elige otro cupo.';
      } else {
        finalBookingError.textContent = err.message || 'Error al confirmar la reserva. Intenta nuevamente.';
      }
      finalBookingError.classList.remove('hidden');
    }
  });

  // ==========================================================================
  // PASO 5: ÉXITO Y COPIA A CALENDARIO
  // ==========================================================================
  async function showSuccessView(bookingId: string) {
    successCode.textContent = bookingId;
    successPro.textContent = finalSummaryPro.textContent;
    successTime.textContent = finalSummaryTime.textContent;
    successPatient.textContent = finalSummaryPatient.textContent;

    try {
      const cal = await AgendamientoClient.getCalendarExport(bookingId);
      btnGoogleCalendar.href = cal.googleUrl;
      btnIcsCalendar.href = cal.icsUrl;
    } catch (err) {
      console.error('Error al obtener enlaces de calendario:', err);
    }

    goToStep(5);
  }

  btnRestartWizard.addEventListener('click', () => {
    window.location.reload();
  });

  // ==========================================================================
  // INICIALIZACIÓN DE SESIÓN
  // ==========================================================================
  async function initSession() {
    try {
      const session = await AgendamientoClient.getSession();
      currentSession = session;
      renderSessionState();
      if (session.authenticated) {
        await loadProfile();
      }
    } catch (err) {
      console.error('Error al consultar sesión:', err);
    }
  }

  function renderSessionState() {
    if (currentSession && currentSession.authenticated) {
      step3AuthOut.classList.add('hidden');
      step3AuthIn.classList.remove('hidden');
      step3Name.textContent = currentSession.user.name;
      step3Email.textContent = currentSession.user.email;
      step3Avatar.textContent = (currentSession.user.name[0] || 'U').toUpperCase();
    } else {
      step3AuthOut.classList.remove('hidden');
      step3AuthIn.classList.add('hidden');
    }
  }

  async function loadProfile() {
    try {
      const p = await AgendamientoClient.getPatientProfile();
      if (p.profile) {
        stepInputName.value = p.profile.name || '';
        stepInputDocType.value = p.profile.documentType || 'rut';
        stepInputRut.value = p.profile.rut || '';
        stepInputEmail.value = p.profile.email || '';
        stepInputPhone.value = p.profile.phone || '';
        rememberedProfileVersion = p.version;
      } else if (currentSession && currentSession.user) {
        stepInputName.value = currentSession.user.name || '';
        stepInputEmail.value = currentSession.user.email || '';
      }
    } catch (err) {
      console.error('Error al precargar perfil:', err);
    }
  }

  if (btnStep3QuickLogin) {
    btnStep3QuickLogin.addEventListener('click', async () => {
      try {
        await AgendamientoClient.mockLogin('patient');
        await initSession();
      } catch (err) {
        console.error('Error en quick login:', err);
      }
    });
  }

  // Arrancar en Paso 1
  renderDatePills();
  initSession();
  goToStep(1);
</script>

<style>
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-step {
    animation: stepFadeIn 0.25s ease-out forwards;
  }
</style>

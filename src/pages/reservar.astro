            <p><span class="text-slate-500">Profesional:</span> <span id="success-pro" class="font-semibold text-slate-800"></span></p>
            <p><span class="text-slate-500">Horario:</span> <span id="success-time" class="font-semibold text-slate-800"></span></p>
            <p><span class="text-slate-500">Paciente:</span> <span id="success-patient" class="font-semibold text-slate-800"></span></p>

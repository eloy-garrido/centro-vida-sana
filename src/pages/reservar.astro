  // ==========================================================================
  // FUNCIÓN CENTRAL: NAVEGACIÓN ENTRE PASOS
  // ==========================================================================
  function goToStep(step: number, isInitial = false) {
    currentStep = step;

    const views = [stepView1, stepView2, stepView3, stepView4, stepViewSuccess];

    if (isInitial && step === 1) {
      // Entrada inicial sin pestañeo ni salto de opacidad sobre el HTML estático
      views.forEach((v, idx) => {
        if (idx !== 0) v.classList.add('hidden');
        v.classList.remove('animate-step');
      });
      stepView1.classList.remove('hidden');
    } else {
      views.forEach((v) => {
        v.classList.add('hidden');
        v.classList.remove('animate-step');
      });

      const activeView = views[step - 1];
      if (activeView) {
        activeView.classList.remove('hidden');
        void activeView.offsetWidth;
        activeView.classList.add('animate-step');
      }
    }

    // Actualizar barra de progreso (Desktop)
    stepNavItems.forEach((item, index) => {
      const stepNum = index + 1;
      const numSpan = item.querySelector('.step-nav-number') as HTMLElement;

      if (stepNum < step) {
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold border transition-all duration-200 select-none bg-emerald-50 text-emerald-800 border-emerald-200';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold shrink-0 bg-emerald-600 text-white animate-check-pop';
        numSpan.innerHTML = '✓';
      } else if (stepNum === step) {
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-200 select-none bg-slate-900 text-white shadow-xs';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-white/20 text-white text-xs font-bold shrink-0 animate-number-pop';
        numSpan.textContent = String(stepNum);
      } else {
        item.className = 'step-nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-500 transition-all duration-200 select-none';
        numSpan.className = 'step-nav-number flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold shrink-0';
        numSpan.textContent = String(stepNum);
      }
    });

    // Actualizar barra móvil
    if (step <= 4) {
      mobileStepIndicator.textContent = `Paso ${step} de 4`;
      mobileStepTitle.textContent = stepTitles[step - 1];

      for (let i = 0; i < 4; i++) {
        mobileDots[i].className = i + 1 === step
          ? 'w-2.5 h-2.5 rounded-full bg-slate-900 transition-all duration-200 scale-110'
          : (i + 1 < step ? 'w-2.5 h-2.5 rounded-full bg-emerald-600 transition-all duration-200' : 'w-2.5 h-2.5 rounded-full bg-slate-200 transition-all duration-200');
      }
    }

    if (!isInitial) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }


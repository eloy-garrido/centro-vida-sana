  // 6. BÚSQUEDA DE PACIENTES E HISTORIAL CLÍNICO
  async function performSearch(query: string) {
    const q = (query || '').trim();
    if (q.length < 2) {
      clearSearchState();
      loadSchedule();
      return;
    }

    isSearchMode = true;
    currentSearchQuery = q;
    if (btnClearSearch) btnClearSearch.classList.remove('hidden');
    if (searchSpinner) searchSpinner.classList.remove('hidden');
    if (historicalBanner) historicalBanner.classList.add('hidden');

    scheduleSlotsContainer.innerHTML = '';
    scheduleLoading.classList.remove('hidden');
    scheduleLoading.innerHTML = `
      <svg class="animate-spin w-6 h-6 text-slate-800 mx-auto mb-2" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Buscando atenciones en el historial clínico...
    `;

    try {
      const res = await AgendamientoClient.searchPatientAppointments(q, currentSession.csrfToken);
      scheduleLoading.classList.add('hidden');
      if (searchSpinner) searchSpinner.classList.add('hidden');

      if (scheduleSectionTitle) {
        scheduleSectionTitle.textContent = `Historial de Atenciones: "${escapeHtml(q)}"`;
      }

      if (searchMetricsBanner && searchMetricTotal && searchMetricAttended && searchMetricNoshow && searchMetricUpcoming) {
        searchMetricTotal.textContent = `Total: ${res.stats.totalAppointments} ${res.stats.totalAppointments === 1 ? 'cita' : 'citas'}`;
        searchMetricAttended.textContent = `✓ Asistidas: ${res.stats.attendedCount}`;
        searchMetricNoshow.textContent = `✕ Inasistencias: ${res.stats.noShowCount}`;
        searchMetricUpcoming.textContent = `🗓️ Próximas: ${res.stats.upcomingCount}`;
        searchMetricsBanner.classList.remove('hidden');
      }

      renderSearchResults(res);
    } catch (err: any) {
      scheduleLoading.classList.add('hidden');
      if (searchSpinner) searchSpinner.classList.add('hidden');
      scheduleSlotsContainer.innerHTML = `
        <div class="p-8 text-center text-xs text-red-600 font-medium">

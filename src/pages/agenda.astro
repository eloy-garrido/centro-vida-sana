---
/**
 * Centro Vida Sana Austral — Panel Compartido del Equipo (S05 / D01 / D03 / D04 / D07 / S09)
 * Gestión de las dos agendas oficiales (Felipe y Eduardo) con control de concurrencia optimista y versión.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { clinicInfo } from '../data/clinic';
import { professionals } from '../data/professionals';
---

<BaseLayout
  title={`Panel de Agenda | ${clinicInfo.name}`}
  description="Panel interno de gestión de agendas y atenciones clínicas de Centro Vida Sana Austral."
  noindex={true}
>
  <div class="min-h-screen flex flex-col bg-[#F8F9F6]">
    <!-- Barra Superior Minimalista de Gestión Clínica (Distraction-free) -->
    <header class="bg-white border-b border-slate-200/90 sticky top-0 z-30 shadow-xs shrink-0">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group transition-opacity hover:opacity-85" aria-label="Volver al inicio">
          <img
            src="/pix/logo-sin-texto-96.webp"
            alt="Centro Vida Sana Logo"
            class="w-8 h-8 rounded-full object-cover shadow-xs border border-slate-100"
          />
          <div class="flex items-center gap-2">
            <span class="font-serif font-bold text-base sm:text-lg text-slate-900 tracking-tight">
              Centro Vida Sana
            </span>
            <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
              Panel Clínico
            </span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="/reservar"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition-colors py-1.5 px-3 rounded-lg"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Pasarela Pacientes</span>
          </a>

          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors py-1.5 px-3 rounded-lg hover:bg-slate-100/70"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span>Volver al sitio web</span>
          </a>
        </div>
      </div>
    </header>

    <div class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8 flex flex-col justify-between">
    <div class="max-w-6xl mx-auto w-full">

      <!-- Encabezado del Panel -->
      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-semibold bg-slate-900 text-white tracking-wide uppercase">
              Panel Clínico
            </span>
            <span class="text-xs text-slate-500 font-medium">Zona Horaria: America/Santiago</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-serif text-[#151C17] tracking-tight">
            Gestión de Agendas
          </h1>
        </div>

        <!-- Perfil / Sesión Equipo -->
        <div id="team-session-box" class="hidden flex items-center gap-3 bg-white px-4 py-2.5 rounded-xl border border-slate-200 shadow-sm">
          <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs" id="team-user-avatar">
            E
          </div>
          <div class="text-left">
            <p id="team-user-name" class="text-xs font-semibold text-slate-900">Equipo Vida Sana</p>
            <p id="team-user-email" class="text-[11px] text-slate-500">centrovida.sanaaustral@gmail.com</p>
          </div>
          <button
            type="button"
            id="btn-team-logout"
            class="ml-2 text-xs text-slate-400 hover:text-red-700 hover:underline transition-colors"
          >
            Salir
          </button>
        </div>
      </header>

      <!-- Pantalla de Login Requerido si no es equipo -->
      <div id="team-login-gate" class="hidden bg-white rounded-2xl p-6 sm:p-10 shadow-sm border border-slate-200 text-center max-w-lg mx-auto my-12 animate-fade-in">
        
        <!-- Estado 1: Anónimo / Sin Sesión Iniciada -->
        <div id="gate-anonymous" class="space-y-4">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-800 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h2 class="text-xl font-serif text-slate-900 font-medium mb-1">Acceso Exclusivo del Equipo</h2>
          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            Esta sección está reservada para los profesionales y el administrador de Centro Vida Sana Austral.
          </p>
          <div class="space-y-3">
            <a
              href="/auth/google/start?returnTo=/agenda"
              class="w-full inline-flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9z"/>
                <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z"/>
              </svg>
              <span>Identificarse con Cuenta de Equipo</span>
            </a>
            <!-- Atajo para entorno local -->
            <button
              type="button"
              id="btn-dev-quick-team"
              class="hidden w-full py-2.5 px-4 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-300 transition-colors"
            >
              ⚡ Acceso Rápido de Prueba (Administrador / Equipo)
            </button>
          </div>
        </div>

        <!-- Estado 2: Autenticado pero Sin Permisos de Equipo (No registrado en team_members) -->
        <div id="gate-forbidden" class="hidden space-y-4">
          <div class="w-14 h-14 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center mx-auto mb-2">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            Acceso No Autorizado
          </span>

          <h2 class="text-xl font-serif text-slate-900 font-medium">Cuenta sin Permisos de Equipo</h2>

          <!-- Tarjeta con la cuenta activa del usuario -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 text-left flex items-center gap-3 my-4">
            <div id="gate-user-avatar" class="w-9 h-9 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0">
              U
            </div>
            <div class="min-w-0 flex-1">
              <p id="gate-user-name" class="text-xs font-bold text-slate-900 truncate">Usuario</p>
              <p id="gate-user-email" class="text-[11px] text-slate-500 font-mono truncate">correo@gmail.com</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-200 text-slate-700 shrink-0">
              Rol: Paciente
            </span>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            Iniciaste sesión con Google, pero este correo no está registrado como profesional de salud ni como administrador de Centro Vida Sana.
          </p>

          <div class="space-y-2.5 pt-2">
            <button
              type="button"
              id="btn-gate-switch-account"
              class="w-full inline-flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9z"/>
                <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z"/>
              </svg>
              <span>Cambiar a Cuenta de Equipo</span>
            </button>

            <div class="flex gap-2">
              <button
                type="button"
                id="btn-gate-logout"
                class="flex-1 py-2.5 px-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors"
              >
                Cerrar Sesión
              </button>
              <a
                href="/reservar"
                class="flex-1 inline-flex items-center justify-center py-2.5 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-200 transition-colors"
              >
                Ir a Reservas Paciente
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- CONTENEDOR PRINCIPAL DEL PANEL -->
      <div id="team-app-content" class="hidden space-y-6">

        <!-- Selector de Pestañas Superiores (S05: Felipe Méndez y Eduardo Lagos) -->
        <div class="bg-white rounded-2xl p-2 shadow-sm border border-slate-200 flex flex-col sm:flex-row gap-2">
          <!-- Pestaña Felipe -->
          <button
            type="button"
            id="tab-felipe"
            class="flex-1 flex items-center justify-center gap-3 py-3 px-4 rounded-xl text-sm font-semibold transition-all select-none border-2 border-slate-900 bg-slate-900 text-white shadow-sm"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            <span>Felipe Méndez (Quiropraxia & Kinesiología)</span>
          </button>

          <!-- Pestaña Eduardo -->
          <button
            type="button"
            id="tab-eduardo"
            class="flex-1 flex items-center justify-center gap-3 py-3 px-4 rounded-xl text-sm font-semibold transition-all select-none border-2 border-transparent text-slate-700 hover:bg-slate-100"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span>Eduardo Lagos (Acupuntura & Medicina China)</span>
          </button>
        </div>

        <!-- Barra de Controles de Fecha e Historial Clínico -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Navegación rápida (Día anterior, Hoy, Día siguiente) -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-prev-day"
              class="p-2 sm:p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 active:scale-95 text-slate-700 transition-all shadow-xs"
              title="Día anterior"
              aria-label="Día anterior"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>

            <button
              type="button"
              id="btn-today"
              class="px-3 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700 transition-all shadow-xs active:scale-95 flex items-center gap-1.5 cursor-pointer"
              title="Ir a la fecha de hoy"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Hoy</span>
            </button>

            <button
              type="button"
              id="btn-next-day"
              class="p-2 sm:p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 active:scale-95 text-slate-700 transition-all shadow-xs"
              title="Día siguiente"
              aria-label="Día siguiente"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <!-- Selector Interactivo de Fecha / Calendario (Lado Derecho) -->
          <div class="relative self-stretch sm:self-auto">
            <button
              type="button"
              id="date-picker-trigger"
              class="w-full sm:w-auto flex items-center justify-between sm:justify-end gap-3 px-3.5 py-2.5 rounded-xl border border-slate-200 hover:border-slate-400 bg-white hover:bg-slate-50/80 active:bg-slate-100 transition-all shadow-2xs select-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-slate-900 focus:ring-offset-2 group text-left"
              title="Hacer clic para abrir el calendario y cambiar de día, mes o año"
              aria-label="Abrir calendario para seleccionar día, mes o año"
              aria-haspopup="dialog"
            >
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>

              <div class="text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <p id="schedule-active-date-label" class="text-sm sm:text-base font-serif text-slate-900 font-bold capitalize leading-snug">
                    Cargando fecha...
                  </p>
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-800 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </div>
                <p id="schedule-active-date-sublabel" class="text-[11px] text-slate-500 font-medium">
                  Clic para abrir calendario (mes / año)
                </p>
              </div>
            </button>

            <!-- Input nativo tipo date anclado al contenedor para disparar el selector nativo -->
            <input
              type="date"
              id="input-date-picker"
              tabindex="-1"
              aria-hidden="true"
              class="absolute inset-0 w-full h-full opacity-0 pointer-events-none -z-10"
            />
          </div>
        </div>

        <!-- Barra de Búsqueda de Pacientes e Historial Clínico -->
        <div class="bg-white rounded-2xl p-3 sm:p-4 shadow-sm border border-slate-200">
          <div class="relative flex items-center">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <input
              type="search"
              id="input-patient-search"
              placeholder="Buscar paciente por nombre, RUT (ej. 12345678-5) o correo electrónico..."
              autocomplete="off"
              class="w-full pl-10 pr-24 py-2.5 rounded-xl border border-slate-200 hover:border-slate-300 focus:border-slate-900 focus:ring-2 focus:ring-slate-900/10 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 bg-slate-50/50 focus:bg-white transition-all outline-none"
            />
            <div class="absolute inset-y-0 right-0 pr-2 flex items-center gap-1.5">
              <button
                type="button"
                id="btn-clear-search"
                class="hidden px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
                title="Limpiar búsqueda y volver a la jornada del día"
              >
                Limpiar ✕
              </button>
              <span id="search-spinner" class="hidden pr-2 text-slate-400">
                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>

        <!-- Tabla / Timeline de Horarios del Día -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <h2 id="schedule-section-title" class="text-base font-serif text-slate-900 font-medium">Jornada de Atención</h2>
            <div class="flex items-center gap-3 text-xs flex-wrap">
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Disponible
              </span>
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span> Cita
              </span>
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Bloqueo
              </span>
            </div>
          </div>

          <!-- Banner Informativo de Métricas de Búsqueda -->
          <div id="search-metrics-banner" class="hidden px-4 sm:px-6 py-3 bg-emerald-50/90 border-b border-emerald-200 text-xs text-emerald-950 flex flex-wrap items-center justify-between gap-2.5 animate-fade-in">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-emerald-900 flex items-center gap-1">
                <span>📋</span>
                <span>Contexto de Atenciones:</span>
              </span>
              <span id="search-metric-total" class="px-2.5 py-0.5 rounded-full bg-white font-semibold text-slate-800 border border-emerald-200 shadow-2xs">Total: 0 citas</span>
              <span id="search-metric-attended" class="px-2.5 py-0.5 rounded-full bg-emerald-100 font-semibold text-emerald-900 border border-emerald-300 shadow-2xs">✓ Asistidas: 0</span>
              <span id="search-metric-noshow" class="px-2.5 py-0.5 rounded-full bg-rose-100 font-semibold text-rose-900 border border-rose-300 shadow-2xs">✕ Inasistencias: 0</span>
              <span id="search-metric-upcoming" class="px-2.5 py-0.5 rounded-full bg-blue-100 font-semibold text-blue-900 border border-blue-300 shadow-2xs">🗓️ Próximas: 0</span>
            </div>
            <button
              type="button"
              id="btn-banner-clear-search"
              class="inline-flex items-center gap-1 text-xs font-bold text-emerald-950 bg-white hover:bg-emerald-100 border border-emerald-300 px-3 py-1 rounded-lg transition-colors cursor-pointer shadow-2xs"
            >
              <span>✕ Volver a la jornada del día</span>
            </button>
          </div>

          <!-- Banner Informativo de Modo Historial (cuando se consulta fecha anterior) -->
          <div id="historical-banner" class="hidden px-6 py-3 bg-amber-50/90 border-b border-amber-200/80 text-xs text-amber-900 flex flex-wrap items-center justify-between gap-2 animate-fade-in">
            <div class="flex items-center gap-2">
              <span class="text-base">📜</span>
              <span class="font-medium">Estás revisando el <strong>historial retroactivo de pacientes</strong> de una fecha anterior.</span>
            </div>
            <button
              type="button"
              id="btn-banner-today"
              class="inline-flex items-center gap-1 text-xs font-bold text-amber-950 bg-amber-100 hover:bg-amber-200 border border-amber-300 px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
            >
              <span>Volver a Hoy</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <!-- Loading State -->
          <div id="schedule-loading" class="p-8 text-center text-slate-400 text-xs">
            <svg class="animate-spin w-6 h-6 text-slate-800 mx-auto mb-2" fill="none" viewBox="0 0 24 24">

  // 1. INICIALIZAR SESIÓN DE EQUIPO
  async function initTeamSession() {
    try {
      const session = await AgendamientoClient.getSession();
      currentSession = session;
      if (session.authenticated && session.capabilities.teamAgenda) {
        teamLoginGate.classList.add('hidden');
        teamAppContent.classList.remove('hidden');
        teamSessionBox.classList.remove('hidden');
        teamUserName.textContent = session.user.name;
        teamUserEmail.textContent = session.user.email;
        loadSchedule();
      } else if (session.authenticated && !session.capabilities.teamAgenda) {
        // Autenticado pero sin membresía de equipo
        teamLoginGate.classList.remove('hidden');
        gateAnonymous.classList.add('hidden');
        gateForbidden.classList.remove('hidden');
        teamAppContent.classList.add('hidden');
        teamSessionBox.classList.add('hidden');

        gateUserName.textContent = session.user.name;
        gateUserEmail.textContent = session.user.email;
        gateUserAvatar.textContent = (session.user.name[0] || 'U').toUpperCase();
      } else {
        // Anónimo / sin sesión iniciada
        teamLoginGate.classList.remove('hidden');
        gateAnonymous.classList.remove('hidden');
        gateForbidden.classList.add('hidden');
        teamAppContent.classList.add('hidden');
        teamSessionBox.classList.add('hidden');
      }
    } catch (err) {
      console.error('Error al inicializar sesión:', err);
    }
  }


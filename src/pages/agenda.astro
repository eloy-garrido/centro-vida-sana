  // 3. CONTROLES DE FECHA
  function setDate(dateStr: string) {
    activeDateString = dateStr;
    inputDatePicker.value = dateStr;
    const d = new Date(dateStr + 'T12:00:00Z');
    scheduleActiveDateLabel.textContent = d.toLocaleDateString('es-CL', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
    loadSchedule();
  }

  btnPrevDay.addEventListener('click', () => {
    const cur = new Date(activeDateString + 'T12:00:00Z');
    const prev = new Date(cur.getTime() - 24 * 3600 * 1000);
    setDate(prev.toLocaleDateString('en-CA', { timeZone: 'America/Santiago' }));
  });

  btnNextDay.addEventListener('click', () => {
    const cur = new Date(activeDateString + 'T12:00:00Z');
    const next = new Date(cur.getTime() + 24 * 3600 * 1000);
    setDate(next.toLocaleDateString('en-CA', { timeZone: 'America/Santiago' }));
  });

  inputDatePicker.addEventListener('change', () => {
    if (inputDatePicker.value) {
      setDate(inputDatePicker.value);
    }
  });

  // 4. CARGAR AGENDA DEL DÍA (GET /api/team/schedule)
  async function loadSchedule() {
    scheduleLoading.classList.remove('hidden');
    scheduleSlotsContainer.innerHTML = '';

    try {
      // S09: Rango de consulta [activeDateString, nextDateStr)
      const nextDate = new Date(new Date(activeDateString + 'T12:00:00Z').getTime() + 24 * 3600 * 1000);
      const nextDateStr = nextDate.toLocaleDateString('en-CA', { timeZone: 'America/Santiago' });

      const schedule = await AgendamientoClient.getTeamSchedule(activeProfessional, activeDateString, nextDateStr);
      currentScheduleData = schedule;
      scheduleLoading.classList.add('hidden');
      renderScheduleRows(schedule);
    } catch (err: any) {
      scheduleLoading.classList.add('hidden');
      scheduleSlotsContainer.innerHTML = `
        <div class="p-6 text-center text-xs text-red-600 font-medium">
          Error al cargar agenda: ${err.message}
        </div>
      `;
    }
  }


  // 7. EVENTOS DE ACCIONES DE FILA
  function bindRowActions() {
    // Abrir modal de agendar paciente
    document.querySelectorAll('.btn-open-booking').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hour = parseInt(btn.getAttribute('data-hour')!, 10);
        const timeLabel = btn.getAttribute('data-timelabel')!;
        openBookingModal(hour, timeLabel);
      });
    });

    // Abrir bloqueo administrativo
    document.querySelectorAll('.btn-open-block').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hour = parseInt(btn.getAttribute('data-hour')!, 10);
        createBlockDirect(hour);
      });
    });

    // Abrir modal de cancelación
    document.querySelectorAll('.btn-cancel-entry').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id')!;
        const patient = btn.getAttribute('data-patient')!;
        const rawVer = btn.getAttribute('data-version') || 'v1';
        const version = rawVer.startsWith('"') ? rawVer : `"${rawVer}"`;
        openCancelModal(id, patient, version);
      });
    });

    // Liberar bloqueo directamente
    document.querySelectorAll('.btn-delete-block').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const rawVer = btn.getAttribute('data-version') || 'v1';
        const version = rawVer.startsWith('"') ? rawVer : `"${rawVer}"`;
        if (!confirm('¿Liberar este horario bloqueado para permitir reservas?')) return;
        try {
          await AgendamientoClient.deleteTeamBlock(id, version, currentSession.csrfToken);
          refreshCurrentView();
        } catch (err: any) {
          alert('Error al liberar bloqueo: ' + err.message);
        }
      });
    });

    // Enviar correo de invitación a calificar en Google
    document.querySelectorAll('.btn-send-review-email').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const name = btn.getAttribute('data-name') || 'el paciente';
        const email = btn.getAttribute('data-email') || '';

        if (!email) {
          alert('Esta cita no tiene un correo electrónico registrado.');
          return;
        }

        const confirmSend = confirm(
          `¿Deseas enviar el correo de invitación para calificar en Google a ${name} (${email})?`
        );
        if (!confirmSend) return;

        const buttonEl = btn as HTMLButtonElement;
        const originalHtml = buttonEl.innerHTML;
        buttonEl.disabled = true;
        buttonEl.innerHTML = `
          <svg class="w-3 h-3 animate-spin shrink-0 text-amber-600" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span class="text-[11px]">Enviando...</span>
        `;

        try {
          const res = await AgendamientoClient.sendReviewInviteEmail(id, currentSession.csrfToken);
          buttonEl.classList.remove('text-amber-900', 'hover:bg-amber-100');
          buttonEl.classList.add('bg-emerald-100', 'text-emerald-900');
          buttonEl.innerHTML = `
            <span class="text-emerald-700 font-bold">✓</span>
            <span class="text-[11px]">¡Enviado!</span>
          `;
          alert(`¡Correo de calificación en Google enviado con éxito a ${name} (${email})!`);
        } catch (err: any) {
          buttonEl.disabled = false;
          buttonEl.innerHTML = originalHtml;
          alert('No se pudo enviar el correo de calificación: ' + (err.message || err));
        }
      });
    });

    // Alternar asistencia de pacientes (toggle Asistió <-> Inasistencia)
    document.querySelectorAll('.btn-toggle-attendance').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const nextStatus = btn.getAttribute('data-next-status') as 'attended' | 'no_show';
        const buttonEl = btn as HTMLButtonElement;
        const originalHtml = buttonEl.innerHTML;
        buttonEl.disabled = true;

        try {
          await AgendamientoClient.updateAttendance(id, nextStatus, currentSession.csrfToken);
          // Recargar vista para actualizar visualmente la tarjeta
          await refreshCurrentView();
        } catch (err: any) {
          buttonEl.disabled = false;
          buttonEl.innerHTML = originalHtml;
          alert('Error al actualizar la asistencia: ' + (err.message || err));
        }
      });
    });

    // Abrir Ficha y Notas de Paciente
    document.querySelectorAll('.btn-open-patient-notes').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const bookingId = btn.getAttribute('data-booking-id')!;
        openPatientNotesModal(bookingId);
      });
    });
  }

  // MODAL DE AGENDAR
  function openBookingModal(hour: number, timeLabel: string) {
    pendingSlotTime = `${activeDateString} ${timeLabel}`;
    modalBookPro.textContent = activeProfessional === 'felipe' ? 'Felipe Méndez (Quiropraxia & Kinesiología)' : 'Eduardo Lagos (Acupuntura & Medicina China)';
    modalBookTime.textContent = `${activeDateString}, ${timeLabel}`;
    formTeamBooking.reset();
    if (teamInputNotifyPatient) {
      teamInputNotifyPatient.checked = true;
    }
    modalBookError.classList.add('hidden');
    modalTeamBooking.classList.remove('hidden');

    formTeamBooking.onsubmit = async (e) => {
      e.preventDefault();
      modalBookError.classList.add('hidden');

      // Calcular timestamp UTC exacto dinámico para America/Santiago
      const startAtUtc = chileHourToUtcIso(activeDateString, hour);
      const idempKey = 'team_bk_' + Math.random().toString(36).substring(2, 10);

      try {
        await AgendamientoClient.createTeamBooking(
          {
            professionalId: activeProfessional,
            startAt: startAtUtc,
            patient: {
              name: teamInputName.value.trim(),
              email: teamInputEmail.value.trim(),
              rut: teamInputRut.value.trim(),
              documentType: teamInputDocType.value as any,
              phone: teamInputPhone.value.trim()
            },
            consentVersion: 'v1.0',
            notifyPatient: teamInputNotifyPatient ? teamInputNotifyPatient.checked : true
          },
          idempKey,
          currentSession.csrfToken
        );

        modalTeamBooking.classList.add('hidden');
        refreshCurrentView();
      } catch (err: any) {
        modalBookError.textContent = err.message || 'Error al agendar cita.';
        modalBookError.classList.remove('hidden');
      }
    };
  }

  // CREAR BLOQUEO
  async function createBlockDirect(hour: number) {
    if (!confirm(`¿Bloquear la hora de las ${hour}:00 a ${hour + 1}:00 en la agenda de ${activeProfessional}?`)) return;

    const startUtc = chileHourToUtcIso(activeDateString, hour);
    const endUtc = chileHourToUtcIso(activeDateString, hour + 1);
    const idempKey = 'blk_' + Math.random().toString(36).substring(2, 10);

    try {
      await AgendamientoClient.createTeamBlock(activeProfessional, startUtc, endUtc, idempKey, currentSession.csrfToken);
      refreshCurrentView();
    } catch (err: any) {
      alert('Error al crear bloqueo: ' + err.message);
    }
  }

  // MODAL DE CANCELACIÓN CON IF-MATCH
  function openCancelModal(bookingId: string, patientName: string, version: string) {
    pendingCancelBookingId = bookingId;
    pendingCancelVersion = version;
    cancelModalPatient.textContent = patientName;
    cancelModalId.textContent = bookingId;
    cancelModalVersion.textContent = version;
    cancelModalError.classList.add('hidden');
    modalCancelBooking.classList.remove('hidden');
  }

  btnConfirmCancelAction.addEventListener('click', async () => {
    if (!pendingCancelBookingId || !pendingCancelVersion) return;
    cancelModalError.classList.add('hidden');

    try {
      await AgendamientoClient.cancelTeamBooking(
        pendingCancelBookingId,
        pendingCancelVersion,
        currentSession.csrfToken
      );
      modalCancelBooking.classList.add('hidden');
      refreshCurrentView();
    } catch (err: any) {
      if (err instanceof ApiError && err.code === 'VERSION_CONFLICT') {
        cancelModalError.textContent = 'La cita fue modificada previamente por otro usuario. Recarga la agenda.';
      } else {
        cancelModalError.textContent = err.message || 'Error al cancelar la cita.';
      }
      cancelModalError.classList.remove('hidden');
    }
  });

  // ============================================================================
  // GESTIÓN DE FICHA CLÍNICA Y NOTAS DE EVOLUCIÓN (MODAL 3)
  // ============================================================================

  async function openPatientNotesModal(bookingId: string) {
    currentNotesBookingId = bookingId;
    currentNotesPatientKey = null;
    currentNotesList = [];

    // Limpiar formulario y estados
    inputNewNote.value = '';
    newNoteError.classList.add('hidden');
    newNoteError.textContent = '';
    btnSaveNewNote.disabled = false;
    btnSaveNewNote.innerHTML = '<span>Guardar Nota</span>';

    notesModalPatientName.textContent = 'Cargando paciente...';
    notesModalRutBadge.textContent = '';
    notesModalRutBadge.classList.add('hidden');
    notesModalPhoneWrap.innerHTML = '';
    notesModalEmailWrap.innerHTML = '';
    notesModalProTag.textContent = '';

    notesLoadingSpinner.classList.remove('hidden');
    notesEmptyState.classList.add('hidden');
    notesAccordionList.innerHTML = '';
    notesCountBadge.textContent = '0';

    const proName = activeProfessional === 'felipe' ? 'Felipe Méndez (Quiropraxia & Kinesiología)' : 'Eduardo Lagos (Acupuntura & MTC)';
    newNoteProLabel.textContent = `Registrando como: ${proName}`;

    modalPatientNotes.classList.remove('hidden');

    try {
      const data = await AgendamientoClient.getBookingNotes(bookingId);
      currentNotesPatientKey = data.patientKey;
      currentNotesList = data.notes || [];

      // Cabecera paciente
      notesModalPatientName.textContent = data.patient.name || 'Paciente';
      notesModalProTag.textContent = `Atención en Centro Vida Sana`;

      if (data.patient.rut) {
        notesModalRutBadge.textContent = `RUT: ${data.patient.rut}`;
        notesModalRutBadge.classList.remove('hidden');
      }

      if (data.patient.phone) {
        notesModalPhoneWrap.innerHTML = `
          <a href="tel:${data.patient.phone.replace(/\s+/g, '')}" class="text-slate-600 hover:text-emerald-700 font-medium inline-flex items-center gap-1">
            <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>${escapeHtml(data.patient.phone)}</span>
          </a>
        `;
      }

      if (data.patient.email) {
        notesModalEmailWrap.innerHTML = `
          <span class="text-slate-300">·</span>
          <a href="mailto:${data.patient.email}" class="text-slate-500 hover:text-slate-800 inline-flex items-center gap-1">
            <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>${escapeHtml(data.patient.email)}</span>
          </a>
        `;
      }

      notesLoadingSpinner.classList.add('hidden');
      renderNotesAccordion(currentNotesList);
    } catch (err: any) {
      notesLoadingSpinner.classList.add('hidden');
      notesModalPatientName.textContent = 'Error al cargar ficha';
      notesAccordionList.innerHTML = `<p class="text-xs text-red-600 p-4 bg-red-50 rounded-xl">${escapeHtml(err.message || 'Error al obtener notas.')}</p>`;
    }
  }

  function renderNotesAccordion(notes: any[]) {
    notesCountBadge.textContent = String(notes.length);
    notesAccordionList.innerHTML = '';

    if (notes.length === 0) {
      notesEmptyState.classList.remove('hidden');
      return;
    }
    notesEmptyState.classList.add('hidden');

    notes.forEach((note) => {
      const isFelipe = note.professionalId === 'felipe';
      const createdDate = new Date(note.createdAt);
      const dateFormatted = createdDate.toLocaleDateString('es-CL', {
        timeZone: 'America/Santiago',
        weekday: 'short',
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
      const timeFormatted = createdDate.toLocaleTimeString('es-CL', {
        timeZone: 'America/Santiago',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      });

      const updatedDate = new Date(note.updatedAt);
      const isEdited = note.isEdited || updatedDate.getTime() > (createdDate.getTime() + 1000);
      const editedLabel = isEdited ? `<span class="text-[10px] text-slate-400 italic font-normal">(editado)</span>` : '';

      // Colores institucionales: Felipe (Azul Petróleo #134E5E) / Eduardo (Verde Salvia #2E4D38)
      const borderClass = isFelipe ? 'border-l-4 border-l-[#134E5E]' : 'border-l-4 border-l-[#2E4D38]';
      const badgeClass = isFelipe
        ? 'bg-[#134E5E]/10 text-[#134E5E] border-[#134E5E]/20'
        : 'bg-[#2E4D38]/10 text-[#2E4D38] border-[#2E4D38]/20';
      const proTitle = isFelipe ? 'Felipe Méndez · Quiropraxia' : 'Eduardo Lagos · Acupuntura';

      const card = document.createElement('div');
      card.className = `bg-white rounded-xl border border-slate-200/90 shadow-2xs overflow-hidden transition-all ${borderClass}`;
      card.setAttribute('data-note-id', note.id);

      card.innerHTML = `
        <!-- Barra de Cabecera Colapsada (Clickeable tipo Acordeón) -->
        <button
          type="button"
          class="btn-toggle-note-accordion w-full px-4 py-3 flex items-center justify-between gap-3 text-left hover:bg-slate-50/80 transition-colors cursor-pointer select-none"
          aria-expanded="false"
        >
          <div class="flex items-center gap-2.5 flex-wrap min-w-0">
            <span class="text-xs font-bold text-slate-900 capitalize">${dateFormatted} · ${timeFormatted} hrs</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border ${badgeClass}">
              ${proTitle}
            </span>
            ${editedLabel}
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <svg class="chevron-icon w-4 h-4 text-slate-400 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>
        </button>

        <!-- Contenido Expandible de la Nota -->
        <div class="note-expand-body hidden border-t border-slate-100 p-4 bg-slate-50/40">
          <div class="note-view-mode flex items-start justify-between gap-3">
            <div class="note-text-content text-xs text-slate-800 leading-relaxed font-sans whitespace-pre-wrap flex-1 min-w-0">
              ${escapeHtml(note.content)}
            </div>
            <button
              type="button"
              class="btn-edit-note p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors shrink-0 cursor-pointer"
              title="Editar esta nota"
              aria-label="Editar nota"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
            </button>
          </div>

          <!-- Modo Edición Inline -->
          <div class="note-edit-mode hidden space-y-2.5 pt-1">
            <textarea
              class="input-edit-note w-full text-xs text-slate-900 bg-white border border-slate-300 rounded-xl p-3 focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 outline-none transition-all resize-y"
              rows="3"
            >${escapeHtml(note.content)}</textarea>
            <p class="edit-note-error hidden text-xs text-red-600 font-medium"></p>
            <div class="flex items-center justify-end gap-2">
              <button
                type="button"
                class="btn-cancel-edit-note px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer"
              >
                Cancelar
              </button>
              <button
                type="button"
                class="btn-save-edit-note px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold shadow-xs transition-colors cursor-pointer"
              >
                Guardar cambios
              </button>
            </div>
          </div>
        </div>
      `;

      // Accordion toggle click
      const btnToggle = card.querySelector('.btn-toggle-note-accordion')!;
      const expandBody = card.querySelector('.note-expand-body')!;
      const chevron = card.querySelector('.chevron-icon')!;

      btnToggle.addEventListener('click', () => {
        const isExpanded = !expandBody.classList.contains('hidden');
        if (isExpanded) {
          expandBody.classList.add('hidden');
          chevron.classList.remove('rotate-180');
          btnToggle.setAttribute('aria-expanded', 'false');
        } else {
          expandBody.classList.remove('hidden');
          chevron.classList.add('rotate-180');
          btnToggle.setAttribute('aria-expanded', 'true');
        }
      });

      // Edit mode toggle
      const btnEdit = card.querySelector('.btn-edit-note')!;
      const viewMode = card.querySelector('.note-view-mode')!;
      const editMode = card.querySelector('.note-edit-mode')!;
      const textareaEdit = card.querySelector('.input-edit-note') as HTMLTextAreaElement;
      const btnCancelEdit = card.querySelector('.btn-cancel-edit-note')!;
      const btnSaveEdit = card.querySelector('.btn-save-edit-note') as HTMLButtonElement;
      const editError = card.querySelector('.edit-note-error')!;
      const textContentEl = card.querySelector('.note-text-content')!;

      btnEdit.addEventListener('click', () => {
        viewMode.classList.add('hidden');
        editMode.classList.remove('hidden');
        textareaEdit.value = note.content;
        textareaEdit.focus();
      });

      btnCancelEdit.addEventListener('click', () => {
        editMode.classList.add('hidden');
        viewMode.classList.remove('hidden');
        editError.classList.add('hidden');
      });

      btnSaveEdit.addEventListener('click', async () => {
        const newText = textareaEdit.value.trim();
        if (!newText) {
          editError.textContent = 'El contenido no puede estar vacío.';
          editError.classList.remove('hidden');
          return;
        }

        editError.classList.add('hidden');
        btnSaveEdit.disabled = true;
        btnSaveEdit.textContent = 'Guardando...';

        try {
          const res = await AgendamientoClient.updatePatientNote(note.id, newText, currentSession.csrfToken);
          note.content = res.note.content;
          note.isEdited = true;
          note.updatedAt = res.note.updatedAt;

          textContentEl.textContent = res.note.content;
          editMode.classList.add('hidden');
          viewMode.classList.remove('hidden');
          btnSaveEdit.disabled = false;
          btnSaveEdit.textContent = 'Guardar cambios';

          // Actualizar marca (editado) en la cabecera de la tarjeta si no estaba
          const headerBadgeWrap = card.querySelector('.btn-toggle-note-accordion > div')!;
          if (!headerBadgeWrap.querySelector('.italic')) {
            const span = document.createElement('span');
            span.className = 'text-[10px] text-slate-400 italic font-normal';
            span.textContent = '(editado)';
            headerBadgeWrap.appendChild(span);
          }
        } catch (err: any) {
          btnSaveEdit.disabled = false;
          btnSaveEdit.textContent = 'Guardar cambios';
          editError.textContent = err.message || 'Error al guardar cambios.';
          editError.classList.remove('hidden');
        }
      });

      notesAccordionList.appendChild(card);
    });
  }

  // Guardar nueva nota (formulario superior)
  btnSaveNewNote.addEventListener('click', async () => {
    if (!currentNotesPatientKey) {
      newNoteError.textContent = 'No se ha cargado la clave del paciente.';
      newNoteError.classList.remove('hidden');
      return;
    }

    const content = inputNewNote.value.trim();
    if (!content) {
      newNoteError.textContent = 'Escribe el contenido de la nota antes de guardar.';
      newNoteError.classList.remove('hidden');
      return;
    }

    newNoteError.classList.add('hidden');
    btnSaveNewNote.disabled = true;
    btnSaveNewNote.innerHTML = `
      <svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      <span>Guardando...</span>
    `;

    try {
      const res = await AgendamientoClient.createPatientNote(
        currentNotesPatientKey,
        {
          content,
          professionalId: activeProfessional,
          bookingId: currentNotesBookingId || undefined
        },
        currentSession.csrfToken
      );

      inputNewNote.value = '';
      btnSaveNewNote.disabled = false;
      btnSaveNewNote.innerHTML = '<span>Guardar Nota</span>';

      // Agregar al inicio de las notas y re-renderizar acordeón
      currentNotesList.unshift(res.note);
      renderNotesAccordion(currentNotesList);
    } catch (err: any) {
      btnSaveNewNote.disabled = false;
      btnSaveNewNote.innerHTML = '<span>Guardar Nota</span>';
      newNoteError.textContent = err.message || 'Error al guardar la nota.';
      newNoteError.classList.remove('hidden');
    }
  });

  // Cerrar Modal 3
  btnCloseNotesModal.addEventListener('click', () => {
    modalPatientNotes.classList.add('hidden');
  });

  modalPatientNotes.addEventListener('click', (e) => {
    if (e.target === modalPatientNotes) {
      modalPatientNotes.classList.add('hidden');
    }
  });

  // Cerrar modales
  document.querySelectorAll('.btn-close-modal').forEach((btn) => {
    btn.addEventListener('click', () => {
      modalTeamBooking.classList.add('hidden');
      modalCancelBooking.classList.add('hidden');
      modalPatientNotes.classList.add('hidden');
    });
  });

  // Cerrar modales con tecla Escape (A11y)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modalTeamBooking.classList.add('hidden');
      modalCancelBooking.classList.add('hidden');
      modalPatientNotes.classList.add('hidden');
    }
  });

  // LOGOUT EQUIPO
  btnTeamLogout.addEventListener('click', async () => {
    if (currentSession && currentSession.csrfToken) {
      await AgendamientoClient.logout(currentSession.csrfToken);
      window.location.reload();
    }
  });

  // BOTONES DE ESTADO NO AUTORIZADO
  if (btnGateSwitchAccount) {
    btnGateSwitchAccount.addEventListener('click', async () => {
      if (currentSession && currentSession.csrfToken) {
        try {
          await AgendamientoClient.logout(currentSession.csrfToken);
        } catch (_) {}
      }
      window.location.href = '/auth/google/start?returnTo=/agenda';
    });
  }

  if (btnGateLogout) {
    btnGateLogout.addEventListener('click', async () => {
      if (currentSession && currentSession.csrfToken) {
        try {
          await AgendamientoClient.logout(currentSession.csrfToken);
        } catch (_) {}
      }
      window.location.reload();
    });
  }

  // DEV LOGIN EQUIPO (Solo visible en entornos de desarrollo local)
  if (btnDevQuickTeam) {
    if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
      btnDevQuickTeam.classList.remove('hidden');
      btnDevQuickTeam.addEventListener('click', async () => {
        try {
          await AgendamientoClient.mockLogin('team');
          window.location.reload();
        } catch (err) {
          console.error('Error al iniciar sesión de equipo:', err);
        }
      });
    }
  }

  // LISTENERS DE BÚSQUEDA
  if (inputPatientSearch) {
    inputPatientSearch.addEventListener('input', () => {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        performSearch(inputPatientSearch.value);
      }, 300);
    });

    inputPatientSearch.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        clearSearchState();
        loadSchedule();
      }
    });
  }

  if (btnClearSearch) {
    btnClearSearch.addEventListener('click', () => {
      clearSearchState();
      loadSchedule();
    });
  }

  if (btnBannerClearSearch) {
    btnBannerClearSearch.addEventListener('click', () => {
      clearSearchState();
      loadSchedule();
    });
  }

  // Inicializar
  setDate(activeDateString);
  initTeamSession();
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-in {
    animation: fadeIn 0.2s ease-out forwards;
  }
</style>

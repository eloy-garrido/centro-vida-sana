    const d = new Date(activeDateString + 'T12:00:00Z');
    const isSaturday = d.getUTCDay() === 6;
    const isSunday = d.getUTCDay() === 0;

    if (isSunday) {
      scheduleSlotsContainer.innerHTML = `
        <div class="p-8 text-center bg-slate-50 text-slate-500 text-xs italic">

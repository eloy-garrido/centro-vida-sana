  // 6. EVENTOS DE ACCIONES DE FILA
  function bindRowActions() {
    // Abrir modal de agendar paciente
    document.querySelectorAll('.btn-open-booking').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hour = parseInt(btn.getAttribute('data-hour')!, 10);
        const timeLabel = btn.getAttribute('data-timelabel')!;
        openBookingModal(hour, timeLabel);
      });
    });

    // Abrir bloqueo administrativo
    document.querySelectorAll('.btn-open-block').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hour = parseInt(btn.getAttribute('data-hour')!, 10);
        createBlockDirect(hour);
      });
    });

    // Abrir modal de cancelación
    document.querySelectorAll('.btn-cancel-entry').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id')!;
        const patient = btn.getAttribute('data-patient')!;
        const rawVer = btn.getAttribute('data-version') || 'v1';
        const version = rawVer.startsWith('"') ? rawVer : `"${rawVer}"`;
        openCancelModal(id, patient, version);
      });
    });

    // Liberar bloqueo directamente
    document.querySelectorAll('.btn-delete-block').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const rawVer = btn.getAttribute('data-version') || 'v1';
        const version = rawVer.startsWith('"') ? rawVer : `"${rawVer}"`;
        if (!confirm('¿Liberar este horario bloqueado para permitir reservas?')) return;
        try {
          await AgendamientoClient.deleteTeamBlock(id, version, currentSession.csrfToken);
          loadSchedule();
        } catch (err: any) {
          alert('Error al liberar bloqueo: ' + err.message);
        }
      });
    });
  }

  // MODAL DE AGENDAR
  function openBookingModal(hour: number, timeLabel: string) {
    pendingSlotTime = `${activeDateString} ${timeLabel}`;
    modalBookPro.textContent = activeProfessional === 'felipe' ? 'Felipe Méndez (Box 1)' : 'Eduardo Lagos (Box 2)';
    modalBookTime.textContent = `${activeDateString}, ${timeLabel}`;
    formTeamBooking.reset();
    modalBookError.classList.add('hidden');
    modalTeamBooking.classList.remove('hidden');

    formTeamBooking.onsubmit = async (e) => {
      e.preventDefault();
      modalBookError.classList.add('hidden');

      // Calcular timestamp UTC exacto
      const parts = activeDateString.split('-');
      const y = parseInt(parts[0], 10);
      const m = parseInt(parts[1], 10);
      const day = parseInt(parts[2], 10);

      // Usar fecha UTC correspondiente
      const slotDate = new Date(Date.UTC(y, m - 1, day, hour + 3, 0, 0));
      const startAtUtc = slotDate.toISOString();
      const idempKey = 'team_bk_' + Math.random().toString(36).substring(2, 10);

      try {
        await AgendamientoClient.createTeamBooking(
          {
            professionalId: activeProfessional,
            startAt: startAtUtc,
            patient: {
              name: teamInputName.value.trim(),
              email: teamInputEmail.value.trim(),
              rut: teamInputRut.value.trim(),
              documentType: teamInputDocType.value as any,
              phone: teamInputPhone.value.trim()
            },
            consentVersion: 'v1.0'
          },
          idempKey,
          currentSession.csrfToken
        );

        modalTeamBooking.classList.add('hidden');
        loadSchedule();
      } catch (err: any) {
        modalBookError.textContent = err.message || 'Error al agendar cita.';
        modalBookError.classList.remove('hidden');
      }
    };
  }

  // CREAR BLOQUEO
  async function createBlockDirect(hour: number) {
    if (!confirm(`¿Bloquear la hora de las ${hour}:00 a ${hour + 1}:00 en la agenda de ${activeProfessional}?`)) return;

    const parts = activeDateString.split('-');
    const y = parseInt(parts[0], 10);
    const m = parseInt(parts[1], 10);
    const day = parseInt(parts[2], 10);

    const startUtc = new Date(Date.UTC(y, m - 1, day, hour + 3, 0, 0)).toISOString();
    const endUtc = new Date(Date.UTC(y, m - 1, day, hour + 4, 0, 0)).toISOString();
    const idempKey = 'blk_' + Math.random().toString(36).substring(2, 10);

    try {
      await AgendamientoClient.createTeamBlock(activeProfessional, startUtc, endUtc, idempKey, currentSession.csrfToken);
      loadSchedule();
    } catch (err: any) {
      alert('Error al crear bloqueo: ' + err.message);
    }
  }

  // MODAL DE CANCELACIÓN CON IF-MATCH
  function openCancelModal(bookingId: string, patientName: string, version: string) {
    pendingCancelBookingId = bookingId;
    pendingCancelVersion = version;
    cancelModalPatient.textContent = patientName;
    cancelModalId.textContent = bookingId;
    cancelModalVersion.textContent = version;
    cancelModalError.classList.add('hidden');
    modalCancelBooking.classList.remove('hidden');
  }

  btnConfirmCancelAction.addEventListener('click', async () => {
    if (!pendingCancelBookingId || !pendingCancelVersion) return;
    cancelModalError.classList.add('hidden');

    try {
      await AgendamientoClient.cancelTeamBooking(
        pendingCancelBookingId,
        pendingCancelVersion,
        currentSession.csrfToken
      );
      modalCancelBooking.classList.add('hidden');
      loadSchedule();
    } catch (err: any) {
      if (err instanceof ApiError && err.code === 'VERSION_CONFLICT') {
        cancelModalError.textContent = 'La cita fue modificada previamente por otro usuario. Recarga la agenda.';
      } else {
        cancelModalError.textContent = err.message || 'Error al cancelar la cita.';
      }
      cancelModalError.classList.remove('hidden');
    }
  });

  // Cerrar modales
  document.querySelectorAll('.btn-close-modal').forEach((btn) => {
    btn.addEventListener('click', () => {
      modalTeamBooking.classList.add('hidden');
      modalCancelBooking.classList.add('hidden');
    });
  });

  // LOGOUT EQUIPO
  btnTeamLogout.addEventListener('click', async () => {
    if (currentSession && currentSession.csrfToken) {
      await AgendamientoClient.logout(currentSession.csrfToken);
      window.location.reload();
    }
  });

  // BOTONES DE ESTADO NO AUTORIZADO
  if (btnGateSwitchAccount) {
    btnGateSwitchAccount.addEventListener('click', async () => {
      if (currentSession && currentSession.csrfToken) {
        try {
          await AgendamientoClient.logout(currentSession.csrfToken);
        } catch (_) {}
      }
      window.location.href = '/auth/google/start?returnTo=/agenda';
    });
  }

  if (btnGateLogout) {
    btnGateLogout.addEventListener('click', async () => {
      if (currentSession && currentSession.csrfToken) {
        try {
          await AgendamientoClient.logout(currentSession.csrfToken);
        } catch (_) {}
      }
      window.location.reload();
    });
  }

  // DEV LOGIN EQUIPO
  if (btnDevQuickTeam) {
    btnDevQuickTeam.addEventListener('click', async () => {
      try {
        await AgendamientoClient.mockLogin('team');
        window.location.reload();
      } catch (err) {
        console.error('Error al iniciar sesión de equipo:', err);
      }
    });
  }

  // Inicializar
  setDate(activeDateString);
  initTeamSession();
</script>


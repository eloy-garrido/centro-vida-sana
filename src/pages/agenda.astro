---
/**
 * Centro Vida Sana Austral — Panel Compartido del Equipo (S05 / D01 / D03 / D04 / D07 / S09)
 * Gestión de las dos agendas oficiales (Felipe y Eduardo) con control de concurrencia optimista y versión.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { clinicInfo } from '../data/clinic';
import { professionals } from '../data/professionals';
---

<BaseLayout
  title={`Panel de Agenda | ${clinicInfo.name}`}
  description="Panel interno de gestión de agendas y atenciones clínicas de Centro Vida Sana Austral."
  noindex={true}
>
  <div class="min-h-screen flex flex-col bg-[#F8F9F6]">
    <!-- Barra Superior Minimalista de Gestión Clínica (Distraction-free) -->
    <header class="bg-white border-b border-slate-200/90 sticky top-0 z-30 shadow-xs shrink-0">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group transition-opacity hover:opacity-85" aria-label="Volver al inicio">
          <img
            src="/pix/logo-sin-texto-96.webp"
            alt="Centro Vida Sana Logo"
            class="w-8 h-8 rounded-full object-cover shadow-xs border border-slate-100"
          />
          <div class="flex items-center gap-2">
            <span class="font-serif font-bold text-base sm:text-lg text-slate-900 tracking-tight">
              Centro Vida Sana
            </span>
            <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
              Panel Clínico
            </span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <a
            href="/reservar"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition-colors py-1.5 px-3 rounded-lg"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Pasarela Pacientes</span>
          </a>

          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors py-1.5 px-3 rounded-lg hover:bg-slate-100/70"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            <span>Volver al sitio web</span>
          </a>
        </div>
      </div>
    </header>

    <div class="flex-1 py-8 sm:py-10 px-4 sm:px-6 lg:px-8 flex flex-col justify-between">
    <div class="max-w-6xl mx-auto w-full">

      <!-- Encabezado del Panel -->
      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 pb-6 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-semibold bg-slate-900 text-white tracking-wide uppercase">
              Panel Clínico
            </span>
            <span class="text-xs text-slate-500 font-medium">Zona Horaria: America/Santiago</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-serif text-[#151C17] tracking-tight">
            Gestión de Agendas
          </h1>
        </div>

        <!-- Perfil / Sesión Equipo -->
        <div id="team-session-box" class="flex items-center gap-3 bg-white px-4 py-2.5 rounded-xl border border-slate-200 shadow-sm">
          <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs" id="team-user-avatar">
            E
          </div>
          <div class="text-left">
            <p id="team-user-name" class="text-xs font-semibold text-slate-900">Equipo Vida Sana</p>
            <p id="team-user-email" class="text-[11px] text-slate-500">centrovida.sanaaustral@gmail.com</p>
          </div>
          <button
            type="button"
            id="btn-team-logout"
            class="ml-2 text-xs text-slate-400 hover:text-red-700 hover:underline transition-colors"
          >
            Salir
          </button>
        </div>
      </header>

      <!-- Pantalla de Login Requerido si no es equipo -->
      <div id="team-login-gate" class="hidden bg-white rounded-2xl p-6 sm:p-10 shadow-sm border border-slate-200 text-center max-w-lg mx-auto my-12 animate-fade-in">
        
        <!-- Estado 1: Anónimo / Sin Sesión Iniciada -->
        <div id="gate-anonymous" class="space-y-4">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-800 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h2 class="text-xl font-serif text-slate-900 font-medium mb-1">Acceso Exclusivo del Equipo</h2>
          <p class="text-xs text-slate-600 mb-6 leading-relaxed">
            Esta sección está reservada para los profesionales y el administrador de Centro Vida Sana Austral.
          </p>
          <div class="space-y-3">
            <a
              href="/auth/google/start?returnTo=/agenda"
              class="w-full inline-flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9z"/>
                <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z"/>
              </svg>
              <span>Identificarse con Cuenta de Equipo</span>
            </a>
            <!-- Atajo para entorno local -->
            <button
              type="button"
              id="btn-dev-quick-team"
              class="w-full py-2.5 px-4 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-300 transition-colors"
            >
              ⚡ Acceso Rápido de Prueba (Administrador / Equipo)
            </button>
          </div>
        </div>

        <!-- Estado 2: Autenticado pero Sin Permisos de Equipo (No registrado en team_members) -->
        <div id="gate-forbidden" class="hidden space-y-4">
          <div class="w-14 h-14 rounded-full bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center mx-auto mb-2">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            Acceso No Autorizado
          </span>

          <h2 class="text-xl font-serif text-slate-900 font-medium">Cuenta sin Permisos de Equipo</h2>

          <!-- Tarjeta con la cuenta activa del usuario -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 text-left flex items-center gap-3 my-4">
            <div id="gate-user-avatar" class="w-9 h-9 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shrink-0">
              U
            </div>
            <div class="min-w-0 flex-1">
              <p id="gate-user-name" class="text-xs font-bold text-slate-900 truncate">Usuario</p>
              <p id="gate-user-email" class="text-[11px] text-slate-500 font-mono truncate">correo@gmail.com</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-200 text-slate-700 shrink-0">
              Rol: Paciente
            </span>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed">
            Iniciaste sesión con Google, pero este correo no está registrado como profesional de salud ni como administrador de Centro Vida Sana.
          </p>

          <div class="space-y-2.5 pt-2">
            <button
              type="button"
              id="btn-gate-switch-account"
              class="w-full inline-flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5.1 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9z"/>
                <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z"/>
              </svg>
              <span>Cambiar a Cuenta de Equipo</span>
            </button>

            <div class="flex gap-2">
              <button
                type="button"
                id="btn-gate-logout"
                class="flex-1 py-2.5 px-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors"
              >
                Cerrar Sesión
              </button>
              <a
                href="/reservar"
                class="flex-1 inline-flex items-center justify-center py-2.5 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold border border-emerald-200 transition-colors"
              >
                Ir a Reservas Paciente
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- CONTENEDOR PRINCIPAL DEL PANEL -->
      <div id="team-app-content" class="space-y-6">

        <!-- Selector de Pestañas Superiores (S05: Felipe Méndez y Eduardo Lagos) -->
        <div class="bg-white rounded-2xl p-2 shadow-sm border border-slate-200 flex flex-col sm:flex-row gap-2">
          <!-- Pestaña Felipe -->
          <button
            type="button"
            id="tab-felipe"
            class="flex-1 flex items-center justify-center gap-3 py-3 px-4 rounded-xl text-sm font-semibold transition-all select-none border-2 border-slate-900 bg-slate-900 text-white shadow-sm"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
            <span>Felipe Méndez (Box 1 · Quiropraxia)</span>
          </button>

          <!-- Pestaña Eduardo -->
          <button
            type="button"
            id="tab-eduardo"
            class="flex-1 flex items-center justify-center gap-3 py-3 px-4 rounded-xl text-sm font-semibold transition-all select-none border-2 border-transparent text-slate-700 hover:bg-slate-100"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span>Eduardo Lagos (Box 2 · Acupuntura)</span>
          </button>
        </div>

        <!-- Barra de Controles de Fecha (D04: Hoy y dentro del mes) -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <button
              type="button"
              id="btn-prev-day"
              class="p-2 sm:p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 active:scale-95 text-slate-700 transition-all shadow-xs"
              title="Día anterior"
              aria-label="Día anterior"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>

            <input
              type="date"
              id="input-date-picker"
              class="px-3.5 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm text-slate-800 font-semibold focus:ring-2 focus:ring-slate-900 focus:border-slate-900 bg-white shadow-xs transition-colors cursor-pointer"
            />

            <button
              type="button"
              id="btn-next-day"
              class="p-2 sm:p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 active:scale-95 text-slate-700 transition-all shadow-xs"
              title="Día siguiente"
              aria-label="Día siguiente"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <div class="text-right">
            <p id="schedule-active-date-label" class="text-sm font-serif text-slate-900 font-bold capitalize">
              Cargando fecha...
            </p>
            <p class="text-[11px] text-slate-500 font-medium">11 turnos disponibles de 60 minutos</p>
          </div>
        </div>

        <!-- Tabla / Timeline de Horarios del Día -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-base font-serif text-slate-900 font-medium">Jornada de Atención</h2>
            <div class="flex items-center gap-3 text-xs">
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Disponible
              </span>
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span> Cita
              </span>
              <span class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Bloqueo
              </span>
            </div>
          </div>

          <!-- Loading State -->
          <div id="schedule-loading" class="p-8 text-center text-slate-400 text-xs">
            <svg class="animate-spin w-6 h-6 text-slate-800 mx-auto mb-2" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Consultando agenda oficial en D1...
          </div>

          <!-- Filas de Horario -->
          <div id="schedule-slots-container" class="divide-y divide-slate-100">
            <!-- Se llena dinámicamente con JS -->
          </div>
        </section>

      </div>

      <!-- MODAL 1: AGENDAR PACIENTE MANUALMENTE (EQUIPO) -->
      <div id="modal-team-booking" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl border border-slate-200 animate-fade-in">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
            <h3 class="font-serif text-lg text-slate-900 font-medium">Agendar Cita Manual</h3>
            <button type="button" class="btn-close-modal text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
          </div>
          <form id="form-team-booking" class="space-y-4">
            <div class="p-3 bg-slate-50 rounded-xl text-xs space-y-1">
              <p><span class="text-slate-500">Profesional:</span> <span id="modal-book-pro" class="font-semibold text-slate-800"></span></p>
              <p><span class="text-slate-500">Horario:</span> <span id="modal-book-time" class="font-semibold text-slate-800"></span></p>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Nombre Completo *</label>
              <input type="text" id="team-input-name" required placeholder="Nombre del paciente" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div class="col-span-1">
                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Tipo</label>
                <select id="team-input-doc-type" class="w-full px-2 py-2 rounded-xl border border-slate-300 text-xs">
                  <option value="rut">RUT</option>
                  <option value="passport">Pasaporte</option>
                </select>
              </div>
              <div class="col-span-2">
                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">RUT / Documento *</label>
                <input type="text" id="team-input-rut" required placeholder="12.345.678-5" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Correo de Contacto *</label>
                <input type="email" id="team-input-email" required placeholder="ejemplo@correo.cl" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Teléfono Móvil *</label>
                <input type="tel" id="team-input-phone" required placeholder="+56 9 1234 5678" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
              </div>
            </div>
            <p id="modal-book-error" class="hidden text-xs text-red-600 font-medium"></p>
            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
              <button type="button" class="btn-close-modal px-4 py-2 rounded-xl border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-50">Cancelar</button>
              <button type="submit" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold">Confirmar Cita</button>
            </div>
          </form>
        </div>
      </div>

      <!-- MODAL 2: CONFIRMAR CANCELACIÓN CON IF-MATCH (S05 / D07) -->
      <div id="modal-cancel-booking" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200 animate-fade-in">
          <div class="flex items-center gap-3 text-red-600 mb-3">
            <div class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <h3 class="font-serif text-lg text-slate-900 font-medium">Cancelar Cita Agendada</h3>
          </div>
          <p class="text-xs text-slate-600 mb-4 leading-relaxed">
            ¿Confirmas la cancelación de la cita de <strong id="cancel-modal-patient"></strong>? El horario quedará liberado inmediatamente para los pacientes. Se conservará el registro con estado <code class="bg-slate-100 px-1 py-0.5 rounded text-[11px]">cancelled</code> para auditoría.
          </p>
          <div class="p-3 bg-slate-50 rounded-xl text-xs space-y-1 mb-4">
            <p><span class="text-slate-500">ID de Cita:</span> <span id="cancel-modal-id" class="font-mono font-bold"></span></p>
            <p><span class="text-slate-500">Versión actual:</span> <span id="cancel-modal-version" class="font-mono"></span></p>
          </div>
          <p id="cancel-modal-error" class="hidden text-xs text-red-600 font-medium mb-3"></p>
          <div class="flex justify-end gap-2">
            <button type="button" class="btn-close-modal px-4 py-2 rounded-xl border border-slate-200 text-xs font-medium text-slate-600 hover:bg-slate-50">Conservar cita</button>
            <button type="button" id="btn-confirm-cancel-action" class="px-5 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold">Sí, Cancelar Cita</button>
          </div>
        </div>
      </div>

      <!-- Pie de página discreto y minimalista -->
      <footer class="mt-16 text-center text-xs text-slate-400 border-t border-slate-200/60 pt-6">
        <p class="font-medium text-slate-500">Centro Vida Sana Austral · Gestión de Agendas Clínicas</p>
        <p class="text-[11px] text-slate-400 mt-1">Uso exclusivo para profesionales y equipo administrativo · Los Armiños 1620, Temuco</p>
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  import { AgendamientoClient, ApiError } from '../lib/agendamiento/client.ts';
  import { formatChileanRut, validateChileanRut, buildWhatsAppLink } from '../lib/agendamiento/validation.ts';

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  let currentSession: any = null;
  let activeProfessional: 'felipe' | 'eduardo' = 'felipe';
  let activeDateString = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Santiago' });
  let currentScheduleData: any = null;


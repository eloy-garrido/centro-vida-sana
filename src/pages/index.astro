---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import HeroDual from '../components/home/HeroDual.astro';
import IntroContent from '../components/home/IntroContent.astro';
import DualProfessionals from '../components/home/DualProfessionals.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import PathologiesGuide from '../components/home/PathologiesGuide.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import ReviewsSection from '../components/home/ReviewsSection.astro';
import StudyBanner from '../components/home/StudyBanner.astro';
import ScrollReveal from '../components/common/ScrollReveal.astro';
---

<BaseLayout>
  <Navbar slot="navbar" />

  <!-- Hero Principal -->
  <HeroDual />

  <!-- Sección de Introducción Continua con Fondo Verde Pasto -->
  <IntroContent />

  <!-- Tarjetas Clínicas de Profesionales -->
  <DualProfessionals />

  <!-- Directorio de Servicios con Filtrado por Especialista -->
  <ServicesOverview />

  <!-- Guía de Dolencias y Síntomas -->
  <PathologiesGuide />

  <!-- Preguntas Frecuentes Visibles (Sincronizadas con SEO Schema) -->
  <FaqAccordion />

  <!-- Academia y Formación de Medicina China -->
  <StudyBanner />

  <!-- Reseñas y Prueba Social Verificada de Google -->
  <ReviewsSection />

  <!-- Botón Flotante con Selección de Especialista -->
  <FloatingWhatsApp />

  <!-- Sistema de Animaciones de Entrada (Cinemática Editorial Emil Kowalski) -->
  <ScrollReveal />

  <Footer slot="footer" />
</BaseLayout>

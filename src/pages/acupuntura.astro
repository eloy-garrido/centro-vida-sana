---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import ScrollReveal from '../components/common/ScrollReveal.astro';
import { professionals } from '../data/professionals';
import { clinicInfo } from '../data/clinic';
import { servicesData } from '../data/services';

const eduardo = professionals.eduardo;
const acupServices = servicesData.filter(s => s.discipline === 'acupuntura');

// FAQs específicas de Acupuntura y Medicina Tradicional China
const acupFaqs = [
  {
    id: 'acup-dolor',
    q: '¿Es dolorosa la colocación de las agujas de acupuntura?',
    a: 'En absoluto. Empleamos agujas de grado médico ultrafinas y flexibles (calibre 0.16 a 0.25 mm, comparables al grosor de un cabello), muy distintas a las agujas de inyección hipodérmica. El paciente siente apenas un contacto sutil inicial y luego una agradable sensación de peso, calor o relajación profunda (conocida como sensación De Qi).',
    category: 'acupuntura' as const,
    badge: 'Procedimiento'
  },
  {
    id: 'acup-esteriles',
    q: '¿Las agujas son estériles y desechables?',
    a: 'Sí, 100%. Cada aguja viene sellada de fábrica en blíster individual estéril, se abre en presencia del paciente y tras su uso se descarta de inmediato en un contenedor biológico para punzocortantes, cumpliendo con la estricta normativa sanitaria del Minsal.',
    category: 'acupuntura' as const,
    badge: 'Seguridad'
  },
  {
    id: 'acup-sesiones',
    q: '¿Cuántas sesiones se recomiendan para ver resultados?',
    a: 'Para afecciones agudas (dolores musculares recientes, crisis de ansiedad o contracturas), el alivio se percibe frecuentemente desde la primera sesión. En condiciones crónicas como fibromialgia, migrañas rebeldes o artrosis, se suele estructurar un ciclo de 4 a 8 sesiones con espaciamiento progresivo según la evolución clínica.',
    category: 'acupuntura' as const,
    badge: 'Tratamiento'
  },
  {
    id: 'acup-electro',
    q: '¿Qué es y para qué sirve la electroacupuntura?',
    a: 'Es una evolución moderna de la acupuntura tradicional en la que se conecta un microestimulador eléctrico de baja frecuencia a las agujas. Esta microcorriente controlada estimula la liberación masiva de endorfinas y bloquea las vías del dolor en la médula espinal, siendo especialmente efectiva para ciática severa, neuralgias y parálisis facial.',
    category: 'acupuntura' as const,
    badge: 'Técnica'
  },
  {
    id: 'acup-medicamentos',
    q: '¿Puedo atenderme con acupuntura si estoy tomando medicamentos?',
    a: 'Sí. La acupuntura no interfiere con fármacos ni produce interacciones químicas, ya que actúa estimulando los mecanismos propios de autorregulación del sistema neuroinmune. Es un excelente complemento a tratamientos médicos convencionales.',
    category: 'acupuntura' as const,
    badge: 'Compatibilidad'
  },
  {
    id: 'acup-minsal',
    q: '¿Eduardo Lagos cuenta con acreditación oficial del Minsal?',
    a: 'Sí. Eduardo Lagos es Acupunturista Certificado por el Ministerio de Salud de Chile (Minsal), lo que garantiza práctica clínica segura, respaldada y con los más altos estándares éticos.',
    category: 'acupuntura' as const,
    badge: 'Acreditación'
  }
];

// Schema estructurado SEO específico para Acupuntura
const acupSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalClinic", "LocalBusiness"],
      "@id": "https://centrovidasana.cl/acupuntura#clinic",
      "name": "Consulta de Acupuntura y Medicina China - Centro Vida Sana Austral",
      "url": "https://centrovidasana.cl/acupuntura",
      "description": "Sesiones de Acupuntura Clínica y Medicina Tradicional China en Temuco con Eduardo Lagos (Certificado Minsal). Alivio de dolor crónico, fibromialgia, migrañas, estrés y ventosas.",
      "telephone": eduardo.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": clinicInfo.address.street,
        "addressLocality": clinicInfo.address.city,
        "addressRegion": clinicInfo.address.region,
        "postalCode": clinicInfo.address.postalCode,
        "addressCountry": "CL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": clinicInfo.coordinates.latitude,
        "longitude": clinicInfo.coordinates.longitude
      },
      "priceRange": "$20.000 - $30.000 CLP"
    },
    {
      "@type": "Person",
      "@id": "https://centrovidasana.cl/#eduardo",
      "name": eduardo.name,
      "jobTitle": "Acupunturista Clínico Certificado por Minsal",
      "telephone": eduardo.phone,
      "description": "Acupunturista clínico acreditado por Minsal y docente de Medicina Tradicional China en Temuco."
    },
    {
      "@type": "FAQPage",
      "@id": "https://centrovidasana.cl/acupuntura#faq",
      "mainEntity": acupFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};

// Condiciones clínicas tratadas con Acupuntura y MTC
const acupConditions = [
  {
    title: 'Fibromialgia y Dolor Crónico',
    region: 'Sistema Nervioso Central',
    desc: 'Modulación del umbral del dolor y reducción de la hipersensibilidad central, aliviando la fatiga persistente y los puntos dolorosos en todo el cuerpo.',
    tags: ['Fatiga persistente', 'Tender points', 'Regulación neuroinmune'],
    icon: 'fibromyalgia',
    whatsappText: 'Hola Eduardo, quisiera consultar por tratamiento de Acupuntura para Fibromialgia y Dolor Crónico.'
  },
  {
    title: 'Migrañas y Cefaleas Rebeldes',
    region: 'Cráneo & Circulación Vascular',
    desc: 'Descompresión vascular y regulación del Qi hepático para reducir drásticamente la frecuencia, intensidad y necesidad de analgésicos en jaquecas.',
    tags: ['Jaquecas pulsátiles', 'Tensión retroocular', 'Menos analgésicos'],
    icon: 'migraine',
    whatsappText: 'Hola Eduardo, quisiera consultar por tratamiento de Acupuntura para Migrañas y Cefaleas.'
  },
  {
    title: 'Estrés Agudo, Ansiedad e Insomnio',
    region: 'Eje Neurovegetativo (Shen)',
    desc: 'Estimulación del sistema parasimpático para reducir el cortisol circulante, inducir sueño profundo reparador y devolver la calma mental.',
    tags: ['Insomnio y despertares', 'Baja de cortisol', 'Calma del Shen'],
    icon: 'anxiety',
    whatsappText: 'Hola Eduardo, quisiera consultar por sesiones de Acupuntura para Estrés, Ansiedad o Insomnio.'
  },
  {
    title: 'Ciática y Lumbago con Electroacupuntura',
    region: 'Columna Lumbar & Trayecto Nervioso',
    desc: 'Microcorrientes terapéuticas aplicadas a través de agujas que desinflaman el trayecto nervioso y alivian el dolor y quemazón profundo.',
    tags: ['Electroacupuntura', 'Desinflamación profunda', 'Dolor irradiado'],
    icon: 'electro',
    whatsappText: 'Hola Eduardo, quisiera consultar por Electroacupuntura para Dolor Lumbar y Ciática.'
  },
  {
    title: 'Artrosis y Dolor por Frío con Moxibustión',
    region: 'Articulaciones & Calor Terapéutico',
    desc: 'Terapia térmica con artemisa medicinal para activar la circulación local, disipar la rigidez articular y aliviar molestias en rodillas y manos.',
    tags: ['Moxibustión herbal', 'Rigidez articular', 'Rodillas, caderas y manos'],
    icon: 'moxa',
    whatsappText: 'Hola Eduardo, quisiera consultar por Moxibustión y Acupuntura para Artrosis y rigidez articular.'
  },
  {
    title: 'Bruxismo y Tensión Mandibular (ATM)',
    region: 'Músculos Maseteros & ATM',
    desc: 'Relajación profunda de los músculos maseteros y pterigoideos, disminuyendo el dolor facial, la sobrecarga cervical y el desgaste dental.',
    tags: ['Apretar de dientes', 'Tensión facial', 'Sobrecarga cervical'],
    icon: 'atm',
    whatsappText: 'Hola Eduardo, quisiera consultar por Acupuntura para Bruxismo y tensión de mandíbula.'
  }
];
---

<BaseLayout
  title="Acupuntura y Medicina China en Temuco | Eduardo Lagos (Minsal) | Vida Sana"
  description="Sesiones de Acupuntura y Medicina Tradicional China en Temuco con Eduardo Lagos (Certificado Minsal). Dolor crónico, fibromialgia, estrés, migrañas y ventosas en box privado."
  canonicalUrl="https://centrovidasana.cl/acupuntura"
  customSchema={acupSchema}
>
  <Navbar slot="navbar" activePage="acupuntura" />

  <!-- =========================================================================
       HERO DE ACUPUNTURA
       ========================================================================= -->
  <section class="pt-28 pb-16 lg:pt-36 lg:pb-24 bg-gradient-to-b from-[#EFF6F1] via-[#F6FAF7] to-[#FBFDFB] text-[#152219] relative overflow-hidden border-b border-[#CCDED1]">
    
    <!-- Glow y formas orgánicas botánicas -->
    <div class="absolute -top-32 -left-32 w-[550px] h-[550px] bg-[#2E4D38]/[0.08] rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/2 right-[-10%] w-[500px] h-[500px] bg-[#497356]/[0.06] rounded-full blur-[130px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#556D55] mb-6 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#2E4D38] transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-[#2E4D38] font-bold">Acupuntura &amp; Medicina China</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">

        <!-- Lado Texto -->
        <div class="lg:col-span-6 space-y-6 text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E5F2E8] border border-[#BFDFCA] text-[#2E4D38] text-xs font-bold uppercase tracking-wider shadow-sm" data-reveal>
            <span class="w-2 h-2 rounded-full bg-[#2E4D38] animate-pulse"></span>
            <span>Acreditado Oficial Minsal · Box Climatizado</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-[#15281D] tracking-tight leading-[1.12]" data-reveal data-reveal-delay="80">
            Acupuntura y Medicina China en <span class="text-[#2E4D38]">Temuco</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3E523E] leading-relaxed max-w-2xl" data-reveal data-reveal-delay="140">
            Regulación del sistema nervioso, alivio profundo del dolor crónico y equilibrio bioenergético a través de neuroacupuntura, ventosas clínicas y moxibustión tradicional.
          </p>

          <!-- CTAs y Garantías -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2" data-reveal data-reveal-delay="200">
            <a
              href="/reservar?pro=eduardo"
              class="btn-press inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-[#2E4D38] hover:bg-[#233C2C] text-white text-sm sm:text-base font-bold shadow-soft hover:shadow-[0_10px_30px_rgba(46,77,56,0.3)] transition-all cursor-pointer"
            >
              <svg class="w-5 h-5 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span>Reservar Hora con Eduardo</span>
            </a>
            <a
              href={`https://wa.me/56973888910?text=${encodeURIComponent('Hola Eduardo, me interesa agendar una sesión de Acupuntura y Medicina China en Temuco.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-white border border-[#BFDFCA] text-xs sm:text-sm font-bold text-[#2E4D38] hover:bg-[#EEF5F0] transition-colors"
            >
              <svg class="w-4 h-4 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>WhatsApp</span>
            </a>
            <a
              href="#servicios-acupuntura"
              class="inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-white border border-[#BFDFCA] text-xs sm:text-sm font-bold text-[#2E4D38] hover:bg-[#EEF5F0] transition-colors"
            >
              <span>Ver Terapias y Tarifas</span>
              <span>↓</span>
            </a>
          </div>

          <!-- Píldoras de Calidad -->
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-[#44594A] pt-2" data-reveal data-reveal-delay="260">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              Atención personalizada 1 a 1
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              Agujas estériles desechables
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Registro oficial Minsal
            </span>
          </div>

        </div>

        <!-- Lado Visual (Retrato con Blob Ampliado) -->
        <div class="lg:col-span-6 relative flex items-center justify-center lg:justify-end" data-reveal="scale" data-reveal-delay="100">
          <div class="relative w-full max-w-[500px] sm:max-w-[560px] lg:max-w-[620px] xl:max-w-[680px] flex items-end justify-center pt-4 pb-2">
            
            <!-- Blob de Fondo Botánico -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
              <div class="w-[380px] sm:w-[460px] lg:w-[520px] xl:w-[580px] h-[380px] sm:h-[460px] lg:h-[520px] xl:h-[580px] bg-[#2E4D38]/20 rounded-full blur-3xl"></div>
              <svg viewBox="0 0 500 500" class="w-[360px] sm:w-[450px] lg:w-[520px] xl:w-[570px] h-[360px] sm:h-[450px] lg:h-[520px] xl:h-[570px] filter drop-shadow-[0_18px_36px_rgba(46,77,56,0.28)]" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="blob-acup-hero" x1="10%" y1="10%" x2="90%" y2="90%">
                    <stop offset="0%" stop-color="#BEE0C7" />
                    <stop offset="50%" stop-color="#76B084" />
                    <stop offset="100%" stop-color="#2E4D38" />
                  </linearGradient>
                </defs>
                <path d="M410,305Q370,360,314,405Q258,450,199,416Q140,382,95,326Q50,270,82,203Q114,136,174,93Q234,50,306,75Q378,100,414,175Q450,250,410,305Z" fill="url(#blob-acup-hero)" />
              </svg>
            </div>

            <!-- Foto de Eduardo HD Ampliada -->
            <img
              src="/pix/eduardo-acupuntura-hd.webp"
              srcset="/pix/eduardo-acupuntura-hd.webp 2x, /pix/eduardo-acupuntura.webp 1x"
              alt="Eduardo Lagos, Acupunturista en Temuco"
              class="relative z-10 w-full max-w-[420px] sm:max-w-[500px] lg:max-w-[560px] xl:max-w-[620px] max-h-[520px] sm:max-h-[580px] lg:max-h-[640px] xl:max-h-[700px] object-contain drop-shadow-[0_22px_45px_rgba(15,35,20,0.30)] [mask-image:linear-gradient(to_bottom,black_92%,transparent_100%)] transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
              fetchpriority="high"
              width="881"
              height="800"
            />

            <!-- Chip Registro Minsal Enriquecido -->
            <div class="absolute bottom-1 sm:bottom-3 left-1 sm:left-3 lg:-left-2 xl:-left-4 p-3 sm:p-3.5 rounded-2xl bg-white/95 border border-[#BFDFCA] backdrop-blur-md shadow-[0_14px_32px_rgba(46,77,56,0.20)] flex items-center gap-3 z-20">
              <div class="w-10 h-10 rounded-xl bg-[#2E4D38] text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              </div>
              <div class="text-left pr-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-bold text-[#15281D] block leading-tight">Eduardo Lagos</span>
                  <span class="text-[10px] font-semibold text-[#2E4D38] bg-[#EEF5F0] px-1.5 py-0.5 rounded">Minsal</span>
                </div>
                <span class="text-[11px] text-[#556D55] block leading-tight">Acupuntura &amp; Med. China</span>
                <a href="#enfoque-clinico" class="text-[11px] font-bold text-[#2E4D38] hover:underline inline-flex items-center gap-1 pt-0.5">
                  <span>Ver modelo clínico y respaldo ↓</span>
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- =========================================================================
       MODELO CLÍNICO INTEGRATIVO & RESPALDO PROFESIONAL (EDUARDO LAGOS)
       ========================================================================= -->
  <section id="enfoque-clinico" class="py-16 sm:py-24 bg-[#FBFDFB] border-b border-[#DCE8DE] relative overflow-hidden scroll-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Cabecera -->
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EEF5F0] border border-[#CCE2D2] text-[#2E4D38] text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
          <span>Enfoque Terapéutico · Eduardo Lagos</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#15281D] tracking-tight mb-4">
          Modelo Integrativo de Acupuntura &amp; Medicina China
        </h2>
        <p class="text-base sm:text-lg text-[#556D55] leading-relaxed">
          Semiología tradicional oriental, regulación del sistema nervioso y estimulación neurobiológica del dolor crónico.
        </p>
      </div>

      <!-- Tarjeta Editorial con el Fundamento Clínico -->
      <div class="max-w-4xl mx-auto mb-14" data-reveal="scale">
        <div class="p-2 sm:p-2.5 rounded-[2rem] bg-gradient-to-br from-[#E4EFE7] via-white to-[#D5E8D9] ring-1 ring-[#CCE2D2]/60 shadow-[0_12px_40px_rgba(46,77,56,0.08)]">
          <div class="p-7 sm:p-10 lg:p-12 rounded-[calc(2rem-0.625rem)] bg-white relative overflow-hidden">
            <span class="absolute top-4 right-8 font-serif text-8xl sm:text-9xl text-[#2E4D38]/[0.07] pointer-events-none select-none">“</span>
            
            <div class="relative z-10 space-y-5">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-1 rounded-full bg-[#2E4D38]"></span>
                <span class="text-xs font-bold tracking-widest uppercase text-[#556D55]">Fundamento Terapéutico</span>
              </div>

              <blockquote class="text-base sm:text-lg text-[#233829] leading-relaxed italic">
                "{eduardo.approachQuote}"
              </blockquote>

              <div class="pt-4 border-t border-[#EAF2EC] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="font-serif text-base sm:text-lg font-bold text-[#15281D] block">{eduardo.fullName}</span>
                  <span class="text-xs text-[#556D55] block">{eduardo.title} · Centro Vida Sana Austral</span>
                </div>
                <!-- Respaldo Clínico Sintético -->
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EFF5F0] text-[#2E4D38] border border-[#D3E3D6]">
                    Acreditado Minsal
                  </span>
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EFF5F0] text-[#2E4D38] border border-[#D3E3D6]">
                    SIS Nº 381042
                  </span>
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EFF5F0] text-[#2E4D38] border border-[#D3E3D6]">
                    Docente de MTC
                  </span>
                </div>
              </div>

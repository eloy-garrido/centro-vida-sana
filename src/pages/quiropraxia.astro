---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import { professionals } from '../data/professionals';
import { clinicInfo } from '../data/clinic';
import { servicesData } from '../data/services';
import { faqsData } from '../data/faqs';

const felipe = professionals.felipe;
const quiroServices = servicesData.filter(s => s.discipline === 'quiropraxia');

// FAQs específicas de Quiropraxia y Kinesiología
const quiroFaqs = [
  {
    id: 'quiro-dolor',
    q: '¿El ajuste quiropráctico es doloroso?',
    a: 'No. Los ajustes articulares son maniobras de alta velocidad y baja amplitud extremadamente controladas. El paciente suele sentir una liberación inmediata de tensión o presión en la zona tratada. Antes de cualquier maniobra, se realiza una evaluación previa y palpación muscular para garantizar que el procedimiento sea 100% seguro y cómodo.',
    category: 'quiropraxia' as const,
    badge: 'Procedimiento'
  },
  {
    id: 'quiro-crujido',
    q: '¿Qué es ese "crujido" que se escucha al ajustar?',
    a: 'Es un fenómeno físico inofensivo conocido como cavitación: al abrir suavemente la carilla articular, la presión dentro del líquido sinovial disminuye y se liberan microburbujas de gas (nitrógeno y dióxido de carbono). No es roce de huesos ni daño tisular.',
    category: 'quiropraxia' as const,
    badge: 'Fisiología'
  },
  {
    id: 'quiro-sesiones',
    q: '¿Cuántas sesiones de quiropraxia necesitaré para recuperarme?',
    a: 'En cuadros agudos como tortícolis o un lumbago reciente, la gran mayoría de nuestros pacientes experimenta un alivio notable entre la 1ª y 2ª sesión. En afecciones crónicas (discopatías de años, artrosis avanzada), se estructuran planes de 4 a 6 sesiones con pautas de ejercicio para evitar recaídas.',
    category: 'quiropraxia' as const,
    badge: 'Tratamiento'
  },
  {
    id: 'quiro-hernia',
    q: '¿Puedo atenderme si tengo hernia discal o protusiones?',
    a: 'Sí, absolutamente. La quiropraxia y la kinesiología moderna cuentan con técnicas descompresivas y maniobras sin rotación forzada que reducen la carga sobre el disco intervertebral, desinflaman la raíz nerviosa y ayudan a reabsorber el edema radicular.',
    category: 'quiropraxia' as const,
    badge: 'Seguridad'
  },
  {
    id: 'quiro-diferencia',
    q: '¿Cuál es la diferencia entre quiropraxia y kinesiología?',
    a: 'La Quiropraxia se especializa en la alineación articular de la columna y la liberación de interferencias del sistema nervioso. La Kinesiología se enfoca en la rehabilitación muscular, control motor y fortalecimiento. En Centro Vida Sana Austral, Felipe Méndez integra ambas en una misma sesión para un tratamiento verdaderamente completo.',
    category: 'quiropraxia' as const,
    badge: 'Especialidad'
  },
  {
    id: 'quiro-orden',
    q: '¿Necesito orden médica previa para atenderme?',
    a: 'No es obligatoria. Puedes agendar tu consulta directamente con Felipe Méndez. En la primera sesión se realiza una evaluación biomecánica y clínica exhaustiva para diseñar tu plan de tratamiento personalizado.',
    category: 'quiropraxia' as const,
    badge: 'Requisitos'
  }
];

// Schema estructurado SEO específico para Quiropraxia
const quiroSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalClinic", "LocalBusiness"],
      "@id": "https://centrovidasana.cl/quiropraxia#clinic",
      "name": "Consulta de Quiropraxia y Kinesiología - Centro Vida Sana Austral",
      "url": "https://centrovidasana.cl/quiropraxia",
      "description": "Atención quiropráctica y kinesiológica clínica en Temuco con Felipe Méndez. Especialistas en columna, ajuste articular, lumbago, ciática y rehabilitación motora.",
      "telephone": felipe.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": clinicInfo.address.street,
        "addressLocality": clinicInfo.address.city,
        "addressRegion": clinicInfo.address.region,
        "postalCode": clinicInfo.address.postalCode,
        "addressCountry": "CL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": clinicInfo.coordinates.latitude,
        "longitude": clinicInfo.coordinates.longitude
      },
      "priceRange": "$25.000 - $35.000 CLP"
    },
    {
      "@type": "Person",
      "@id": "https://centrovidasana.cl/#felipe",
      "name": felipe.name,
      "jobTitle": "Quiropráctico Clínico y Kinesiólogo",
      "telephone": felipe.phone,
      "description": "Kinesiólogo y Quiropráctico clínico en Temuco, especialista en columna vertebral y evaluación biomecánica."
    },
    {
      "@type": "FAQPage",
      "@id": "https://centrovidasana.cl/quiropraxia#faq",
      "mainEntity": quiroFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};

// Condiciones musculoesqueléticas tratadas con Quiropraxia
const quiroConditions = [
  {
    title: 'Lumbago y Dolor Lumbar Crónico',
    region: 'Columna Lumbar & Sacro',
    badge: 'Causa Frecuente',
    desc: 'Punzadas en la espalda baja, rigidez matinal e incapacidad para agacharse debido a bloqueos sacroilíacos o facetas articulares comprimidas.',
    tags: ['Rigidez matinal', 'Bloqueo sacroilíaco', 'Dolor al agacharse'],
    icon: 'spine',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación quiropráctica para Lumbago y Dolor Lumbar Crónico.'
  },
  {
    title: 'Ciática y Dolor Irradiado',
    region: 'Raíces Nerviosas L4-S1',
    badge: 'Dolor Radicular',
    desc: 'Dolor punzante o quemazón que viaja desde el glúteo hacia la pierna o pie, provocado por compresión o pinzamiento de las raíces nerviosas lumbares.',
    tags: ['Dolor irradiado', 'Hormigueo en pierna', 'Compresión radicular'],
    icon: 'nerve',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación quiropráctica para Ciática y Dolor Irradiado.'
  },
  {
    title: 'Cervicalgia y Tortícolis',
    region: 'Columna Cervical & Cuello',
    badge: 'Sobrecarga Postural',
    desc: 'Sobrecarga en cuello y trapecios, pérdida de rotación de la cabeza y cefaleas tensionales provocadas por desalineaciones y pantallas.',
    tags: ['Rigidez de cuello', 'Cefaleas tensionales', 'Movilidad reducida'],
    icon: 'neck',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación quiropráctica para Cervicalgia y Tortícolis.'
  },
  {
    title: 'Hernias Discales y Protrusiones',
    region: 'Discos Intervertebrales',
    badge: 'Técnicas Suaves',
    desc: 'Técnicas de descompresión vertebral suave y tracción que alivian la presión mecánica sobre el disco sin cirugía ni maniobras violentas.',
    tags: ['Descompresión manual', 'Sin cirugía', 'Protección discal'],
    icon: 'disc',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación quiropráctica para Hernias Discales y Protrusiones.'
  },
  {
    title: 'Lesiones Deportivas y Esguinces',
    region: 'Extremidades & Articulaciones',
    badge: 'Rehabilitación Activa',
    desc: 'Rehabilitación motora de tobillos, rodillas y hombros para atletas o personas activas que necesitan volver a entrenar sin molestias ni recaídas.',
    tags: ['Esguinces y tendinitis', 'Readaptación motora', 'Rango articular'],
    icon: 'sports',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación quiropráctica para Lesiones Deportivas y Esguinces.'
  },
  {
    title: 'Alteraciones Posturales y Escoliosis',
    region: 'Eje Biomecánico Global',
    badge: 'Plantillas a Medida',
    desc: 'Reeducación neuromuscular y prescripción de plantillas ortopédicas biomecánicas a medida para balancear la carga sobre columna y caderas.',
    tags: ['Plantillas computarizadas', 'Asimetría de carga', 'Reeducación postural'],
    icon: 'posture',
    whatsappText: 'Hola Felipe, quisiera consultar por evaluación biomecánica de Postura y Plantillas Ortopédicas.'
  }
];
---

<BaseLayout
  title="Quiropraxia y Kinesiología en Temuco | Felipe Méndez | Vida Sana Austral"
  description="Consulta de Quiropraxia y Kinesiología Clínica en Temuco con Felipe Méndez. Ajuste vertebral, lumbago, ciática, fisioterapia y plantillas ortopédicas. Box privado."
  canonicalUrl="https://centrovidasana.cl/quiropraxia"
  customSchema={quiroSchema}
>
  <Navbar slot="navbar" activePage="quiropraxia" />

  <!-- =========================================================================
       HERO DE QUIROPRAXIA
       ========================================================================= -->
  <section class="pt-28 pb-16 lg:pt-36 lg:pb-24 bg-gradient-to-b from-[#EDF5F8] via-[#F4F9FA] to-[#FBFDFB] text-[#152219] relative overflow-hidden border-b border-[#D8E6EB]">
    
    <!-- Glow y formas orgánicas de ambientación -->
    <div class="absolute -top-32 -left-32 w-[550px] h-[550px] bg-[#134E5E]/[0.07] rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute top-1/2 right-[-10%] w-[500px] h-[500px] bg-[#2A6F82]/[0.05] rounded-full blur-[130px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#526F77] mb-6 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#134E5E] transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-[#134E5E] font-bold">Quiropraxia &amp; Kinesiología</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">

        <!-- Lado Texto -->
        <div class="lg:col-span-6 space-y-6 text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3F0F4] border border-[#BBD9E2] text-[#134E5E] text-xs font-bold uppercase tracking-wider shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#134E5E] animate-pulse"></span>
            <span>Atención Clínica Biomecánica · Box Privado</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-[#0B2B33] tracking-tight leading-[1.12]">
            Quiropraxia y Kinesiología Clínica en <span class="text-[#134E5E]">Temuco</span>
          </h1>

          <p class="text-base sm:text-lg text-[#3D5C64] leading-relaxed max-w-2xl">
            Alineación vertebral biomecánica, descompresión articular y rehabilitación activa para aliviar el dolor de columna, lumbago, ciática y contracturas crónicas sin fármacos.
          </p>

          <!-- CTAs y Garantías -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
            <a
              href={`https://wa.me/56973700616?text=${encodeURIComponent('Hola Felipe, me interesa agendar una consulta de Quiropraxia y Kinesiología en Temuco.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl bg-[#134E5E] hover:bg-[#0E3B47] text-white text-sm sm:text-base font-bold shadow-soft hover:shadow-[0_10px_30px_rgba(19,78,94,0.3)] transition-all cursor-pointer"
            >
              <svg class="w-5 h-5 text-cyan-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Agendar con Felipe (+569 7370 0616)</span>
            </a>
            <a
              href="#servicios-quiro"
              class="inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-white border border-[#C2DFE8] text-xs sm:text-sm font-bold text-[#134E5E] hover:bg-[#EBF5F8] transition-colors"
            >
              <span>Ver Tratamientos y Tarifas</span>
              <span>↓</span>
            </a>
          </div>

          <!-- Píldoras de Calidad -->
          <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-[#46656E] pt-2">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#134E5E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Ajustes vertebrales de precisión
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#134E5E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              Camilla quiropráctica drop profesional
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#134E5E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Atención personalizada 1 a 1
            </span>
          </div>

        </div>

        <!-- Lado Visual (Retrato con Blob Ampliado) -->
        <div class="lg:col-span-6 relative flex items-center justify-center lg:justify-end">
          <div class="relative w-full max-w-[500px] sm:max-w-[560px] lg:max-w-[620px] xl:max-w-[680px] flex items-end justify-center pt-4 pb-2">
            
            <!-- Blob de Fondo -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
              <div class="w-[380px] sm:w-[460px] lg:w-[520px] xl:w-[580px] h-[380px] sm:h-[460px] lg:h-[520px] xl:h-[580px] bg-[#134E5E]/20 rounded-full blur-3xl"></div>
              <svg viewBox="0 0 500 500" class="w-[360px] sm:w-[450px] lg:w-[520px] xl:w-[570px] h-[360px] sm:h-[450px] lg:h-[520px] xl:h-[570px] filter drop-shadow-[0_18px_36px_rgba(19,78,94,0.28)]" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="blob-quiro-hero" x1="10%" y1="10%" x2="90%" y2="90%">
                    <stop offset="0%" stop-color="#8ACAD9" />
                    <stop offset="50%" stop-color="#347C90" />
                    <stop offset="100%" stop-color="#134E5E" />
                  </linearGradient>
                </defs>
                <path d="M433,310Q396,370,336,416Q276,462,207,433Q138,404,91,347Q44,290,66,219Q88,148,151,104Q214,60,289,75Q364,90,417,170Q470,250,433,310Z" fill="url(#blob-quiro-hero)" />
              </svg>
            </div>

            <!-- Foto de Felipe HD Ampliada -->
            <img
              src="/pix/felipe-kinesiologo-hd.webp"
              srcset="/pix/felipe-kinesiologo-hd.webp 2x, /pix/felipe-kinesiologo.webp 1x"
              alt="Felipe Méndez, Quiropráctico en Temuco"
              class="relative z-10 w-full max-w-[420px] sm:max-w-[500px] lg:max-w-[560px] xl:max-w-[620px] max-h-[520px] sm:max-h-[580px] lg:max-h-[640px] xl:max-h-[700px] object-contain drop-shadow-[0_22px_45px_rgba(10,35,45,0.30)] [mask-image:linear-gradient(to_bottom,black_92%,transparent_100%)] transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
              fetchpriority="high"
              width="881"
              height="800"
            />

            <!-- Chip Profesional Enriquecido -->
            <div class="absolute bottom-1 sm:bottom-3 left-1 sm:left-3 lg:-left-2 xl:-left-4 p-3 sm:p-3.5 rounded-2xl bg-white/95 border border-[#BBD9E2] backdrop-blur-md shadow-[0_14px_32px_rgba(19,78,94,0.20)] flex items-center gap-3 z-20">
              <div class="w-10 h-10 rounded-xl bg-[#134E5E] text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              </div>
              <div class="text-left pr-1">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-bold text-[#0B2B33] block leading-tight">Felipe Méndez</span>
                  <span class="text-[10px] font-semibold text-[#134E5E] bg-[#E3F0F4] px-1.5 py-0.5 rounded">Minsal</span>
                </div>
                <span class="text-[11px] text-[#526F77] block leading-tight">Quiropráctico &amp; Kinesiólogo</span>
                <a href="#enfoque-clinico" class="text-[11px] font-bold text-[#134E5E] hover:underline inline-flex items-center gap-1 pt-0.5">
                  <span>Ver modelo clínico y respaldo ↓</span>
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- =========================================================================
       MODELO CLÍNICO BASADO EN NEUROCIENCIAS & RESPALDO PROFESIONAL
       ========================================================================= -->
  <section id="enfoque-clinico" class="py-16 sm:py-24 bg-[#FBFDFB] border-b border-[#DCEBF0] relative overflow-hidden scroll-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Cabecera -->
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E3F0F4] border border-[#BBD9E2] text-[#134E5E] text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
          <span>Enfoque Terapéutico · Felipe Méndez</span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#152219] tracking-tight mb-4">
          Modelo Clínico Basado en Neurociencias
        </h2>
        <p class="text-base sm:text-lg text-[#526F77] leading-relaxed">
          Integración de evaluación autonómica (VFC/HRV), estimulación neurofuncional, ajuste quiropráctico y ejercicio terapéutico.
        </p>
      </div>

      <!-- Tarjeta Editorial con el Fundamento Clínico -->
      <div class="max-w-4xl mx-auto mb-14">
        <div class="p-2 sm:p-2.5 rounded-[2rem] bg-gradient-to-br from-[#E2ECF0] via-white to-[#D2E4EA] ring-1 ring-[#BBD9E2]/60 shadow-[0_12px_40px_rgba(19,78,94,0.08)]">
          <div class="p-7 sm:p-10 lg:p-12 rounded-[calc(2rem-0.625rem)] bg-white relative overflow-hidden">
            <span class="absolute top-4 right-8 font-serif text-8xl sm:text-9xl text-[#134E5E]/[0.07] pointer-events-none select-none">“</span>
            
            <div class="relative z-10 space-y-5">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-1 rounded-full bg-[#134E5E]"></span>
                <span class="text-xs font-bold tracking-widest uppercase text-[#526F77]">Fundamento Terapéutico</span>
              </div>

              <blockquote class="text-base sm:text-lg text-[#243B42] leading-relaxed italic">
                "{felipe.approachQuote}"
              </blockquote>

              <div class="pt-4 border-t border-[#E8F0F3] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <span class="font-serif text-base sm:text-lg font-bold text-[#0B2B33] block">{felipe.fullName}</span>
                  <span class="text-xs text-[#526F77] block">{felipe.title} · Centro Vida Sana Austral</span>
                </div>
                <!-- Respaldo Académico Sintético -->
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EBF4F6] text-[#134E5E] border border-[#C9DFE6]">
                    U. Mayor &amp; U. Central
                  </span>
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EBF4F6] text-[#134E5E] border border-[#C9DFE6]">
                    Diplomado Neurorrehabilitación
                  </span>
                  <span class="px-3 py-1 rounded-full font-semibold bg-[#EBF4F6] text-[#134E5E] border border-[#C9DFE6]">
                    Certificado Minsal
                  </span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- 4 Pilares Prácticos para el Paciente -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="p-6 rounded-2xl bg-white border border-[#D0E2E8] hover:border-[#134E5E] transition-all duration-300 shadow-xs flex flex-col justify-between">
          <div class="space-y-2.5">

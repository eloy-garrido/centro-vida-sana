<script>
  // Manejador vCard para descarga directa de contacto
  const vcardButtons = document.querySelectorAll('.vcard-btn');
  vcardButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const pro = btn.getAttribute('data-pro');
      if (pro === 'felipe') {
        const vcardContent = `BEGIN:VCARD
VERSION:3.0
N:Méndez Salgado;Felipe;Andrés;;
FN:Felipe Méndez - Kinesiólogo y Quiropráctico
ORG:Centro Vida Sana Austral
TITLE:Licenciado en Kinesiología y Quiropráctico
TEL;TYPE=CELL,VOICE:+56973700616
EMAIL:quirofelme@gmail.com
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;Araucanía;;Chile
URL:https://centrovidasana.cl/profesionales/felipe-mendez
NOTE:Atención Quiropráctica y Kinesiológica en Temuco. Box privado y domicilio.
END:VCARD`;
        downloadVCard(vcardContent, 'Felipe_Mendez_VidaSana.vcf');
      } else if (pro === 'eduardo') {
        const vcardContent = `BEGIN:VCARD
VERSION:3.0
N:Lagos;Eduardo;;;
FN:Eduardo Lagos - Acupunturista Clínico Minsal
ORG:Centro Vida Sana Austral
TITLE:Acupunturista Certificado por Minsal
TEL;TYPE=CELL,VOICE:+56973888910
EMAIL:centrovidasanaaustral@gmail.com
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;Araucanía;;Chile
URL:https://centrovidasana.cl/profesionales/eduardo-lagos
NOTE:Acupuntura y Medicina Tradicional China en Temuco. Acreditado por Minsal.
END:VCARD`;
        downloadVCard(vcardContent, 'Eduardo_Lagos_VidaSana.vcf');
      }
    });
  });

  function downloadVCard(content: string, filename: string) {
    const blob = new Blob([content], { type: 'text/vcard;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }
</script>

---
import { clinicInfo } from '../../data/clinic';
import { professionals } from '../../data/professionals';
---

<footer class="bg-[#121815] text-[#D8E0DA] pt-16 pb-12 border-t border-[#202924]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-[#242F29]">

      <!-- Columna 1: Marca & Misión -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#1C2520] border border-[#2D3B33] flex items-center justify-center p-1.5">
            <img
              src="/pix/logo-sin-texto-96.webp"
              alt="Logo Centro Vida Sana Austral"
              width="32"
              height="32"
              class="w-full h-full object-contain"
            />
          </div>
          <span class="font-serif font-bold text-xl text-white tracking-tight">
            Vida Sana Austral
          </span>
        </div>
        <p class="text-sm text-[#9BB0A2] leading-relaxed">
          Centro de salud integral en Temuco. Unimos el rigor biomecánico de la quiropraxia y kinesiología con la sabiduría milenaria de la acupuntura para tratar el origen de tu dolor.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#1C2822] text-[#A8C8B2] border border-[#2B3E34]">
            <span class="w-2 h-2 rounded-full bg-[#497356]"></span>
            Profesionales Certificados Minsal
          </span>
        </div>
      </div>

      <!-- Columna 2: Disciplinas Clínicas -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-semibold text-white tracking-wide">
          Especialidades
        </h3>
        <ul class="space-y-2 text-sm text-[#AAB8AE]">
          <li>
            <a href="#quiro-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-petrol-accent"></span>
              Ajuste Quiropráctico de Columna
            </a>
          </li>
          <li>
            <a href="#quiro-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-petrol-accent"></span>
              Rehabilitación y Fisioterapia
            </a>
          </li>
          <li>
            <a href="#quiro-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-petrol-accent"></span>
              Kinesiología a Domicilio (Temuco)
            </a>
          </li>
          <li>
            <a href="#acup-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-accent"></span>
              Acupuntura Clínica y Dolor Crónico
            </a>
          </li>
          <li>
            <a href="#acup-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-accent"></span>
              Ventosas (Cupping) y Moxibustión
            </a>
          </li>
          <li>
            <a href="#acup-section" class="hover:text-white transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-accent"></span>
              Electroacupuntura Especializada
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Directo -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-semibold text-white tracking-wide">
          Atención y Contacto
        </h3>
        <div class="space-y-2.5 text-sm text-[#AAB8AE]">
          <div class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-petrol-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{clinicInfo.address.full}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-sage-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>{clinicInfo.hours.days}: {clinicInfo.hours.time}</span>
          </div>
          <div class="pt-2 flex flex-col gap-1.5">
            <a href={`tel:${professionals.felipe.phone}`} class="hover:text-white transition-colors text-xs flex items-center gap-2">
              <span class="font-semibold text-petrol-light">Quiropraxia (Felipe):</span>
              <span>{professionals.felipe.phoneFormatted}</span>
            </a>
            <a href={`tel:${professionals.eduardo.phone}`} class="hover:text-white transition-colors text-xs flex items-center gap-2">
              <span class="font-semibold text-sage-light">Acupuntura (Eduardo):</span>
              <span>{professionals.eduardo.phoneFormatted}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna 4: Reconocimiento y Redes -->
      <div class="space-y-3">
        <h3 class="font-serif text-base font-semibold text-white tracking-wide">
          Confianza Verificada
        </h3>
        <a
          href={clinicInfo.social.googleReviews}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-3.5 rounded-xl bg-[#18221D] border border-[#27382F] hover:border-[#3A5446] transition-all group cursor-pointer"
        >
          <div class="flex items-center gap-1.5 text-amber-400 mb-1">
            <span>★★★★★</span>
            <span class="text-xs font-bold text-white ml-1">5.0 / 5.0</span>
          </div>
          <p class="text-xs text-[#9BB0A2] group-hover:text-white transition-colors">
            Basado en 156+ opiniones verificadas en Google Maps.
          </p>
        </a>

        <div class="pt-2 flex items-center gap-3">
          <a
            href={clinicInfo.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Centro Vida Sana Austral"
            class="w-10 h-10 rounded-xl bg-[#1C2520] border border-[#2D3B33] hover:border-white text-white flex items-center justify-center transition-colors cursor-pointer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Copyright y Créditos -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#7A8E81] gap-4">
      <p>© {new Date().getFullYear()} Centro Vida Sana Austral. Todos los derechos reservados. Temuco, Chile.</p>
      <p class="flex items-center gap-2">
        <span>Felipe Méndez &amp; Eduardo Lagos</span>
        <span>·</span>
        <span>Acreditados Minsal</span>
      </p>
    </div>
  </div>
</footer>

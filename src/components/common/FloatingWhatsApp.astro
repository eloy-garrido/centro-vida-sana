---
import { professionals } from '../../data/professionals';
---

<div class="fixed bottom-6 right-6 z-50 flex flex-col items-end" id="floating-whatsapp-container">

  <!-- Popover Menu (hidden by default) -->
  <div
    id="fab-options"
    class="hidden mb-3 p-2 rounded-2xl bg-surface/95 backdrop-blur-xl border border-surface-border shadow-soft-lg w-72 transition-all duration-200 transform origin-bottom-right"
    role="dialog"
    aria-label="Opciones de contacto por WhatsApp"
  >
    <div class="p-2 border-b border-surface-border mb-1.5">
      <span class="text-xs font-bold text-ink-primary block">¿Con quién deseas agendar?</span>
      <span class="text-[11px] text-ink-muted">Selecciona tu especialista de preferencia:</span>
    </div>

    <!-- Option Felipe -->
    <a
      href={`https://wa.me/56973700616?text=${encodeURIComponent(professionals.felipe.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-press flex items-center gap-3 p-2.5 rounded-xl hover:bg-petrol-light/70 transition-colors group cursor-pointer"
    >
      <div class="relative w-10 h-10 rounded-xl overflow-hidden border border-petrol/20 shrink-0">
        <img src={professionals.felipe.photoUrl} alt="Felipe Méndez" class="w-full h-full object-cover" />
      </div>
      <div class="flex-1 min-w-0">
        <span class="text-xs font-bold text-ink-primary block group-hover:text-petrol transition-colors">
          Felipe Méndez
        </span>
        <span class="text-[11px] text-petrol font-medium block truncate">
          Quiropraxia &amp; Kinesiología
        </span>
      </div>
      <svg class="w-4 h-4 text-petrol shrink-0 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <!-- Option Eduardo -->
    <a
      href={`https://wa.me/56973888910?text=${encodeURIComponent(professionals.eduardo.whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-press flex items-center gap-3 p-2.5 rounded-xl hover:bg-sage-light/70 transition-colors group cursor-pointer"
    >
      <div class="relative w-10 h-10 rounded-xl overflow-hidden border border-sage/20 shrink-0">
        <img src={professionals.eduardo.photoUrl} alt="Eduardo Lagos" class="w-full h-full object-cover" />
      </div>
      <div class="flex-1 min-w-0">
        <span class="text-xs font-bold text-ink-primary block group-hover:text-sage transition-colors">
          Eduardo Lagos
        </span>
        <span class="text-[11px] text-sage font-medium block truncate">
          Acupuntura &amp; Med. China
        </span>
      </div>
      <svg class="w-4 h-4 text-sage shrink-0 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Trigger FAB Button -->
  <button
    id="fab-toggle-btn"
    type="button"
    aria-label="Abrir opciones de WhatsApp"
    aria-expanded="false"
    class="btn-press relative w-14 h-14 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-soft-lg flex items-center justify-center transition-all cursor-pointer border-2 border-white/30"
  >
    <!-- Ping animado sutil -->
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500 border border-white"></span>
    </span>

    <!-- WhatsApp Icon SVG -->
    <svg id="fab-wa-icon" class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>

    <!-- Close Icon SVG (hidden by default) -->
    <svg id="fab-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

</div>

<script>
  // Floating WhatsApp Popover Toggle
  const fabBtn = document.getElementById('fab-toggle-btn');
  const fabOptions = document.getElementById('fab-options');
  const waIcon = document.getElementById('fab-wa-icon');
  const closeIcon = document.getElementById('fab-close-icon');

  if (fabBtn && fabOptions && waIcon && closeIcon) {
    fabBtn.addEventListener('click', () => {
      const isOpen = !fabOptions.classList.contains('hidden');
      if (isOpen) {
        fabOptions.classList.add('hidden');
        waIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        fabBtn.setAttribute('aria-expanded', 'false');
      } else {
        fabOptions.classList.remove('hidden');
        waIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        fabBtn.setAttribute('aria-expanded', 'true');
      }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const container = document.getElementById('floating-whatsapp-container');
      if (container && !container.contains(e.target as Node)) {
        fabOptions.classList.add('hidden');
        waIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        fabBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

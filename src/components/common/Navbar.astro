---
// Navbar - Centro Vida Sana Austral
interface Props {
  activePage?: 'home' | 'quiropraxia' | 'acupuntura' | 'profesionales';
}

const { activePage = 'home' } = Astro.props;
const isHome = activePage === 'home';
---

<nav class="navbar" id="navbar">
  <div class="nav-container">
    <a href={isHome ? "#hero" : "/"} class="nav-logo" aria-label="Centro Vida Sana - Inicio">
      <img
        src="/pix/yinyang.webp"
        alt="Logo Yin Yang Centro Vida Sana"
        width="38"
        height="38"
        class="nav-logo-icon"
        loading="eager"
        decoding="async"
      />
      <span class="nav-logo-text">Centro Vida Sana</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="nav-menu" id="navMenu">
      <li><a href={isHome ? "#hero" : "/"} class={`nav-link ${isHome ? 'active' : ''}`}>Inicio</a></li>
      <li><a href="/quiropraxia" class={`nav-link ${activePage === 'quiropraxia' ? 'active' : ''}`}>Quiropraxia</a></li>
      <li><a href="/acupuntura" class={`nav-link ${activePage === 'acupuntura' ? 'active' : ''}`}>Acupuntura</a></li>
      <li><a href={isHome ? "#profesionales" : "/#profesionales"} class={`nav-link ${activePage === 'profesionales' ? 'active' : ''}`}>Profesionales</a></li>
      <li><a href={isHome ? "#patologias" : "/#patologias"} class="nav-link">Patologías</a></li>
      <li><a href={isHome ? "#contacto" : "/#contacto"} class="nav-link">Contacto</a></li>
      <li>
        <a href="/reservar" class="nav-link nav-link-cta" aria-label="Reservar hora médica en línea">
          <svg class="nav-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Reservar Hora</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<style is:global>
  /* ============================================
     NAVBAR - Estilos Originales Exactos
     ============================================ */

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(122, 152, 114, 0.1);
    z-index: 1000;
    transition: all 0.3s ease;
  }

  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 30px rgba(122, 152, 114, 0.2);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1;
    padding: 4px 0;
    transition: opacity 0.25s ease;
  }

  .nav-logo:hover {
    opacity: 0.92;
  }

  .nav-logo img,
  .nav-logo .nav-logo-icon {
    width: 38px;
    height: 38px;
    object-fit: contain;
    border-radius: 50%;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: block;
    flex-shrink: 0;
  }

  .nav-logo:hover img,
  .nav-logo:hover .nav-logo-icon {
    transform: rotate(20deg) scale(1.06);
  }

  .nav-logo-text {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: var(--text-dark, #1e3321);
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav-logo:hover .nav-logo-text {
    color: var(--dark-green, #007231);
  }

  .nav-menu {
    display: flex;
    list-style: none;
    gap: 5px;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    padding: 10px 20px;
    color: var(--text-dark, #2d3e2d);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    border-radius: 25px;
    transition: all 0.3s ease;
    position: relative;
    display: inline-block;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 60%;
    height: 2px;
    background: var(--primary-green, #a8c5a0);
    transition: transform 0.3s ease;
  }

  .nav-link:hover {
    color: var(--dark-green, #7a9872);
  }

  .nav-link:hover::before {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link.active {
    color: var(--dark-green, #7a9872);
  }

  .nav-link.active::before {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link-cta {
    background: #2E4D38;
    background: linear-gradient(180deg, #355740 0%, #24412D 100%);
    color: #ffffff !important;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 8px 18px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 2px 8px rgba(46, 77, 56, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    line-height: 1;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link-cta .nav-cta-icon {
    width: 15px;
    height: 15px;
    color: #A8E5BA;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .nav-link-cta::before {
    display: none;
  }

  .nav-link-cta:hover {
    color: #ffffff !important;
    background: linear-gradient(180deg, #3C634A 0%, #2B4C35 100%);
    transform: translateY(-1.5px);
    box-shadow: 0 6px 16px rgba(46, 77, 56, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .nav-link-cta:hover .nav-cta-icon {
    transform: scale(1.1);
  }

  .nav-link-cta:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(46, 77, 56, 0.2);
  }

  .nav-link-cta:focus-visible {
    outline: 2px solid #2E4D38;
    outline-offset: 2px;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
  }

  .nav-toggle span {
    width: 25px;
    height: 3px;
    background: var(--text-dark, #2d3e2d);
    border-radius: 3px;
    transition: all 0.3s ease;
  }

  .nav-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .nav-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  @media (max-width: 1100px) and (min-width: 769px) {
    .nav-logo-text {
      font-size: 16px;
    }
    .nav-link {
      padding: 8px 12px;
      font-size: 14px;
    }
  }

  @media (max-width: 768px) {
    .nav-logo img,
    .nav-logo .nav-logo-icon {
      width: 32px;
      height: 32px;
    }

    .nav-logo-text {
      font-size: 16px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-menu {
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      flex-direction: column;
      padding: 20px;
      gap: 15px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      transform: translateY(-150%);
      opacity: 0;
      transition: all 0.4s ease;
      pointer-events: none;
    }

    .nav-menu.active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-menu .nav-link-cta {
      justify-content: center;
      width: 100%;
      padding: 13px 20px;
      font-size: 15.5px;
      margin-top: 6px;
      box-sizing: border-box;
    }
  }
</style>

<script>
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    const navToggle = document.getElementById('navToggle');
    const navMenu = document.getElementById('navMenu');

    if (navbar) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      });
    }

    if (navToggle && navMenu) {
      navToggle.addEventListener('click', () => {
        navToggle.classList.toggle('active');
        navMenu.classList.toggle('active');
      });

      // Close menu on link click
      navMenu.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          navToggle.classList.remove('active');
          navMenu.classList.remove('active');
        });
      });
    }
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>

---
import { faqsData } from '../../data/faqs';
---

<section id="faqs" class="py-20 lg:py-28 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-ink-muted mb-3">
        Dudas Resueltas
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-primary tracking-tight mb-4">
        Preguntas Frecuentes
      </h2>
      <p class="text-base text-ink-secondary leading-relaxed">
        Todo lo que necesitas saber sobre valores, procedimientos, orden médica y sesiones antes de asistir a tu consulta.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqsData.map((faq, index) => (
        <details class="faq-item group rounded-2xl bg-surface border border-surface-border p-5 sm:p-6 shadow-soft-sm transition-all duration-200 open:shadow-soft open:border-petrol/40">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-petrol rounded-lg">
            <span class="font-serif text-lg font-bold text-ink-primary group-hover:text-petrol transition-colors">
              {faq.question}
            </span>
            <div class="w-8 h-8 rounded-full bg-canvas flex items-center justify-center shrink-0 border border-surface-border text-ink-muted group-hover:border-petrol group-hover:text-petrol transition-colors">
              <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </summary>
          <div class="faq-content pt-4 mt-3 border-t border-surface-border/60 text-sm text-ink-secondary leading-relaxed">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Support CTA -->
    <div class="mt-10 text-center text-xs text-ink-muted">
      ¿Tienes otra pregunta sobre tu caso particular?{' '}
      <a
        href="https://wa.me/56973700616?text=Hola,%20tengo%20una%20consulta%20espec%C3%ADfica%20antes%20de%20agendar."
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-petrol hover:underline"
      >
        Escríbenos directamente por WhatsApp
      </a>
    </div>

  </div>
</section>

<style>
  /* Emil Kowalski Smooth Accordion Expansion */
  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] .faq-content {
    animation: accordionOpen 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes accordionOpen {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

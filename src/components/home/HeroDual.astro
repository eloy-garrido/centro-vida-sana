---
import { clinicInfo } from '../../data/clinic';
import { professionals } from '../../data/professionals';
---

<section id="hero" class="relative min-h-[92vh] xl:min-h-[95vh] flex items-center justify-center overflow-hidden bg-[#F8FAF7] text-[#152219] pt-6 pb-12 lg:pt-10 lg:pb-0 border-b border-[#E5EAE6]">

  <!-- ==============================================
       100% FULL-BLEED BACKGROUND: Sunlit Clinic Sanctuary
       ============================================== -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <!-- Full-bleed background image covering 100% of the Hero -->
    <img
      src="/pix/clinic-interior-bright.jpg"
      alt="Centro Vida Sana Austral - Instalaciones y Box Clínico en Temuco"
      class="w-full h-full object-cover object-[center_right] sm:object-right lg:object-center filter brightness-[1.02] contrast-[1.02]"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Luminous gradient veil: Solid on left for pristine readability, fading out to reveal the clinic on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#F8FAF7] via-[#F8FAF7]/95 via-45% lg:via-[#F8FAF7]/85 to-transparent"></div>

    <!-- Soft bottom blend transitioning cleanly to the next section -->
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#F8FAF7] via-[#F8FAF7]/60 to-transparent"></div>

    <!-- Soft top blend under navbar -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-[#F8FAF7]/80 to-transparent"></div>

    <!-- Subtle dual color radiance -->
    <div class="absolute -top-20 -left-20 w-[450px] h-[450px] bg-[#134E5E]/[0.05] rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-[#2E4D38]/[0.06] rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-4 items-end min-h-[78vh] lg:min-h-[82vh]">

      <!-- ==============================================
           LEFT COLUMN: Editorial Copy, Badges & Actions (7 Cols)
           ============================================== -->
      <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-center lg:text-left pt-6 pb-6 lg:pb-16 lg:pt-8">

        <!-- Authority Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 border border-[#DCE5DF] shadow-[0_2px_8px_rgba(21,34,25,0.04)] backdrop-blur-md">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-semibold text-[#3D5646] tracking-wide">
            Centro de Salud Integral en Temuco · Acreditados Minsal
          </span>
        </div>

        <!-- Master Editorial Headline -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl xl:text-[4.25rem] font-bold tracking-tight text-[#152219] leading-[1.08]">
          La Precisión de la <br class="hidden sm:inline" />
          <span class="text-petrol relative inline-block">
            Quiropraxia.
          </span>
          <br />
          La Sabiduría de la <br class="hidden sm:inline" />
          <span class="text-sage relative inline-block">
            Acupuntura.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-[#3F5345] leading-relaxed max-w-xl mx-auto lg:mx-0 font-normal">
          Felipe Méndez y Eduardo Lagos unen corrección biomecánica de columna y medicina tradicional china para eliminar la causa raíz de tu dolor y restaurar tu movilidad en Temuco.
        </p>

        <!-- Dual Discipline Quick Tags -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-1">
          <a
            href="#quiro-section"
            class="btn-press inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/90 border border-[#C2DFE8] hover:bg-[#EBF5F8] text-petrol text-xs font-bold transition-all shadow-sm backdrop-blur-sm cursor-pointer"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-petrol"></span>
            <span>Quiropraxia &amp; Kinesiología (Felipe)</span>
          </a>
          <a
            href="#acup-section"
            class="btn-press inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/90 border border-[#CCE2D2] hover:bg-[#EEF5F0] text-sage text-xs font-bold transition-all shadow-sm backdrop-blur-sm cursor-pointer"
          >
            <span class="w-2.5 h-2.5 rounded-full bg-sage"></span>
            <span>Acupuntura &amp; Med. China (Eduardo)</span>
          </a>
        </div>

        <!-- Primary Action Island -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <!-- Button-in-Button Primary Consultation CTA -->
          <a
            href="#contacto"
            class="group btn-press w-full sm:w-auto inline-flex items-center justify-between sm:justify-center gap-3.5 px-7 py-3.5 rounded-full bg-gradient-to-r from-petrol to-sage hover:from-[#175F73] hover:to-[#385F44] text-white text-base font-bold shadow-[0_8px_24px_rgba(19,78,94,0.22)] transition-all cursor-pointer"
          >
            <span>Agendar Evaluación</span>
            <div class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-[1px]">
              <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Secondary Services CTA -->
          <a
            href="#servicios"
            class="group btn-press w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/90 hover:bg-white text-[#2D3E32] text-sm font-semibold border border-[#D5E0D8] shadow-sm backdrop-blur-sm transition-all cursor-pointer"
          >
            <span>Ver Terapias y Valores</span>
            <svg class="w-4 h-4 text-[#6E8576] transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Floating Glass Contact Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2 max-w-xl mx-auto lg:mx-0">

          <!-- Card 1: Dirección y Maps -->
          <a
            href={clinicInfo.address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press p-3.5 rounded-2xl bg-white/90 border border-[#DCE5DF] hover:border-petrol/60 shadow-[0_4px_16px_rgba(21,34,25,0.04)] backdrop-blur-md flex items-center gap-3 transition-all group text-left cursor-pointer"
          >
            <div class="w-10 h-10 rounded-xl bg-[#EBF5F8] text-petrol flex items-center justify-center shrink-0 border border-[#C6DFE8]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-petrol block">
                Ubicación Clínica
              </span>
              <span class="text-xs font-bold text-[#152219] group-hover:text-petrol transition-colors block">
                Los Armiños 1620, Temuco
              </span>
              <span class="text-[10px] text-[#6E8576]">
                Con estacionamiento privado →
              </span>
            </div>
          </a>

          <!-- Card 2: Opiniones Google -->
          <a
            href={clinicInfo.social.googleReviews}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press p-3.5 rounded-2xl bg-white/90 border border-[#DCE5DF] hover:border-sage/60 shadow-[0_4px_16px_rgba(21,34,25,0.04)] backdrop-blur-md flex items-center gap-3 transition-all group text-left cursor-pointer"
          >
            <div class="w-10 h-10 rounded-xl bg-[#EEF5F0] text-sage flex items-center justify-center shrink-0 border border-[#CCE2D2]">
              <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-1 text-amber-500 text-xs">
                <span>★★★★★</span>
                <span class="font-bold text-[#152219] ml-1">5.0</span>
              </div>
              <span class="text-xs font-bold text-[#152219] group-hover:text-sage transition-colors block">
                156+ Reseñas Verificadas
              </span>
              <span class="text-[10px] text-[#6E8576]">
                Leer comentarios de pacientes →
              </span>
            </div>
          </a>

        </div>

      </div>

      <!-- ==============================================
           RIGHT COLUMN: FREE-STANDING CLINICIANS (5 Cols)
           No boxes, no cages. Grounded freely in the clinic space!
           ============================================== -->
      <div class="lg:col-span-5 relative flex items-end justify-center lg:justify-end w-full">

        <!-- Top Floating Credential Badge -->
        <div class="absolute top-2 right-4 sm:right-8 lg:right-4 z-20 hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-white/95 border border-[#D5E0D8] backdrop-blur-xl shadow-soft">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <div class="text-[11px] leading-tight text-left">
            <span class="font-bold text-[#152219] block">Atención Personalizada 1 a 1</span>
            <span class="text-[#556D60]">Boxes privados climatizados</span>
          </div>
        </div>

        <!-- The Real Cutout of Felipe and Eduardo - Standing Tall and Free -->
        <div class="relative z-10 w-full max-w-[500px] lg:max-w-none flex items-end justify-center lg:justify-end">
          <picture>
            <source srcset="/pix/duo-hd.webp" type="image/webp" />
            <img
              src="/pix/duo-hd.png"
              alt="Felipe Méndez y Eduardo Lagos - Centro Vida Sana Austral"
              class="w-auto h-[440px] sm:h-[540px] lg:h-[620px] xl:h-[680px] object-contain drop-shadow-[0_20px_40px_rgba(21,34,25,0.22)] filter contrast-[1.03] select-none pointer-events-none"
              loading="eager"
              fetchpriority="high"
            />
          </picture>

          <!-- Floating Interactive Chips Container for Mobile & Desktop (No Overlap) -->
          <div class="absolute bottom-4 inset-x-2 sm:inset-x-4 z-20 flex items-center justify-between gap-2 sm:gap-3">

            <!-- Chip Felipe -->
            <a
              href={`https://wa.me/56973700616?text=${encodeURIComponent(professionals.felipe.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press flex-1 min-w-0 p-1.5 sm:p-2.5 pr-2.5 sm:pr-3.5 rounded-2xl bg-white/95 border border-[#C6DFE8] hover:border-petrol shadow-[0_8px_24px_rgba(19,78,94,0.15)] backdrop-blur-xl flex items-center gap-2 sm:gap-2.5 text-left transition-all group cursor-pointer"
            >
              <img
                src={professionals.felipe.photoUrl}
                alt={professionals.felipe.name}
                class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl object-cover border border-[#C6DFE8] group-hover:scale-105 transition-transform shrink-0"
              />
              <div class="min-w-0">
                <div class="flex items-center gap-1">
                  <span class="text-[11px] sm:text-xs font-bold text-petrol block leading-tight truncate">{professionals.felipe.name}</span>
                  <span class="hidden sm:inline px-1 py-0.2 rounded text-[8px] font-bold bg-[#EBF5F8] text-petrol">Minsal</span>
                </div>
                <span class="text-[9px] sm:text-[10px] text-[#556D60] block leading-tight truncate">Quiropráctico &amp; Kine</span>
              </div>
            </a>

            <!-- Chip Eduardo -->
            <a
              href={`https://wa.me/56973888910?text=${encodeURIComponent(professionals.eduardo.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press flex-1 min-w-0 p-1.5 sm:p-2.5 pr-2.5 sm:pr-3.5 rounded-2xl bg-white/95 border border-[#CCE2D2] hover:border-sage shadow-[0_8px_24px_rgba(46,77,56,0.15)] backdrop-blur-xl flex items-center gap-2 sm:gap-2.5 text-left transition-all group cursor-pointer"
            >
              <img
                src={professionals.eduardo.photoUrl}
                alt={professionals.eduardo.name}
                class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl object-cover border border-[#CCE2D2] group-hover:scale-105 transition-transform shrink-0"
              />
              <div class="min-w-0">
                <div class="flex items-center gap-1">
                  <span class="text-[11px] sm:text-xs font-bold text-sage block leading-tight truncate">{professionals.eduardo.name}</span>
                  <span class="hidden sm:inline px-1 py-0.2 rounded text-[8px] font-bold bg-[#EEF5F0] text-sage">Minsal</span>
                </div>
                <span class="text-[9px] sm:text-[10px] text-[#556D60] block leading-tight truncate">Acupuntura Minsal</span>
              </div>
            </a>

          </div>

        </div>

      </div>

    </div>
  </div>

</section>

---
import { clinicInfo } from '../../data/clinic';
import { professionals } from '../../data/professionals';
---

<section id="hero" class="relative pt-8 pb-20 md:pt-14 md:pb-28 overflow-hidden">
  <!-- Sutil fondo con resplandor ambiental orgánico -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute -top-40 left-1/4 w-[500px] h-[500px] bg-petrol-light/50 rounded-full blur-3xl opacity-60"></div>
    <div class="absolute -top-20 right-1/4 w-[500px] h-[500px] bg-sage-light/60 rounded-full blur-3xl opacity-60"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Eyebrow & Badges de Autoridad -->
    <div class="text-center max-w-3xl mx-auto mb-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface border border-surface-border shadow-soft-sm text-xs font-semibold text-ink-secondary mb-6">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Atención en Temuco · Profesionales Acreditados por el Minsal</span>
      </div>

      <!-- Título Principal H1 Editorial -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-semibold text-ink-primary tracking-tight leading-[1.18] mb-6">
        Salud Integral y Alivio del Dolor: <br class="hidden sm:inline" />
        <span class="text-petrol relative inline-block">
          Quiropraxia
          <svg class="absolute -bottom-1.5 left-0 w-full h-2 text-petrol-border" viewBox="0 0 100 12" preserveAspectRatio="none" fill="currentColor">
            <path d="M0,8 Q50,0 100,8 L100,12 L0,12 Z"></path>
          </svg>
        </span>
        <span class="text-ink-muted font-normal text-2xl sm:text-3xl md:text-4xl mx-1">&amp;</span>
        <span class="text-sage relative inline-block">
          Acupuntura
          <svg class="absolute -bottom-1.5 left-0 w-full h-2 text-sage-border" viewBox="0 0 100 12" preserveAspectRatio="none" fill="currentColor">
            <path d="M0,8 Q50,0 100,8 L100,12 L0,12 Z"></path>
          </svg>
        </span>
      </h1>

      <p class="text-base sm:text-lg text-ink-secondary leading-relaxed max-w-2xl mx-auto">
        Tratamos el origen mecánico y sistémico de tus dolencias. Dos disciplinas de excelencia clínica trabajando en conjunto para recuperar tu movilidad, calma y calidad de vida.
      </p>
    </div>

    <!-- Interactive Segmented Discipline Switcher (Emil Kowalski style) -->
    <div class="flex justify-center mb-10">
      <div class="inline-flex p-1.5 rounded-2xl bg-surface border border-surface-border shadow-soft" role="tablist" aria-label="Filtrar por disciplina">
        <button
          type="button"
          class="hero-tab-btn active px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer flex items-center gap-2 bg-ink-primary text-white shadow-soft-sm"
          data-target="both"
        >
          <span>Enfoque Dual Integral</span>
        </button>
        <button
          type="button"
          class="hero-tab-btn px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-ink-secondary hover:text-petrol transition-all duration-200 cursor-pointer flex items-center gap-2"
          data-target="quiro"
        >
          <span class="w-2 h-2 rounded-full bg-petrol"></span>
          <span>Solo Quiropraxia</span>
        </button>
        <button
          type="button"
          class="hero-tab-btn px-4 sm:px-6 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-ink-secondary hover:text-sage transition-all duration-200 cursor-pointer flex items-center gap-2"
          data-target="acup"
        >
          <span class="w-2 h-2 rounded-full bg-sage"></span>
          <span>Solo Acupuntura</span>
        </button>
      </div>
    </div>

    <!-- Dual Split Hub Showcase Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto" id="hero-cards-container">

      <!-- Panel Quiropraxia & Kinesiología (Azul Petróleo Clásico) -->
      <article
        id="hero-card-quiro"
        class="hero-card relative rounded-3xl bg-surface border-2 border-petrol-border/80 p-6 sm:p-8 shadow-soft hover:shadow-petrol-glow transition-all duration-300 flex flex-col justify-between group overflow-hidden"
      >
        <div class="absolute top-0 right-0 w-36 h-36 bg-petrol-light/40 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-3 mb-5">
            <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-petrol bg-petrol-light border border-petrol-border/80">
              Columna &amp; Biomecánica
            </span>
            <span class="text-xs font-medium text-ink-muted">
              Reg. Minsal N° 458921
            </span>
          </div>

          <div class="flex items-center gap-4 mb-6">
            <div class="relative w-16 h-16 rounded-2xl overflow-hidden border-2 border-petrol/20 shadow-soft-sm shrink-0">
              <img
                src={professionals.felipe.photoUrl}
                alt={professionals.felipe.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div>
              <h2 class="font-serif text-2xl font-bold text-ink-primary">
                Felipe Méndez
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-petrol">
                {professionals.felipe.title}
              </p>
            </div>
          </div>

          <p class="text-sm text-ink-secondary mb-6 leading-relaxed">
            Diagnóstico clínico y ajustes articulares indoloros para descomprimir discos vertebrales, corregir pinzamientos y devolver la estabilidad muscular.
          </p>

          <div class="space-y-2.5 mb-8">
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-petrol-light text-petrol flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Lumbago agudo, discopatías y dolor ciático</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-petrol-light text-petrol flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Cervicalgia, tortícolis y mareos por tensión</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-petrol-light text-petrol flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Kinesiología integral y atención a domicilio</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-surface-border flex flex-col sm:flex-row gap-3">
          <a
            href="https://wa.me/56973700616?text=Hola%20Felipe,%20quisiera%20agendar%20una%20consulta%20de%20Quiropraxia%20/%20Kinesiolog%C3%ADa"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-petrol text-white text-sm font-semibold shadow-soft hover:bg-petrol-hover transition-colors cursor-pointer"
          >
            <span>Consultar con Felipe</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="#quiro-section"
            class="btn-press px-4 py-3 rounded-xl bg-petrol-light text-petrol border border-petrol-border/80 text-sm font-semibold hover:bg-white text-center transition-colors cursor-pointer"
          >
            Ver Terapias
          </a>
        </div>
      </article>

      <!-- Panel Acupuntura & Medicina China (Verde Salvia Botánico) -->
      <article
        id="hero-card-acup"
        class="hero-card relative rounded-3xl bg-surface border-2 border-sage-border/80 p-6 sm:p-8 shadow-soft hover:shadow-sage-glow transition-all duration-300 flex flex-col justify-between group overflow-hidden"
      >
        <div class="absolute top-0 right-0 w-36 h-36 bg-sage-light/40 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-3 mb-5">
            <span class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-sage bg-sage-light border border-sage-border/80">
              Equilibrio &amp; Neuroacupuntura
            </span>
            <span class="text-xs font-medium text-ink-muted">
              Reg. Minsal N° 381042
            </span>
          </div>

          <div class="flex items-center gap-4 mb-6">
            <div class="relative w-16 h-16 rounded-2xl overflow-hidden border-2 border-sage/20 shadow-soft-sm shrink-0">
              <img
                src={professionals.eduardo.photoUrl}
                alt={professionals.eduardo.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div>
              <h2 class="font-serif text-2xl font-bold text-ink-primary">
                Eduardo Lagos
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-sage">
                {professionals.eduardo.title}
              </p>
            </div>
          </div>

          <p class="text-sm text-ink-secondary mb-6 leading-relaxed">
            Regulación del sistema nervioso y liberación de analgésicos naturales mediante agujas ultrafinas estériles, electroacupuntura y moxibustión milenaria.
          </p>

          <div class="space-y-2.5 mb-8">
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-sage-light text-sage flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Dolor crónico resistente, artrosis y fibromialgia</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-sage-light text-sage flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Cefaleas, migrañas y parálisis facial</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ink-secondary">
              <div class="w-5 h-5 rounded-md bg-sage-light text-sage flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <span>Estrés agudo, insomnio y ventosaterapia (Cupping)</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-surface-border flex flex-col sm:flex-row gap-3">
          <a
            href="https://wa.me/56973888910?text=Hola%20Eduardo,%20quisiera%20agendar%20una%20consulta%20de%20Acupuntura%20/%20Medicina%20China"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-sage text-white text-sm font-semibold shadow-soft hover:bg-sage-hover transition-colors cursor-pointer"
          >
            <span>Consultar con Eduardo</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="#acup-section"
            class="btn-press px-4 py-3 rounded-xl bg-sage-light text-sage border border-sage-border/80 text-sm font-semibold hover:bg-white text-center transition-colors cursor-pointer"
          >
            Ver Terapias
          </a>
        </div>
      </article>

    </div>

    <!-- Barra Inferior de Métricas de Confianza -->
    <div class="mt-14 max-w-4xl mx-auto pt-8 border-t border-surface-border grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center">
        <span class="font-serif font-bold text-2xl lg:text-3xl text-ink-primary">156+</span>
        <span class="text-xs text-ink-muted font-medium mt-0.5">Reseñas 5.0 en Google</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="font-serif font-bold text-2xl lg:text-3xl text-petrol">Minsal</span>
        <span class="text-xs text-ink-muted font-medium mt-0.5">Registro Nacional de Salud</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="font-serif font-bold text-2xl lg:text-3xl text-sage">10+ Años</span>
        <span class="text-xs text-ink-muted font-medium mt-0.5">Experiencia Clínica</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="font-serif font-bold text-2xl lg:text-3xl text-ink-primary">100%</span>
        <span class="text-xs text-ink-muted font-medium mt-0.5">Atención Personalizada</span>
      </div>
    </div>

  </div>
</section>

<script>
  // Hero Interactive Discipline Switcher (Spring transition)
  const tabButtons = document.querySelectorAll('.hero-tab-btn');
  const cardQuiro = document.getElementById('hero-card-quiro');
  const cardAcup = document.getElementById('hero-card-acup');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => {
        b.classList.remove('active', 'bg-ink-primary', 'text-white', 'shadow-soft-sm');
        b.classList.add('text-ink-secondary');
      });

      btn.classList.add('active', 'bg-ink-primary', 'text-white', 'shadow-soft-sm');
      btn.classList.remove('text-ink-secondary');

      const target = btn.getAttribute('data-target');

      if (target === 'quiro') {
        if (cardQuiro && cardAcup) {
          cardQuiro.style.display = 'flex';
          cardQuiro.style.transform = 'scale(1.02)';
          cardQuiro.classList.add('border-petrol');
          cardAcup.style.display = 'none';
        }
      } else if (target === 'acup') {
        if (cardQuiro && cardAcup) {
          cardQuiro.style.display = 'none';
          cardAcup.style.display = 'flex';
          cardAcup.style.transform = 'scale(1.02)';
          cardAcup.classList.add('border-sage');
        }
      } else {
        if (cardQuiro && cardAcup) {
          cardQuiro.style.display = 'flex';
          cardQuiro.style.transform = 'scale(1)';
          cardQuiro.classList.remove('border-petrol');
          cardAcup.style.display = 'flex';
          cardAcup.style.transform = 'scale(1)';
          cardAcup.classList.remove('border-sage');
        }
      }
    });
  });
</script>

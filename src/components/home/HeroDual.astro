<script>
  function initHeroWspDropdown() {
    const wrapper = document.getElementById('heroWspWrapper');
    const trigger = document.getElementById('heroWspTrigger');
    const menu = document.getElementById('heroWspMenu');

    if (!wrapper || !trigger || !menu) return;

    function toggleMenu(show?: boolean) {
      const isOpen = wrapper?.classList.contains('open');
      const targetState = typeof show === 'boolean' ? show : !isOpen;

      if (targetState) {
        wrapper?.classList.add('open');
        trigger?.setAttribute('aria-expanded', 'true');
      } else {
        wrapper?.classList.remove('open');
        trigger?.setAttribute('aria-expanded', 'false');
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });
  }

  initHeroWspDropdown();
  document.addEventListener('astro:page-load', initHeroWspDropdown);
</script>

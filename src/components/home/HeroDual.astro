---
import { clinicInfo } from '../../data/clinic';
import { professionals } from '../../data/professionals';
---

<section id="hero" class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-[#F8FAF7] text-[#152219] pt-8 pb-16 lg:pt-12 lg:pb-20 border-b border-[#E5EAE6]">

  <!-- ==============================================
       BACKGROUND: Sunlit Clinic Environment & Soft Botanical Radiance
       ============================================== -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <!-- Subtle natural ambient tints -->
    <div class="absolute -top-32 -left-32 w-[550px] h-[550px] bg-[#134E5E]/[0.06] rounded-full blur-[130px]"></div>
    <div class="absolute -bottom-32 -right-32 w-[600px] h-[600px] bg-[#2E4D38]/[0.08] rounded-full blur-[130px]"></div>
    <!-- Fine architectural grid pattern with low opacity -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000006_1px,transparent_1px),linear-gradient(to_bottom,#00000006_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,#000_60%,transparent_100%)]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center min-h-[75vh]">

      <!-- ==============================================
           LEFT COLUMN: Editorial Copy, Badges & Actions (7 Cols)
           ============================================== -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-7 text-center lg:text-left pt-2 sm:pt-4">

        <!-- Authority Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-[#DCE5DF] shadow-[0_2px_8px_rgba(21,34,25,0.04)]">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-semibold text-[#3D5646] tracking-wide">
            Centro de Salud Integral en Temuco · Acreditados Minsal
          </span>
        </div>

        <!-- Master Editorial Headline -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl xl:text-[4.25rem] font-bold tracking-tight text-[#152219] leading-[1.08]">
          La Precisión de la <br class="hidden sm:inline" />
          <span class="text-petrol relative inline-block">
            Quiropraxia.
          </span>
          <br />
          La Sabiduría de la <br class="hidden sm:inline" />
          <span class="text-sage relative inline-block">
            Acupuntura.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-[#4A5D50] leading-relaxed max-w-xl mx-auto lg:mx-0 font-normal">
          Felipe Méndez y Eduardo Lagos unen corrección biomecánica de columna y medicina tradicional china para eliminar la causa raíz de tu dolor y restaurar tu movilidad en Temuco.
        </p>

        <!-- Dual Discipline Quick Tags -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-1">
          <a
            href="#quiro-section"
            class="btn-press inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[#EBF5F8] border border-[#C2DFE8] hover:bg-[#D9EEF4] text-petrol text-xs font-bold transition-all shadow-sm cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-petrol"></span>
            <span>Quiropraxia &amp; Kinesiología (Felipe)</span>
          </a>
          <a
            href="#acup-section"
            class="btn-press inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[#EEF5F0] border border-[#CCE2D2] hover:bg-[#DEEFE3] text-sage text-xs font-bold transition-all shadow-sm cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-sage"></span>
            <span>Acupuntura &amp; Med. China (Eduardo)</span>
          </a>
        </div>

        <!-- Primary Action Island -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <!-- Button-in-Button Primary Consultation CTA -->
          <a
            href="#contacto"
            class="group btn-press w-full sm:w-auto inline-flex items-center justify-between sm:justify-center gap-3.5 px-7 py-3.5 rounded-full bg-gradient-to-r from-petrol to-sage hover:from-[#175F73] hover:to-[#385F44] text-white text-base font-bold shadow-[0_8px_24px_rgba(19,78,94,0.22)] transition-all cursor-pointer"
          >
            <span>Agendar Evaluación</span>
            <div class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-[1px]">
              <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>

          <!-- Secondary Services CTA -->
          <a
            href="#servicios"
            class="group btn-press w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white hover:bg-[#F2F5F0] text-[#2D3E32] text-sm font-semibold border border-[#D5E0D8] shadow-sm transition-all cursor-pointer"
          >
            <span>Ver Terapias y Valores</span>
            <svg class="w-4 h-4 text-[#6E8576] transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Floating Glass Contact Cards (Refined Double-Bezel) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-3 max-w-xl mx-auto lg:mx-0">

          <!-- Card 1: Dirección y Maps -->
          <a
            href={clinicInfo.address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press p-3.5 rounded-2xl bg-white border border-[#DCE5DF] hover:border-petrol/60 shadow-[0_4px_16px_rgba(21,34,25,0.04)] flex items-center gap-3 transition-all group text-left cursor-pointer"
          >
            <div class="w-10 h-10 rounded-xl bg-[#EBF5F8] text-petrol flex items-center justify-center shrink-0 border border-[#C6DFE8]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-petrol block">
                Ubicación Clínica
              </span>
              <span class="text-xs font-bold text-[#152219] group-hover:text-petrol transition-colors block">
                Los Armiños 1620, Temuco
              </span>
              <span class="text-[10px] text-[#6E8576]">
                Con estacionamiento privado →
              </span>
            </div>
          </a>

          <!-- Card 2: Opiniones Google -->
          <a
            href={clinicInfo.social.googleReviews}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press p-3.5 rounded-2xl bg-white border border-[#DCE5DF] hover:border-sage/60 shadow-[0_4px_16px_rgba(21,34,25,0.04)] flex items-center gap-3 transition-all group text-left cursor-pointer"
          >
            <div class="w-10 h-10 rounded-xl bg-[#EEF5F0] text-sage flex items-center justify-center shrink-0 border border-[#CCE2D2]">
              <svg class="w-5 h-5 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-1 text-amber-500 text-xs">
                <span>★★★★★</span>
                <span class="font-bold text-[#152219] ml-1">5.0</span>
              </div>
              <span class="text-xs font-bold text-[#152219] group-hover:text-sage transition-colors block">
                156+ Reseñas Verificadas
              </span>
              <span class="text-[10px] text-[#6E8576]">
                Leer comentarios de pacientes →
              </span>
            </div>
          </a>

        </div>

      </div>

      <!-- ==============================================
           RIGHT COLUMN: Bright Clinic Sanctuary + Real Duo Cutout (5 Cols)
           ============================================== -->
      <div class="lg:col-span-5 relative flex items-end justify-center lg:justify-end">

        <!-- Outer Double-Bezel Architecture for the Stage -->
        <div class="w-full max-w-[460px] sm:max-w-[500px] lg:max-w-[480px] p-2 sm:p-2.5 rounded-[2.25rem] bg-white/80 border border-[#D4DFD8] shadow-[0_20px_50px_rgba(21,34,25,0.08)] backdrop-blur-xl relative">

          <!-- Inner Stage Enclosure -->
          <div class="relative rounded-[1.75rem] overflow-hidden bg-gradient-to-b from-[#F2F6F3] to-[#E9F0EB] min-h-[440px] sm:min-h-[500px] lg:min-h-[540px] flex items-end justify-center">

            <!-- Background Layer: The Luminous Empty Clinic Interior (Zero People) -->
            <img
              src="/pix/clinic-interior-bright.jpg"
              alt="Instalaciones del Centro Vida Sana Austral en Temuco"
              class="absolute inset-0 w-full h-full object-cover object-center filter brightness-[0.98] contrast-[1.02] scale-[1.02] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Soft bottom gradient so the clinicians blend seamlessly -->
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-white/90 via-white/40 to-transparent pointer-events-none"></div>

            <!-- Foreground: The Real Cutout of Felipe and Eduardo -->
            <div class="relative z-10 w-full flex items-end justify-center pointer-events-none select-none">
              <picture>
                <source srcset="/pix/duo-hd.webp" type="image/webp" />
                <img
                  src="/pix/duo-hd.png"
                  alt="Felipe Méndez y Eduardo Lagos - Centro Vida Sana Austral"
                  class="w-auto h-[380px] sm:h-[430px] lg:h-[470px] object-contain drop-shadow-[0_15px_30px_rgba(21,34,25,0.25)] filter contrast-[1.04]"
                  loading="eager"
                  fetchpriority="high"
                />
              </picture>
            </div>

            <!-- Top Left Floating Chip: Box Privado -->
            <div class="absolute top-3.5 left-3.5 z-20 pointer-events-auto">
              <div class="px-3 py-1.5 rounded-xl bg-white/95 border border-[#D5E0D8] backdrop-blur-md shadow-sm flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[11px] font-bold text-[#203326]">Boxes Climatizados 1 a 1</span>
              </div>
            </div>

            <!-- Bottom Floating Specialist Badges -->
            <div class="absolute bottom-3 inset-x-3 z-20 pointer-events-auto flex gap-2.5">

              <!-- Badge Felipe -->
              <a
                href={`https://wa.me/56973700616?text=${encodeURIComponent(professionals.felipe.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-press flex-1 p-2 rounded-xl bg-white/95 border border-[#C6DFE8] hover:border-petrol shadow-sm flex items-center gap-2.5 text-left transition-all group cursor-pointer"
              >
                <img
                  src={professionals.felipe.photoUrl}
                  alt={professionals.felipe.name}
                  class="w-9 h-9 rounded-lg object-cover border border-[#C6DFE8] group-hover:scale-105 transition-transform shrink-0"
                />
                <div class="min-w-0">
                  <div class="flex items-center gap-1">
                    <span class="text-[11px] font-bold text-petrol block leading-tight truncate">Felipe Méndez</span>
                  </div>
                  <span class="text-[10px] text-[#556D60] block leading-tight truncate">Quiropráctico &amp; Kine</span>
                </div>
              </a>

              <!-- Badge Eduardo -->
              <a
                href={`https://wa.me/56973888910?text=${encodeURIComponent(professionals.eduardo.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-press flex-1 p-2 rounded-xl bg-white/95 border border-[#CCE2D2] hover:border-sage shadow-sm flex items-center gap-2.5 text-left transition-all group cursor-pointer"
              >
                <img
                  src={professionals.eduardo.photoUrl}
                  alt={professionals.eduardo.name}
                  class="w-9 h-9 rounded-lg object-cover border border-[#CCE2D2] group-hover:scale-105 transition-transform shrink-0"
                />
                <div class="min-w-0">
                  <div class="flex items-center gap-1">
                    <span class="text-[11px] font-bold text-sage block leading-tight truncate">Eduardo Lagos</span>
                  </div>
                  <span class="text-[10px] text-[#556D60] block leading-tight truncate">Acupuntura Minsal</span>
                </div>
              </a>

            </div>

          </div>
        </div>

      </div>

    </div>
  </div>

</section>

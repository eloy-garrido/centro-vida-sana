---
// Hero Section - Exact Original Design (Centro Vida Sana Austral)
---

<section class="hero" id="hero">
  <div class="hero-background">
    <!-- Capa de imagen ambiental clara y luminosa -->
    <div class="hero-bg-image" aria-hidden="true">
      <img src="/pix/hero-bg-bright.webp" alt="" class="hero-bg-img" loading="eager" />
      <div class="hero-bg-overlay"></div>
    </div>

    <!-- Fondo decorativo superior -->
    <div class="hero-top-decoration"></div>

    <picture class="leaf-picture">
      <source srcset="/pix/leaf-1-2x.webp" type="image/webp" />
      <img src="/pix/leaf-1-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-1" loading="lazy" width="80" height="80" />
    </picture>
    <picture class="leaf-picture">
      <source srcset="/pix/leaf-2-2x.webp" type="image/webp" />
      <img src="/pix/leaf-2-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-2" loading="lazy" width="80" height="80" />
    </picture>
    <picture class="leaf-picture">
      <source srcset="/pix/leaf-3-2x.webp" type="image/webp" />
      <img src="/pix/leaf-3-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-3" loading="lazy" width="80" height="80" />
    </picture>
    <picture class="leaf-picture">
      <source srcset="/pix/leaf-1-2x.webp" type="image/webp" />
      <img src="/pix/leaf-1-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-4" loading="lazy" width="80" height="80" />
    </picture>
    <picture class="leaf-picture">
      <source srcset="/pix/leaf-2-2x.webp" type="image/webp" />
      <img src="/pix/leaf-2-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-5" loading="lazy" width="80" height="80" />
    </picture>
    <picture class="leaf-picture">
      <source srcset="/pix/leaf-3-2x.webp" type="image/webp" />
      <img src="/pix/leaf-3-2x.webp" alt="Decoración de hoja" class="leaf-float leaf-6" loading="lazy" width="80" height="80" />
    </picture>
  </div>

  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-word-sage">Acupuntura</span>, <span class="hero-word-petrol">Quiropraxia</span> y Kinesiología en <span class="hero-highlight">Temuco</span>
      </h1>
      <p class="hero-subtitle">Vuelve a moverte con <span class="subtitle-serif-accent">libertad</span> y <span class="subtitle-serif-accent">vitalidad</span></p>
      <div class="hero-divider"></div>
      <p class="hero-description">
        Unimos la precisión de la biomecánica con la sabiduría de la medicina tradicional china para devolverle a tu cuerpo su balance natural, sin tratamientos invasivos.
      </p>
      <div class="hero-actions">
        <a href="/reservar" class="btn btn-primary">Reservar Hora en Línea</a>
      </div>
    </div>
  </div>

  <img
    src="/pix/duo-680.webp"
    srcset="/pix/duo-560.webp 560w, /pix/duo-680.webp 680w, /pix/duo-800.webp 800w, /pix/duo.webp 1200w, /pix/duo-hd.webp 2152w"
    sizes="(min-width: 1441px) 1400px, (min-width: 1024px) 1000px, 380px"
    alt="Felipe y Eduardo, profesionales de Centro Vida Sana"
    class="hero-duo"
    loading="eager"
    fetchpriority="high"
    width="680"
    height="617"
  />

  <div class="scroll-indicator">
    <span>Desliza para conocer más</span>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" />
    </svg>
  </div>

  <!-- Botón Agendar Cita: solo visible en móvil, reemplaza el scroll indicator -->
  <a href="/reservar" class="hero-mobile-cta btn btn-primary" aria-label="Reservar hora en línea">Reservar Hora</a>
</section>

<style is:global>
  /* Variables Originales */
  :root {
    --primary-green: #a8c5a0;
    --light-green: #c9d9c3;
    --dark-green: #7a9872;
    --accent-green: #8fb185;
    --text-dark: #2d3e2d;
    --text-light: #f5f5f0;
    --bg-light: #f8faf8;
    --shadow: rgba(122, 152, 114, 0.15);
    --shadow-hover: rgba(122, 152, 114, 0.25);
  }

  /* ============================================
     HERO SECTION - Estilos Originales Exactos
     ============================================ */

  .hero {
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #ffffff;
    overflow: hidden;
    padding: clamp(120px, 15vh, 200px) 0 clamp(100px, 12vh, 140px);
    box-sizing: border-box;
  }

  .hero > .container {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1600px;
    padding: 0 clamp(20px, 5vw, 80px);
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .hero > .container .hero-content {
    flex: 0 0 60%;
    max-width: 60%;
    text-align: left;
    position: relative;
    z-index: 10;
    animation: fadeInUp 0.8s ease-out;
    margin-top: 60px;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    background: url('/pix/pasto.webp') repeat-x bottom;
    background-size: auto 100%;
    pointer-events: none;
    z-index: 5;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Fondo Decorativo Superior */
  .hero-top-decoration {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: clamp(180px, 20vh, 250px);
    background-image: url('/pix/patron-follage.webp');
    background-repeat: repeat-x;
    background-position: top center;
    background-size: auto 100%;
    pointer-events: none;
    z-index: 3;
  }

  .leaf-float {
    position: absolute;
    width: 60px;
    height: auto;
    opacity: 0.5;
    filter: drop-shadow(0 2px 4px rgba(122, 152, 114, 0.3));
    z-index: 2;
    pointer-events: none;
  }

  .leaf-1 {
    top: -10%;
    left: 10%;
    animation: leafFall 20s linear infinite;
    animation-delay: 0s;
  }

  .leaf-2 {
    top: -10%;
    left: 50%;
    width: 50px;
    animation: leafFall 25s linear infinite;
    animation-delay: -8s;
  }

  .leaf-3 {
    top: -10%;
    left: 80%;
    width: 55px;
    animation: leafFall 22s linear infinite;
    animation-delay: -15s;
  }

  .leaf-4 {
    top: -10%;
    left: 25%;
    width: 45px;
    animation: leafFall 28s linear infinite;
    animation-delay: -5s;
  }

  .leaf-5 {
    top: -10%;
    left: 65%;
    width: 58px;
    animation: leafFall 24s linear infinite;
    animation-delay: -12s;
  }

  .leaf-6 {
    top: -10%;
    left: 40%;
    width: 52px;
    animation: leafFall 26s linear infinite;
    animation-delay: -18s;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(44px, 4.5vw, 72px);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 18px;
    line-height: 1.08;
    letter-spacing: -0.5px;
  }

  .hero-word-sage {
    color: #2E4D38;
    display: inline-block;
  }

  .hero-word-petrol {
    color: #134E5E;
    display: inline-block;
  }

  .hero-highlight {
    background: linear-gradient(90deg, #3a7d44, #6aab5e, #3a7d44);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
    padding-right: 0.12em;
    animation: gradientFlow 5s ease-in-out infinite;
    text-shadow: none;
  }

  .hero-subtitle {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 500;
    font-style: italic;
    color: #4D6D47;
    margin-bottom: 15px;
    display: block;
  }

  .hero-subtitle .subtitle-serif-accent {
    font-weight: 700;
    color: var(--dark-green, #2E4D38);
  }

  .hero-divider {
    width: 75px;
    height: 3px;
    background: linear-gradient(90deg, #134E5E 0%, #2E4D38 100%);
    border-radius: 3px;
    margin: 18px 0 25px;
  }

  .hero-description {
    font-size: 18px;
    color: var(--text-dark);
    margin-bottom: 40px;
    max-width: 520px;
    line-height: 1.65;
  }

  .desc-sage {
    color: #2E4D38;
    font-weight: 700;
  }

  .desc-petrol {
    color: #134E5E;
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
    justify-content: flex-start;
    align-items: flex-start;
    flex-direction: row;
    margin-bottom: 50px;
    flex-wrap: wrap;
  }

  .hero-actions .btn {
    width: auto;
  }

  /* Botones Originales */
  .btn {
    border-radius: 50px;
    font-size: 18px;
    font-weight: 600;
    overflow: hidden;
    padding: 16px 40px;
    position: relative;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, #004d20, #007231 40%, #3a7d44 60%, #5a9c55);
    background-size: 300% 300%;
    box-shadow: 0 8px 25px rgba(0, 90, 38, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    color: #fff;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: btnGradient 3s ease infinite;
  }

  @keyframes btnGradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .btn-primary:hover {
    box-shadow: 0 15px 45px rgba(0, 114, 49, 0.5), 0 0 30px rgba(0, 114, 49, 0.2);
    transform: translateY(-4px) scale(1.02);
    animation: none;
    background-position: 100% 50%;
    color: #fff;
  }

  /* Imagen y Textura Ambiental de Fondo */
  .hero-bg-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% center;
    opacity: 0.88;
    filter: saturate(1.05) brightness(1.02);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      rgba(255, 255, 255, 0.92) 24%,
      rgba(255, 255, 255, 0.58) 48%,
      rgba(255, 255, 255, 0.18) 75%,
      rgba(255, 255, 255, 0.05) 100%
    );
  }

  .hero-duo {
    position: absolute;
    bottom: 0;
    right: 0;
    height: clamp(460px, 80vh, 1100px);
    width: auto;
    z-index: 4;
    pointer-events: none;
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.12));
  }

  .scroll-indicator {
    align-items: center;
    animation: bounce 2s infinite;
    backdrop-filter: blur(5px);
    background: hsla(0, 0%, 100%, 0.6);
    border-radius: 30px;
    bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 8px;
    left: 50%;
    padding: 10px 20px;
    position: absolute;
    transform: translateX(-50%);
    z-index: 10;
  }

  .scroll-indicator span {
    color: var(--text-dark);
    font-size: 13px;
    font-weight: 600;
  }

  .scroll-indicator svg {
    color: var(--dark-green);
    height: 22px;
    width: 22px;
  }

  .hero-mobile-cta {
    display: none;
  }

  /* Animaciones Exactas */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes leafFall {
    0% {
      transform: translateY(0) translateX(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    20% {
      transform: translateY(20vh) translateX(30px) rotate(90deg);
    }
    40% {
      transform: translateY(40vh) translateX(-20px) rotate(180deg);
    }
    60% {
      transform: translateY(60vh) translateX(40px) rotate(270deg);
    }
    80% {
      transform: translateY(80vh) translateX(-10px) rotate(360deg);
      opacity: 0.6;
    }
    100% {
      transform: translateY(110vh) translateX(20px) rotate(450deg);
      opacity: 0;
    }
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-10px);
    }
  }

  @keyframes gradientFlow {
    0%   { background-position: 0% center; }
    50%  { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  /* Breakpoints Exactos */
  @media (min-width: 1400px) {
    .hero > .container .hero-content {
      flex: 0 0 44%;
      max-width: 44%;
    }

    .hero-duo {
      height: clamp(780px, 88vh, 1300px);
    }

    .hero > .container {
      max-width: 1800px;
    }

    .hero-top-decoration {
      height: clamp(200px, 18vh, 280px);
    }
  }

  @media (min-width: 2000px) {
    .hero > .container {
      max-width: 2200px;
    }

    .hero-duo {
      height: clamp(900px, 90vh, 1600px);
    }

    .hero-top-decoration {
      height: clamp(200px, 16vh, 280px);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(160px, 19vh, 195px) 20px clamp(220px, 32vh, 320px);
      align-items: flex-start;
    }

    .hero-top-decoration {
      height: clamp(110px, 13vh, 130px);
    }

    .hero-duo {
      display: block;
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      right: auto;
      height: clamp(260px, 40vh, 360px);
      width: auto;
      z-index: 4;
    }

    .hero-bg-img {
      object-position: 50% bottom;
      opacity: 0.82;
    }

    .hero-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.85) 42%,
        rgba(255, 255, 255, 0.30) 75%,
        rgba(255, 255, 255, 0.05) 100%
      );
    }

    .hero > .container .hero-content {
      flex: none;
      width: 100%;
      max-width: 100%;
      text-align: center;
      padding-right: 0;
      margin-top: 0;
    }

    .hero-divider {
      margin-left: auto;
      margin-right: auto;
      margin-top: 12px;
      margin-bottom: 14px;
    }

    /* Ocultar botón dentro del contenido en móvil */
    .hero-actions {
      display: none;
    }

    .hero-title {
      font-size: clamp(28px, 6.8vw, 40px);
      line-height: 1.15;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: clamp(15.5px, 3.6vw, 20px);
      margin-bottom: 12px;
    }

    .hero-description {
      font-size: clamp(14px, 3.1vw, 15.5px);
      margin-bottom: 0;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    .scroll-indicator {
      display: none !important;
    }

    /* Ocultar botón agendar cita en móvil según solicitud: el contacto directo en móvil es el icono de WhatsApp */
    .hero-mobile-cta {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: clamp(145px, 18vh, 180px) 16px clamp(200px, 30vh, 280px);
    }

    .hero-top-decoration {
      height: clamp(100px, 12vh, 120px);
    }

    .hero-title {
      font-size: clamp(26px, 7.2vw, 34px);
      margin-bottom: 10px;
    }

    .hero-subtitle {
      font-size: clamp(14.5px, 3.8vw, 18px);
      margin-bottom: 10px;
    }

    .hero-description {
      font-size: clamp(13.5px, 3.2vw, 15px);
    }
  }
</style>

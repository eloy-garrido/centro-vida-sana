          <div class="relative w-full max-w-[380px] sm:max-w-[420px] lg:max-w-[440px] rounded-[2.5rem] overflow-hidden shadow-[0_20px_50px_rgba(19,78,94,0.2)] border-4 border-white bg-white group">
            <img
              src="/pix/felipe-kinesiologo-800.webp"
              alt="Felipe Méndez - Quiropráctico & Kinesiólogo Certificado Minsal"
              class="w-full h-[440px] sm:h-[500px] lg:h-[530px] object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
              loading="lazy"
            />

            <!-- Chip Flotante de Registro Minsal -->
            <div class="absolute bottom-4 inset-x-4 p-3 rounded-2xl bg-white/95 border border-[#C2DFE8] backdrop-blur-md shadow-soft flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#134E5E] text-white flex items-center justify-center shrink-0 shadow-sm font-serif font-bold text-sm">
                SIS
              </div>
              <div class="min-w-0">
                <span class="text-xs font-bold text-[#134E5E] block truncate">Registro SIS N° 458921</span>
                <span class="text-[11px] text-[#526F77] block truncate">Acreditado Minsal · Quiropraxia</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

</div>

<script>
  // vCard Generation & Download
  function initVCardDownload() {
    document.querySelectorAll('.vcard-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLElement).getAttribute('data-pro');
        let vCardData = '';
        let filename = '';

        if (target === 'felipe') {
          vCardData = `BEGIN:VCARD
VERSION:3.0
FN:Felipe Méndez
ORG:Centro Vida Sana Austral
TITLE:Quiropráctico & Kinesiólogo Minsal
TEL;TYPE=CELL,VOICE:+56973700616
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;La Araucanía;4810000;Chile
URL:https://centrovidasana.cl/
END:VCARD`;
          filename = 'Felipe_Mendez_VidaSana.vcf';
        } else {
          vCardData = `BEGIN:VCARD
VERSION:3.0
FN:Eduardo Lagos
ORG:Centro Vida Sana Austral
TITLE:Acupunturista Clínico Minsal
TEL;TYPE=CELL,VOICE:+56973888910
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;La Araucanía;4810000;Chile
URL:https://centrovidasana.cl/
END:VCARD`;
          filename = 'Eduardo_Lagos_VidaSana.vcf';
        }

        const blob = new Blob([vCardData], { type: 'text/vcard;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      });
    });
  }

  initVCardDownload();
  document.addEventListener('astro:page-load', initVCardDownload);
</script>

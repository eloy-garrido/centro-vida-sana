---
import { professionals } from '../../data/professionals';
import { clinicInfo } from '../../data/clinic';
---

<section id="profesionales" class="py-20 sm:py-24 lg:py-32 bg-[#FBFDFB] relative overflow-hidden">

  <!-- ==============================================
       HALOS Y LUCES AMBIENTALES DE LIENZO ABIERTO
       Fondos sutiles sin bordes que unifican la sección
       ============================================== -->
  <!-- Halo superior izquierdo (Aura botánica Eduardo) -->
  <div class="absolute -top-32 left-0 w-[600px] lg:w-[800px] h-[600px] lg:h-[800px] bg-gradient-to-br from-[#76C993]/15 via-[#3B8253]/08 to-transparent rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Halo inferior derecho (Aura biomecánica Felipe) -->
  <div class="absolute -bottom-32 right-0 w-[600px] lg:w-[800px] h-[600px] lg:h-[800px] bg-gradient-to-tl from-[#4EB8D4]/15 via-[#1D6A7E]/08 to-transparent rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Micro-textura zen de puntos botánicos muy tenue en toda la sección -->
  <div class="absolute inset-0 bg-[radial-gradient(#2E4D38_1px,transparent_1px)] [background-size:32px_32px] opacity-[0.03] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- ==============================================
         CABECERA EDITORIAL
         ============================================== -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#EEF5F0] border border-[#CCE2D2] text-[#2E4D38] text-xs font-bold uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#2E4D38] animate-pulse"></span>
        <span>Acreditación de Salud Oficial · Minsal</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#152219] tracking-tight mb-4">
        Profesionales a tu Cuidado
      </h2>
      <p class="text-base sm:text-lg text-[#44594A] leading-relaxed max-w-2xl mx-auto">
        Atención directa, personalizada y exclusiva en boxes privados. Conoce a los especialistas dedicados a tu recuperación en Centro Vida Sana Austral.
      </p>
    </div>

    <!-- ==============================================
         PERFILES LIBRES (SIN CARDS / LAYOUT EDITORIAL)
         ============================================== -->
    <div class="space-y-24 sm:space-y-32 lg:space-y-40">

      <!-- ==============================================
           1. EDUARDO LAGOS (Acupuntura & Medicina China)
           Diseño Libre · Foto Izquierda · Texto Derecha
           ============================================== -->
      <article id="pro-eduardo" class="relative group">

        <!-- Watermark Yin-Yang Taiji etéreo en el lienzo libre -->
        <div class="absolute -top-12 -right-8 lg:right-4 w-[280px] sm:w-[380px] lg:w-[440px] h-[280px] sm:h-[380px] lg:h-[440px] pointer-events-none select-none opacity-[0.06] group-hover:opacity-[0.10] transition-opacity duration-700">
          <svg viewBox="0 0 200 200" class="w-full h-full animate-[spin_120s_linear_infinite]" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="96" stroke="#2E4D38" stroke-width="1.8" stroke-dasharray="4 4" />
            <circle cx="100" cy="100" r="91" stroke="#2E4D38" stroke-width="1.2" />
            <path d="M100 14A86 86 0 0 1 100 186A43 43 0 0 1 100 100A43 43 0 0 0 100 14Z" fill="#2E4D38" />
            <circle cx="100" cy="57" r="12" fill="#FBFDFB" />
            <circle cx="100" cy="143" r="12" fill="#2E4D38" />
            <circle cx="100" cy="8" r="3" fill="#2E4D38" />
            <circle cx="192" cy="100" r="3" fill="#2E4D38" />
            <circle cx="100" cy="192" r="3" fill="#2E4D38" />
            <circle cx="8" cy="100" r="3" fill="#2E4D38" />
          </svg>
        </div>

        <!-- Curva de meridianos botánica sutil en la esquina inferior izquierda -->
        <div class="absolute bottom-0 left-0 w-[320px] sm:w-[420px] h-[160px] pointer-events-none select-none opacity-[0.08]">
          <svg viewBox="0 0 440 180" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10,160 C90,140 140,80 220,95 C300,110 350,40 430,20" stroke="#2E4D38" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="3 4" />
            <circle cx="70" cy="148" r="5" fill="#2E4D38" />
            <circle cx="180" cy="88" r="5.5" fill="#2E4D38" />
            <circle cx="280" cy="105" r="5" fill="#2E4D38" />
            <circle cx="380" cy="35" r="6" fill="#2E4D38" />
          </svg>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center relative z-10">

          <!-- COLUMNA FOTO LIBRE (Izquierda) -->
          <div class="lg:col-span-5 relative flex items-center justify-center">
            <div class="relative w-full max-w-[400px] sm:max-w-[450px] lg:max-w-[480px] flex items-end justify-center pt-6 pb-2">

              <!-- Halo de ambientación difusa (luz de fondo suave sin bordes rígidos) -->
              <div class="absolute w-[340px] sm:w-[420px] lg:w-[460px] h-[340px] sm:h-[420px] lg:h-[460px] bg-gradient-to-tr from-[#65B77E]/30 via-[#8FE0A8]/25 to-[#38764B]/15 rounded-full blur-[80px] pointer-events-none"></div>

              <!-- Aura botánica orgánica flotante muy sutil -->
              <div class="absolute w-[320px] sm:w-[380px] lg:w-[430px] h-[320px] sm:h-[380px] lg:h-[430px] rounded-[58%_42%_65%_35%/48%_62%_38%_52%] border border-[#2E4D38]/20 -rotate-12 animate-[spin_80s_linear_infinite] pointer-events-none"></div>

              <!-- Forma suave de soporte orgánico (SVG degradado natural suave) -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0 opacity-85">
                <svg viewBox="0 0 500 500" class="w-[320px] sm:w-[390px] lg:w-[440px] h-[320px] sm:h-[390px] lg:h-[440px] filter drop-shadow-[0_20px_35px_rgba(46,77,56,0.12)]" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="blob-eduardo-free" x1="15%" y1="10%" x2="88%" y2="92%">
                      <stop offset="0%" stop-color="#E2F5E7" />
                      <stop offset="50%" stop-color="#80C793" />
                      <stop offset="100%" stop-color="#2E5C39" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M410,305Q370,360,314,405Q258,450,199,416Q140,382,95,326Q50,270,82,203Q114,136,174,93Q234,50,306,75Q378,100,414,175Q450,250,410,305Z"
                    fill="url(#blob-eduardo-free)"
                  />
                </svg>
              </div>

              <!-- Foto Recortada en Composición Libre -->
              <div class="relative z-10 w-full flex justify-center">
                <img
                  src="/pix/eduardo-portrait-hd.webp"
                  srcset="/pix/eduardo-portrait-hd.webp 2x, /pix/eduardo-portrait-hd.webp 1x"
                  alt="Eduardo Lagos - Acupunturista Clínico Certificado Minsal"
                  class="w-full max-w-[360px] sm:max-w-[420px] lg:max-w-[460px] h-auto object-contain drop-shadow-[0_20px_35px_rgba(20,40,25,0.18)] hover:scale-[1.02] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] [mask-image:linear-gradient(to_bottom,black_88%,transparent_100%)]"
                  loading="lazy"
                  width="1240"
                  height="1260"
                />

                <!-- Chip Flotante Minimalista de Acreditación -->
                <div class="absolute bottom-1 left-1/2 -translate-x-1/2 sm:left-0 sm:translate-x-0 p-2.5 sm:p-3 rounded-2xl bg-white/90 border border-[#CCE2D2] backdrop-blur-md shadow-[0_8px_24px_rgba(46,77,56,0.12)] flex items-center gap-2.5 z-20 whitespace-nowrap">
                  <div class="w-8 h-8 rounded-xl bg-[#2E4D38] text-white flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="M9 12l2 2 4-4"/>
                    </svg>
                  </div>
                  <div class="text-left">
                    <span class="text-xs font-bold text-[#2E4D38] block leading-tight">Certificado por Minsal</span>
                    <span class="text-[11px] text-[#556D55] block leading-tight">Acupuntura &amp; Medicina China</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- COLUMNA INFORMACIÓN EDITORIAL (Derecha) -->
          <div class="lg:col-span-7 space-y-6 text-left">

            <!-- Eyebrow Disciplina -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EEF5F0] border border-[#CCE2D2] text-[#2E4D38] text-xs font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#2E4D38]"></span>
              <span>Acupuntura Clínica &amp; Medicina Tradicional China</span>
            </div>

            <!-- Nombre de Gran Autoridad y Títulos -->
            <div>
              <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#152219] tracking-tight leading-tight mb-2">
                Eduardo Lagos
              </h3>
              <p class="text-base sm:text-lg font-bold text-[#2E4D38]">
                Acupunturista Clínico Certificado por Minsal · Docente de MTC
              </p>
              <p class="text-xs sm:text-sm text-[#556D55] font-medium pt-1.5 flex items-center gap-2">
                <svg class="w-4 h-4 text-[#2E4D38] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
                <span>Superintendencia de Salud · Registro SIS Nº 381042 · Temuco</span>
              </p>
            </div>

            <!-- Narrativa Clínica -->
            <p class="text-base sm:text-lg text-[#3E523E] leading-relaxed">
              Especialista en Medicina Tradicional China con más de una década de práctica clínica en Temuco. Eduardo combina técnicas milenarias con neuroacupuntura moderna para el alivio profundo del dolor crónico, fibromialgia, migrañas y trastornos del estrés, regulando el flujo energético y promoviendo la autorrecuperación del organismo de forma natural y sin efectos adversos.
            </p>

            <!-- Especialidades Clínicas (Diseño Abierto, Sin Tarjeta Contenedora Rígida) -->
            <div class="pt-2">
              <h4 class="text-xs font-bold uppercase tracking-wider text-[#2E4D38] mb-3.5 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#2E4D38]"></span>
                <span>Tratamientos y Especialidades de Eduardo:</span>
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm font-semibold text-[#2D3E2D]">
                <!-- 1. Acupuntura Sistémica -->
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/80 border border-[#CCE2D2] hover:border-[#7ABF8C] hover:bg-white hover:shadow-xs transition-all">
                  <div class="w-9 h-9 rounded-xl bg-[#E3F4E8] text-[#2E4D38] flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="19" y1="5" x2="5" y2="19"/>
                      <circle cx="19" cy="5" r="2" fill="currentColor"/>
                      <circle cx="12" cy="12" r="3" stroke-dasharray="2 2" opacity="0.8"/>
                    </svg>
                  </div>
                  <span class="leading-snug">Acupuntura Sistémica &amp; Neuroacupuntura</span>
                </div>
                <!-- 2. Electroacupuntura -->
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/80 border border-[#CCE2D2] hover:border-[#7ABF8C] hover:bg-white hover:shadow-xs transition-all">
                  <div class="w-9 h-9 rounded-xl bg-[#E3F4E8] text-[#2E4D38] flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12h4l2.5-6 4 12 3-8 2.5 4h4" />
                    </svg>
                  </div>
                  <span class="leading-snug">Electroacupuntura para Dolor Rebelde</span>
                </div>
                <!-- 3. Ventosas -->
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/80 border border-[#CCE2D2] hover:border-[#7ABF8C] hover:bg-white hover:shadow-xs transition-all">
                  <div class="w-9 h-9 rounded-xl bg-[#E3F4E8] text-[#2E4D38] flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 5h4M12 5v3M6 18c0-5 2-9 6-9s6 4 6 9M4 18h16"/>
                      <circle cx="12" cy="13" r="1.5" fill="currentColor"/>
                    </svg>
                  </div>
                  <span class="leading-snug">Ventosaterapia Clínica (Cupping)</span>
                </div>
                <!-- 4. Moxibustión -->
                <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/80 border border-[#CCE2D2] hover:border-[#7ABF8C] hover:bg-white hover:shadow-xs transition-all">
                  <div class="w-9 h-9 rounded-xl bg-[#E3F4E8] text-[#2E4D38] flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z" />
                    </svg>
                  </div>
                  <span class="leading-snug">Moxibustión Térmica &amp; Fitoterapia</span>
                </div>
              </div>
            </div>

            <!-- Garantías de Calidad Clínica -->
            <div class="flex flex-wrap items-center gap-5 text-xs font-semibold text-[#44594A] pt-1">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Atención personalizada 1 a 1
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Agujas filiformes estériles desechables
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                Box privado climatizado
              </span>
            </div>

            <!-- Botones de Acción de Eduardo -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
              <a
                href={`https://wa.me/56973888910?text=${encodeURIComponent(professionals.eduardo.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-press flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#2E4D38] hover:bg-[#233C2C] text-white text-sm font-bold shadow-[0_8px_20px_rgba(46,77,56,0.22)] hover:shadow-[0_12px_28px_rgba(46,77,56,0.32)] transition-all cursor-pointer"
              >
                <svg class="w-5 h-5 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>Agendar (+569 7388 8910)</span>
              </a>

              <button
                type="button"
                class="vcard-btn btn-press inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white/90 border border-[#CCE2D2] hover:border-[#2E4D38] text-xs font-bold text-[#2E4D38] hover:bg-[#EEF5F0] transition-all cursor-pointer shadow-xs whitespace-nowrap"
                data-pro="eduardo"
                title="Guardar contacto de Eduardo Lagos en tu teléfono"
              >
                <svg class="w-4 h-4 text-[#2E4D38]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                </svg>
                <span>Guardar contacto</span>
              </button>
            </div>

          </div>

        </div>
      </article>

      <!-- ==============================================
           SEPARADOR ZEN / ORGÁNICO ENTRE ESPECIALISTAS
           Una línea sutil con degradado que respira sin cajas
           ============================================== -->
      <div class="relative py-4 flex items-center justify-center">
        <div class="w-full max-w-4xl h-px bg-gradient-to-r from-transparent via-[#2E4D38]/25 to-transparent"></div>
        <div class="absolute bg-[#FBFDFB] px-4 py-1.5 rounded-full border border-[#CCE2D2]/60 text-[#44594A] text-[11px] font-semibold tracking-widest uppercase flex items-center gap-2 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2E4D38]"></span>
          <span>Sinergia Clínica Integral</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#134E5E]"></span>
        </div>
      </div>

      <!-- ==============================================
           2. FELIPE MÉNDEZ (Quiropraxia & Kinesiología)
           Diseño Libre · Texto Izquierda · Foto Derecha
           ============================================== -->
      <article id="pro-felipe" class="relative group">

        <!-- Watermark Brújula Biomecánica & Columna en el lienzo libre -->
        <div class="absolute -top-12 -left-8 lg:left-4 w-[280px] sm:w-[380px] lg:w-[440px] h-[280px] sm:h-[380px] lg:h-[440px] pointer-events-none select-none opacity-[0.06] group-hover:opacity-[0.10] transition-opacity duration-700">
          <svg viewBox="0 0 320 320" class="w-full h-full animate-[spin_120s_linear_infinite_reverse]" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="160" cy="160" r="150" stroke="#134E5E" stroke-width="1.8" stroke-dasharray="6 6" />
            <circle cx="160" cy="160" r="142" stroke="#134E5E" stroke-width="1.2" />
            <line x1="160" y1="10" x2="160" y2="26" stroke="#134E5E" stroke-width="2" stroke-linecap="round" />
            <line x1="160" y1="294" x2="160" y2="310" stroke="#134E5E" stroke-width="2" stroke-linecap="round" />
            <line x1="10" y1="160" x2="26" y2="160" stroke="#134E5E" stroke-width="2" stroke-linecap="round" />
            <line x1="294" y1="160" x2="310" y2="160" stroke="#134E5E" stroke-width="2" stroke-linecap="round" />
            <circle cx="160" cy="18" r="3.5" fill="#134E5E" />
            <circle cx="160" cy="302" r="3.5" fill="#134E5E" />
            <circle cx="18" cy="160" r="3.5" fill="#134E5E" />
            <circle cx="302" cy="160" r="3.5" fill="#134E5E" />
          </svg>
        </div>

        <!-- Vectores de Movimiento biomecánicos en la esquina inferior derecha -->
        <div class="absolute bottom-0 right-0 w-[300px] sm:w-[380px] h-[160px] pointer-events-none select-none opacity-[0.08]">
          <svg viewBox="0 0 380 160" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10,130 Q190,10 370,110" stroke="#134E5E" stroke-width="2.5" stroke-dasharray="3 4" stroke-linecap="round" />
            <circle cx="190" cy="70" r="5" fill="#134E5E" />
            <line x1="190" y1="50" x2="190" y2="90" stroke="#134E5E" stroke-width="1" stroke-dasharray="2 2" />
            <line x1="170" y1="70" x2="210" y2="70" stroke="#134E5E" stroke-width="1" stroke-dasharray="2 2" />
          </svg>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center relative z-10">

          <!-- COLUMNA INFORMACIÓN EDITORIAL (Izquierda en Desktop) -->
          <div class="lg:col-span-7 space-y-6 text-left order-2 lg:order-1">

            <!-- Eyebrow Disciplina -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EBF5F8] border border-[#C2DFE8] text-[#134E5E] text-xs font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#134E5E]"></span>

---
import { professionals } from '../../data/professionals';
import { clinicInfo } from '../../data/clinic';
---

<section id="profesionales" class="py-20 lg:py-28 bg-canvas-muted/40 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 lg:mb-20">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-ink-muted mb-3">
        Equipo Clínico Acreditado
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-primary tracking-tight mb-4">
        Profesionales a tu Cuidado
      </h2>
      <p class="text-base sm:text-lg text-ink-secondary leading-relaxed">
        Cada paciente recibe atención directa y personalizada de profesionales certificados por el Minsal, combinando ciencia anatómica con sabiduría terapéutica.
      </p>
    </div>

    <!-- Professionals Grid with 3D Tilt -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 max-w-6xl mx-auto">

      <!-- ==============================================
           Felipe Méndez — Quiropraxia & Kinesiología
           ============================================== -->
      <article
        class="pro-tilt-card relative rounded-3xl bg-surface border-2 border-petrol-border p-8 lg:p-10 shadow-soft hover:shadow-petrol-glow transition-all duration-300 flex flex-col justify-between overflow-hidden group"
        data-discipline="quiro"
      >
        <!-- Top discipline bar -->
        <div class="flex items-start justify-between gap-4 mb-6 pb-6 border-b border-surface-border">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-petrol bg-petrol-light border border-petrol-border">
              <span class="w-2 h-2 rounded-full bg-petrol"></span>
              {professionals.felipe.badgeLabel}
            </span>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-petrol block">{professionals.felipe.registrationNumber}</span>
            <span class="text-[11px] text-ink-muted">Superintendencia de Salud</span>
          </div>
        </div>

        <!-- Bio & Profile Header -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-8 text-center sm:text-left">
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-petrol/20 shadow-soft shrink-0">
            <img
              src={professionals.felipe.photoUrl}
              alt={professionals.felipe.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="space-y-1.5">
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary">
              {professionals.felipe.name}
            </h3>
            <p class="text-sm font-bold text-petrol">
              {professionals.felipe.title}
            </p>
            <p class="text-xs text-ink-muted font-medium">
              {professionals.felipe.credential}
            </p>
            <p class="text-sm text-ink-secondary pt-2 leading-relaxed">
              {professionals.felipe.bio}
            </p>
          </div>
        </div>

        <!-- Specialties list -->
        <div class="mb-8 p-5 rounded-2xl bg-canvas border border-surface-border">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink-primary mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-petrol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4"/></svg>
            Áreas de Especialidad:
          </h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-medium text-ink-secondary">
            {professionals.felipe.specialties.map(spec => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-petrol shrink-0"></span>
                <span>{spec}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Action CTAs & vCard -->
        <div class="pt-4 border-t border-surface-border flex flex-col sm:flex-row gap-3">
          <a
            href={`https://wa.me/56973700616?text=${encodeURIComponent(professionals.felipe.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-petrol text-white text-sm font-semibold shadow-soft hover:bg-petrol-hover transition-colors cursor-pointer"
          >
            <span>Consultar con Felipe</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button
            type="button"
            class="vcard-btn btn-press inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-white border border-petrol-border text-xs font-semibold text-petrol hover:bg-petrol-light transition-colors cursor-pointer"
            data-pro="felipe"
            title="Guardar contacto de Felipe Méndez en tu teléfono"
          >
            <svg class="w-4 h-4 text-petrol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Guardar Contacto (.vcf)</span>
          </button>
        </div>
      </article>

      <!-- ==============================================
           Eduardo Lagos — Acupuntura & Med. China
           ============================================== -->
      <article
        class="pro-tilt-card relative rounded-3xl bg-surface border-2 border-sage-border p-8 lg:p-10 shadow-soft hover:shadow-sage-glow transition-all duration-300 flex flex-col justify-between overflow-hidden group"
        data-discipline="acup"
      >
        <!-- Top discipline bar -->
        <div class="flex items-start justify-between gap-4 mb-6 pb-6 border-b border-surface-border">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-sage bg-sage-light border border-sage-border">
              <span class="w-2 h-2 rounded-full bg-sage"></span>
              {professionals.eduardo.badgeLabel}
            </span>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-sage block">{professionals.eduardo.registrationNumber}</span>
            <span class="text-[11px] text-ink-muted">Acreditado Minsal</span>
          </div>
        </div>

        <!-- Bio & Profile Header -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-8 text-center sm:text-left">
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-sage/20 shadow-soft shrink-0">
            <img
              src={professionals.eduardo.photoUrl}
              alt={professionals.eduardo.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="space-y-1.5">
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary">
              {professionals.eduardo.name}
            </h3>
            <p class="text-sm font-bold text-sage">
              {professionals.eduardo.title}
            </p>
            <p class="text-xs text-ink-muted font-medium">
              {professionals.eduardo.credential}
            </p>
            <p class="text-sm text-ink-secondary pt-2 leading-relaxed">
              {professionals.eduardo.bio}
            </p>
          </div>
        </div>

        <!-- Specialties list -->
        <div class="mb-8 p-5 rounded-2xl bg-canvas border border-surface-border">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink-primary mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4"/></svg>
            Áreas de Especialidad:
          </h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-medium text-ink-secondary">
            {professionals.eduardo.specialties.map(spec => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-sage shrink-0"></span>
                <span>{spec}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Action CTAs & vCard -->
        <div class="pt-4 border-t border-surface-border flex flex-col sm:flex-row gap-3">
          <a
            href={`https://wa.me/56973888910?text=${encodeURIComponent(professionals.eduardo.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-sage text-white text-sm font-semibold shadow-soft hover:bg-sage-hover transition-colors cursor-pointer"
          >
            <span>Consultar con Eduardo</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button
            type="button"
            class="vcard-btn btn-press inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-white border border-sage-border text-xs font-semibold text-sage hover:bg-sage-light transition-colors cursor-pointer"
            data-pro="eduardo"
            title="Guardar contacto de Eduardo Lagos en tu teléfono"
          >
            <svg class="w-4 h-4 text-sage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>Guardar Contacto (.vcf)</span>
          </button>
        </div>
      </article>

    </div>

  </div>
</section>

<script>
  // 3D Tilt Physics (Emil Kowalski style: clamped, smooth, specular highlight)
  const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!isTouchDevice && !prefersReducedMotion) {
    const cards = document.querySelectorAll<HTMLElement>('.pro-tilt-card');

    cards.forEach(card => {
      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        // Max rotation clamped to ±5 degrees for subtlety and elegance
        const rotateX = ((y - centerY) / centerY) * -5;
        const rotateY = ((x - centerX) / centerX) * 5;

        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        card.style.transition = 'transform 0.1s ease-out';
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
        card.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
      });
    });
  }

  // vCard Generation & Download
  document.querySelectorAll('.vcard-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = (e.currentTarget as HTMLElement).getAttribute('data-pro');
      let vCardData = '';
      let filename = '';

      if (target === 'felipe') {
        vCardData = `BEGIN:VCARD
VERSION:3.0
FN:Felipe Méndez
ORG:Centro Vida Sana Austral
TITLE:Quiropráctico & Kinesiólogo Minsal
TEL;TYPE=CELL,VOICE:+56973700616
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;La Araucanía;4810000;Chile
URL:https://centrovidasana.cl/
END:VCARD`;
        filename = 'Felipe_Mendez_VidaSana.vcf';
      } else {
        vCardData = `BEGIN:VCARD
VERSION:3.0
FN:Eduardo Lagos
ORG:Centro Vida Sana Austral
TITLE:Acupunturista Clínico Minsal
TEL;TYPE=CELL,VOICE:+56973888910
ADR;TYPE=WORK:;;Los Armiños 1620;Temuco;La Araucanía;4810000;Chile
URL:https://centrovidasana.cl/
END:VCARD`;
        filename = 'Eduardo_Lagos_VidaSana.vcf';
      }

      const blob = new Blob([vCardData], { type: 'text/vcard;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  });
</script>

---
import { professionals } from '../../data/professionals';
---

<section id="academia" class="py-16 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-gradient-to-br from-[#1C3B29] to-[#0E2417] text-white p-8 sm:p-12 lg:p-14 relative overflow-hidden shadow-soft-lg border border-[#2D543B]">

      <!-- Decorative ambient glow -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-sage-accent/20 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">

        <!-- Text info -->
        <div class="lg:col-span-8 space-y-4 text-center lg:text-left">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/10 text-sage-light border border-white/20">
            Formación Continua en Temuco
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white leading-snug">
            Estudia con Nosotros: Fundamentos de Medicina Tradicional China
          </h2>
          <p class="text-sm sm:text-base text-[#C2D6C7] leading-relaxed max-w-2xl">
            Curso teórico-práctico presencial impartido por <strong>Eduardo Lagos</strong>. Aprende teoría Yin-Yang, los 5 elementos, meridianos principales y técnicas básicas de auriculoterapia y ventosas para terapeutas y público general.
          </p>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2 text-xs text-[#A8C8B1]">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Clases prácticas en Temuco
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Material bibliográfico incluido
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Certificado de participación
            </span>
          </div>
        </div>

        <!-- Instructor Badge & CTA -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm text-center">
          <div class="w-20 h-20 rounded-2xl overflow-hidden border-2 border-sage-light/30 shadow-soft mb-3">
            <img
              src="/pix/eduardo-instructor-560.webp"
              alt="Eduardo Lagos Instructor"
              class="w-full h-full object-cover"
            />
          </div>
          <span class="font-serif font-bold text-base text-white">Eduardo Lagos</span>
          <span class="text-xs text-sage-light mb-4">Instructor Titular MTC</span>

          <a
            href="https://wa.me/56973888910?text=Hola%20Eduardo,%20quisiera%20recibir%20el%20programa%20y%20fechas%20del%20Curso%20de%20Medicina%20Tradicional%20China."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press w-full py-3 px-4 rounded-xl bg-sage-light text-sage-900 font-bold text-xs hover:bg-white transition-colors cursor-pointer"
          >
            Solicitar Programa y Fechas
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

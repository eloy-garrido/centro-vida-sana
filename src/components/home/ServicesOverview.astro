---
import { servicesData } from '../../data/services';
import { professionals } from '../../data/professionals';
---

<section id="servicios" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-ink-muted mb-3">
        Catálogo Terapéutico
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-primary tracking-tight mb-4">
        Terapias Clínicas y Tratamientos
      </h2>
      <p class="text-base sm:text-lg text-ink-secondary leading-relaxed">
        Precios transparentes, duración estimada e indicaciones claras para cada uno de nuestros tratamientos.
      </p>
    </div>

    <!-- Interactive Tab Selector -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex p-1.5 rounded-2xl bg-surface border border-surface-border shadow-soft flex-wrap gap-1" role="tablist">
        <button
          type="button"
          class="svc-tab-btn active px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer bg-ink-primary text-white shadow-soft-sm"
          data-filter="all"
        >
          <span>Todas las Terapias ({servicesData.length})</span>
        </button>
        <button
          type="button"
          class="svc-tab-btn px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-ink-secondary hover:text-petrol transition-all duration-200 cursor-pointer flex items-center gap-1.5"
          data-filter="quiropraxia"
        >
          <span class="w-2 h-2 rounded-full bg-petrol"></span>
          <span>Quiropraxia &amp; Kine</span>
        </button>
        <button
          type="button"
          class="svc-tab-btn px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-ink-secondary hover:text-sage transition-all duration-200 cursor-pointer flex items-center gap-1.5"
          data-filter="acupuntura"
        >
          <span class="w-2 h-2 rounded-full bg-sage"></span>
          <span>Acupuntura &amp; MTC</span>
        </button>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="services-grid">
      {servicesData.map(service => {
        const isQuiro = service.discipline === 'quiropraxia';
        const pro = isQuiro ? professionals.felipe : professionals.eduardo;
        const borderClass = isQuiro ? 'hover:border-petrol/60' : 'hover:border-sage/60';
        const badgeColorClass = isQuiro ? 'text-petrol bg-petrol-light border-petrol-border' : 'text-sage bg-sage-light border-sage-border';
        const priceColorClass = isQuiro ? 'text-petrol' : 'text-sage';
        const btnBgClass = isQuiro ? 'bg-petrol hover:bg-petrol-hover' : 'bg-sage hover:bg-sage-hover';

        return (
          <article
            class={`svc-item-card rounded-2xl bg-surface border border-surface-border p-6 shadow-soft ${borderClass} transition-all duration-300 flex flex-col justify-between group`}
            data-discipline={service.discipline}
          >
            <div>
              <!-- Image Preview Header -->
              <div class="relative w-full h-44 rounded-xl overflow-hidden mb-5 bg-canvas-muted">
                <img
                  src={service.imageUrl}
                  alt={service.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-3 left-3 flex gap-1.5 flex-wrap">
                  <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider border shadow-soft-sm ${badgeColorClass}`}>
                    {isQuiro ? 'Quiro & Kine' : 'Acupuntura'}
                  </span>
                </div>
                <div class="absolute bottom-3 right-3 px-2.5 py-1 rounded-md text-xs font-bold bg-white/95 text-ink-primary shadow-soft-sm">
                  {service.duration}
                </div>
              </div>

              <!-- Content -->
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-serif text-xl font-bold text-ink-primary leading-snug group-hover:text-ink-primary transition-colors">
                  {service.name}
                </h3>
                <span class={`text-base font-bold shrink-0 ${priceColorClass}`}>
                  {service.priceRef}
                </span>
              </div>

              <p class="text-xs text-ink-secondary mb-4 leading-relaxed">
                {service.summary}
              </p>

              <!-- Indicación clínica -->
              <div class="p-3 rounded-xl bg-canvas border border-surface-border/80 text-xs mb-5">
                <span class="font-semibold text-ink-primary block mb-0.5">Indicado para:</span>
                <span class="text-ink-secondary">{service.indication}</span>
              </div>
            </div>

            <!-- Footer & WhatsApp Booking -->
            <div class="pt-4 border-t border-surface-border flex items-center justify-between gap-3">
              <span class="text-xs text-ink-muted flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${pro.accentColor}`}></span>
                <span>{pro.name}</span>
              </span>

              <a
                href={`https://wa.me/${pro.phone.replace('+', '')}?text=${encodeURIComponent(`Hola ${pro.name}, quisiera consultar por el tratamiento de ${service.name} en Centro Vida Sana Austral.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`btn-press inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold text-white ${btnBgClass} shadow-soft-sm transition-colors cursor-pointer`}
              >
                <span>Consultar</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<script>
  // Services Dynamic Filter Tab Logic
  const filterBtns = document.querySelectorAll('.svc-tab-btn');
  const cards = document.querySelectorAll<HTMLElement>('.svc-item-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-ink-primary', 'text-white', 'shadow-soft-sm');
        b.classList.add('text-ink-secondary');
      });

      btn.classList.add('active', 'bg-ink-primary', 'text-white', 'shadow-soft-sm');
      btn.classList.remove('text-ink-secondary');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const disc = card.getAttribute('data-discipline');
        if (filter === 'all' || disc === filter) {
          card.style.display = 'flex';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.97)';
          requestAnimationFrame(() => {
            card.style.transition = 'opacity 0.25s ease-out, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          });
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

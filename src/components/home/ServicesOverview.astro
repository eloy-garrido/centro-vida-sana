---
import { professionals } from '../../data/professionals';
import { servicesData } from '../../data/services';

const quiroFeatured = servicesData.filter(s => s.discipline === 'quiropraxia').slice(0, 3);
const acupFeatured = servicesData.filter(s => s.discipline === 'acupuntura').slice(0, 3);
---

<section id="servicios" class="py-20 lg:py-28 bg-[#FBFDFB] text-[#152219] relative">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Encabezado Editorial de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#4A6B53] mb-3">
        Especialidades Clínicas · Boxes Individuales
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#152219] mb-4">
        Servicios Profesionales de Salud
      </h2>
      <p class="text-base sm:text-lg text-[#556D5B] leading-relaxed">
        Dos disciplinas complementarias orientadas a resolver la causa raíz de tu dolor en Temuco. Elige el área de tu interés para conocer los tratamientos y agendar tu sesión.
      </p>
    </div>


    <!-- =====================================================================
         ÁREA 1: FELIPE MÉNDEZ · QUIROPRAXIA & KINESIOLOGÍA
         Identidad: Azul Petróleo Clásico (#134E5E)
         ===================================================================== -->
    <div id="quiro-section" class="scroll-mt-24">

      <!-- Cabecera Horizontal Editorial con Textura Sutil -->
      <div class="relative rounded-2xl bg-gradient-to-r from-[#F0F6F8] via-[#E3EFF3] to-[#F2F7F9] border border-[#CDE1E8] p-6 sm:p-8 mb-8 overflow-hidden">
        
        <!-- Textura Vectorial Sutil de Fondo -->
        <svg class="absolute right-0 top-0 bottom-0 w-1/2 h-full pointer-events-none opacity-[0.08]" viewBox="0 0 600 200" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,100 C150,20 300,180 450,80 C520,30 560,120 600,100" stroke="#134E5E" stroke-width="2" />
          <path d="M0,130 C170,50 320,210 470,110 C540,60 580,150 600,130" stroke="#134E5E" stroke-width="2" stroke-dasharray="6 6" />
          <circle cx="200" cy="60" r="8" fill="#134E5E" />
          <circle cx="450" cy="80" r="10" stroke="#134E5E" stroke-width="2" />
        </svg>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="flex items-start sm:items-center gap-4">
            <img
              src="/pix/felipe-kinesiologo-400.webp"
              alt="Felipe Méndez"
              class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover object-top border-2 border-[#134E5E] shadow-sm shrink-0"
              loading="lazy"
            />
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#134E5E] block mb-0.5">
                Área Biomecánica &amp; Columna
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#0B2B33]">
                Quiropraxia &amp; Kinesiología
              </h3>
              <p class="text-xs sm:text-sm text-[#46656E] mt-0.5">
                Felipe Méndez · Kinesiólogo &amp; Quiropráctico Clínico · Reg. SIS N° 458921
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/quiropraxia"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-[#EBF5F8] text-[#134E5E] border-2 border-[#134E5E] text-xs sm:text-sm font-bold shadow-sm transition-all shrink-0 cursor-pointer"
            >
              <span>Ver Página de Quiropraxia (6 Tratamientos)</span>
              <span>→</span>
            </a>
            <a
              href={`https://wa.me/56973700616?text=${encodeURIComponent('Hola Felipe, me interesa consultar por una evaluación de Quiropraxia y Kinesiología.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#134E5E] hover:bg-[#0E3B47] text-white text-xs sm:text-sm font-bold shadow-sm transition-all shrink-0 cursor-pointer"
            >
              <svg class="w-4 h-4 text-cyan-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Consultar a Felipe</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Grid Destacado de 3 Tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
        {quiroFeatured.map((svc) => (
          <a
            href={`https://wa.me/56973700616?text=${encodeURIComponent(`Hola Felipe, me interesa agendar una consulta de ${svc.name}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden border border-[#D8E6EB] hover:border-[#134E5E] hover:shadow-[0_12px_32px_rgba(19,78,94,0.10)] transition-all duration-300 flex flex-col justify-between cursor-pointer"
          >
            <div>
              <div class="relative aspect-[16/10] overflow-hidden bg-[#F0F6F8]">
                <img
                  src={svc.imageUrl}
                  alt={svc.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/90 backdrop-blur-sm text-[#134E5E] shadow-sm">
                  {svc.duration}
                </span>
              </div>

              <div class="p-5 sm:p-6">
                <div class="flex items-baseline justify-between gap-2 mb-2">
                  <h4 class="font-serif text-lg font-bold text-[#0B2B33] group-hover:text-[#134E5E] transition-colors leading-snug">
                    {svc.name}
                  </h4>
                  <span class="text-base font-bold text-[#134E5E] shrink-0 font-sans">
                    {svc.priceRef}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-[#526F77] leading-relaxed line-clamp-2">
                  {svc.summary}
                </p>
              </div>
            </div>

            <div class="px-5 sm:px-6 pb-5 pt-0 flex items-center justify-between text-xs font-semibold text-[#134E5E]">
              <span class="text-[#7A98A2] font-normal">Box Quiropraxia</span>
              <span class="inline-flex items-center gap-1 font-bold group-hover:translate-x-1 transition-transform">
                <span>Agendar</span>
                <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Enlace a la sección completa -->
      <div class="mt-6 text-center">
        <a
          href="/quiropraxia"
          class="inline-flex items-center gap-2 text-sm font-bold text-[#134E5E] hover:text-[#0B2B33] hover:underline underline-offset-4 transition-colors"
        >
          <span>Conoce los 6 tratamientos, técnica y detalles de Quiropraxia en Temuco</span>
          <span class="text-base">→</span>
        </a>
      </div>

    </div>


    <!-- =====================================================================
         ÁREA 2: EDUARDO LAGOS · ACUPUNTURA & MEDICINA TRADICIONAL CHINA
         Identidad: Verde Salvia Botánico (#2E4D38)
         ===================================================================== -->
    <div id="acup-section" class="mt-20 sm:mt-24 scroll-mt-24">

      <!-- Cabecera Horizontal Editorial con Textura Sutil -->
      <div class="relative rounded-2xl bg-gradient-to-r from-[#F0F6F2] via-[#E3EEE6] to-[#F3F7F4] border border-[#CCDED1] p-6 sm:p-8 mb-8 overflow-hidden">
        
        <!-- Textura Vectorial Sutil de Fondo -->
        <svg class="absolute right-0 top-0 bottom-0 w-1/2 h-full pointer-events-none opacity-[0.08]" viewBox="0 0 600 200" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,80 C150,170 300,10 450,120 C520,180 560,70 600,90" stroke="#2E4D38" stroke-width="2" />
          <path d="M0,110 C170,200 320,40 470,150 C540,210 580,100 600,120" stroke="#2E4D38" stroke-width="2" stroke-dasharray="8 6" />
          <circle cx="250" cy="110" r="8" fill="#2E4D38" />
          <circle cx="480" cy="140" r="10" stroke="#2E4D38" stroke-width="2" />
        </svg>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="flex items-start sm:items-center gap-4">
            <img
              src="/pix/eduardo-acupuntura-400.webp"
              alt="Eduardo Lagos"
              class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover object-top border-2 border-[#2E4D38] shadow-sm shrink-0"
              loading="lazy"
            />
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#2E4D38] block mb-0.5">
                Área Acupuntura &amp; Medicina China
              </span>
              <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[#15281D]">
                Acupuntura &amp; Medicina Tradicional China
              </h3>
              <p class="text-xs sm:text-sm text-[#4E6B56] mt-0.5">
                Eduardo Lagos · Acupunturista Clínico Minsal · Reg. SIS N° 381042
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/acupuntura"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-[#EEF5F0] text-[#2E4D38] border-2 border-[#2E4D38] text-xs sm:text-sm font-bold shadow-sm transition-all shrink-0 cursor-pointer"
            >
              <span>Ver Página de Acupuntura (6 Terapias MTC)</span>
              <span>→</span>
            </a>
            <a
              href={`https://wa.me/56973888910?text=${encodeURIComponent('Hola Eduardo, me interesa consultar por una sesión de Acupuntura y Medicina Tradicional China.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-press inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#2E4D38] hover:bg-[#233C2C] text-white text-xs sm:text-sm font-bold shadow-sm transition-all shrink-0 cursor-pointer"
            >
              <svg class="w-4 h-4 text-emerald-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Consultar a Eduardo</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Grid Destacado de 3 Tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
        {acupFeatured.map((svc) => (
          <a
            href={`https://wa.me/56973888910?text=${encodeURIComponent(`Hola Eduardo, me interesa agendar una sesión de ${svc.name}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden border border-[#D3E3D6] hover:border-[#2E4D38] hover:shadow-[0_12px_32px_rgba(46,77,56,0.10)] transition-all duration-300 flex flex-col justify-between cursor-pointer"
          >
            <div>
              <div class="relative aspect-[16/10] overflow-hidden bg-[#F2F7F3]">
                <img
                  src={svc.imageUrl}
                  alt={svc.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/90 backdrop-blur-sm text-[#2E4D38] shadow-sm">
                  {svc.duration}
                </span>
              </div>

              <div class="p-5 sm:p-6">
                <div class="flex items-baseline justify-between gap-2 mb-2">
                  <h4 class="font-serif text-lg font-bold text-[#15281D] group-hover:text-[#2E4D38] transition-colors leading-snug">
                    {svc.name}
                  </h4>
                  <span class="text-base font-bold text-[#2E4D38] shrink-0 font-sans">
                    {svc.priceRef}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-[#556D55] leading-relaxed line-clamp-2">
                  {svc.summary}
                </p>
              </div>
            </div>

            <div class="px-5 sm:px-6 pb-5 pt-0 flex items-center justify-between text-xs font-semibold text-[#2E4D38]">
              <span class="text-[#7A9680] font-normal">Box Acupuntura</span>
              <span class="inline-flex items-center gap-1 font-bold group-hover:translate-x-1 transition-transform">
                <span>Agendar</span>
                <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Enlace a la sección completa -->
      <div class="mt-6 text-center">
        <a
          href="/acupuntura"
          class="inline-flex items-center gap-2 text-sm font-bold text-[#2E4D38] hover:text-[#15281D] hover:underline underline-offset-4 transition-colors"
        >
          <span>Conoce las 6 terapias de Medicina China, acreditación Minsal y detalles en Temuco</span>
          <span class="text-base">→</span>
        </a>
      </div>

    </div>

  </div>
</section>

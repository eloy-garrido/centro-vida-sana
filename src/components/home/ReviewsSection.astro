---
import { reviewsData } from '../../data/reviews';
import { clinicInfo } from '../../data/clinic';
---

<section id="resenas" class="py-20 lg:py-28 bg-canvas-muted/40 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 text-amber-500 mb-3 text-lg">
        <span>★★★★★</span>
        <span class="text-xs font-bold text-ink-primary ml-1.5 px-2 py-0.5 rounded-md bg-amber-500/10 border border-amber-500/20">
          5.0 de 5 Estrellas
        </span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-primary tracking-tight mb-4">
        La Experiencia de Nuestros Pacientes
      </h2>
      <p class="text-base text-ink-secondary leading-relaxed">
        Opiniones reales verificadas en Google Maps de personas en Temuco que recuperaron su bienestar y movilidad con nosotros.
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto mb-12">
      {reviewsData.map(rev => (
        <div class="rounded-2xl bg-surface border border-surface-border p-6 shadow-soft flex flex-col justify-between hover:shadow-soft-lg transition-all duration-300">
          <div>
            <div class="flex items-center justify-between text-xs text-ink-muted mb-3">
              <span class="text-amber-500 font-bold">★★★★★</span>
              <span>{rev.date}</span>
            </div>
            <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed mb-6 italic">
              "{rev.text}"
            </p>
          </div>
          <div class="pt-4 border-t border-surface-border">
            <span class="font-serif text-sm font-bold text-ink-primary block">
              {rev.author}
            </span>
            <span class="text-[11px] text-ink-muted">
              {rev.service}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Reviews Callout -->
    <div class="text-center">
      <a
        href={clinicInfo.social.googleReviews}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-surface border border-surface-border hover:border-ink-muted shadow-soft text-xs sm:text-sm font-semibold text-ink-primary cursor-pointer transition-all"
      >
        <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>Ver todas las 156+ opiniones en Google Maps</span>
        <svg class="w-4 h-4 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
      </a>
    </div>

  </div>
</section>

---
// PathologiesGuide.astro - Sección Condiciones de Salud en Temuco
import { pathologiesData } from '../../data/pathologies';
---

<section
  id="patologias"
  class="pathologies-section relative z-10 scroll-mt-20 overflow-hidden"
  aria-label="Condiciones de salud que tratamos en Temuco"
>
  <!-- Ola superior orgánica de transición desde la sección anterior -->
  <div class="w-full overflow-hidden leading-none relative z-10 -mt-[1px] select-none pointer-events-none">
    <svg
      class="w-full h-10 sm:h-14 md:h-18 lg:h-20 block"
      viewBox="0 0 1440 90"
      fill="none"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,0 L1440,0 L1440,40 C1200,80 960,15 720,50 C480,85 240,20 0,60 Z"
        fill="#FBFDFB"
      />
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-20 sm:pb-28 relative z-20">

    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#1e6f40] bg-[#c2edd9]/60 px-3.5 py-1 rounded-full mb-3.5 border border-[#1e6f40]/15">
        Enfoque Terapéutico Integral
      </span>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1a3a2a] tracking-tight mb-4 leading-tight">
        Condiciones de <span class="text-[#007231]">Salud</span> que Tratamos en Temuco
      </h2>
      <p class="text-base sm:text-lg text-[#2d5a45] leading-relaxed max-w-2xl mx-auto font-normal">
        Nuestros especialistas en <strong class="text-[#007231] font-bold">acupuntura</strong>, <strong class="text-[#007231] font-bold">quiropraxia</strong> y <strong class="text-[#007231] font-bold">kinesiología</strong> en Temuco abordan una amplia variedad de condiciones musculoesqueléticas, dolor crónico y lesiones con un enfoque natural e integral.
      </p>
    </div>

    <!-- Grilla de Tarjetas (3 Columnas en Desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7 items-stretch">
      {pathologiesData.map((item) => {
        const waUrl = `https://wa.me/${item.phone.replace('+', '')}?text=${encodeURIComponent(item.whatsappMessage)}`;

        return (
          <article
            class="pathology-item group"
            itemscope
            itemtype="https://schema.org/MedicalCondition"
          >
            <!-- Enlace interactivo en toda la tarjeta -->
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pathology-link"
              aria-label={`Consultar por ${item.name} por WhatsApp`}
            >
              <!-- Marca de agua decorativa del logo brote / yin-yang -->
              <img
                src="/pix/logo-sin-texto-360.webp"
                alt=""
                class="pathology-logo-deco"
                aria-hidden="true"
                loading="lazy"
                width="180"
                height="180"
              />

              <!-- Contenido principal -->
              <div class="pathology-body">
                <div>
                  <h3 class="pathology-title" itemprop="name">
                    {item.name}
                  </h3>
                  <p class="pathology-desc" itemprop="description">
                    {item.description}
                  </p>
                </div>

                <!-- Tags de tratamiento con micro-indicador de acción -->
                <div class="pathology-footer-row">
                  <div class="treatment-tags" aria-label="Tratamientos recomendados">
                    {item.treatments.map((t) => (
                      <span class={`tag tag-${t.type}`}>
                        {t.label}
                      </span>
                    ))}
                  </div>

                  <!-- Indicador de acción sutil al hover -->
                  <div class="action-hint" aria-hidden="true">
                    <span>Consultar</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>

    <!-- Banner Inferior de Consulta Empática -->
    <div class="pathologies-footer">
      <div class="pathologies-footer-inner">
        <!-- Ícono de información / orientación médica -->
        <div class="pathologies-footer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
          </svg>
        </div>

        <!-- Texto explicativo -->
        <div class="pathologies-footer-text">
          <p>
            <strong>¿Tu condición no está en la lista?</strong>
            Tratamos muchas más patologías. Escríbenos y te orientamos sin costo.
          </p>
        </div>

        <!-- Botón de acción WhatsApp -->
        <a
          href="https://wa.me/56973700616?text=Hola,%20quisiera%20consultar%20por%20una%20condici%C3%B3n%20que%20no%20aparece%20en%20la%20lista%20de%20patolog%C3%ADas."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta pathologies-footer-btn"
        >
          <span>Consultar ahora</span>
          <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

  <!-- Ola inferior orgánica de transición hacia la siguiente sección -->
  <div class="w-full overflow-hidden leading-none relative z-10 -mb-[1px] select-none pointer-events-none">
    <svg
      class="w-full h-10 sm:h-14 md:h-18 lg:h-20 block"
      viewBox="0 0 1440 90"
      fill="none"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,50 C240,15 480,80 720,40 C960,5 1200,65 1440,30 L1440,90 L0,90 Z"
        fill="#F8F9F6"
      />
    </svg>
  </div>
</section>

<style>
  /* =====================================================================
     SECCIÓN PATOLOGÍAS - ESTILO ORGÁNICO BOTÁNICO CON FÍSICA ARTESANAL
     ===================================================================== */

  .pathologies-section {
    background-color: #d3f6e8;
  }

  /* ---- Tarjeta Individual ---- */
  .pathology-item {
    background: #ffffff;
    border-radius: 22px;
    border: 2px solid rgba(0, 114, 49, 0.08);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.38s ease,
      border-color 0.3s ease;
  }

  /* Silueta del pasto que emerge desde abajo en hover */
  .pathology-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background-image: url('/pix/pasto.webp');
    background-repeat: repeat-x;
    background-position: bottom center;
    background-size: auto 100px;
    opacity: 0.18;
    pointer-events: none;
    transform: translateY(48px);
    transition:
      transform 0.6s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.45s ease;
    z-index: 1;
  }

  .pathology-item:hover {
    transform: translateY(-9px) scale(1.015);
    box-shadow:
      0 20px 48px -10px rgba(0, 114, 49, 0.18),
      0 8px 16px -4px rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 114, 49, 0.28);
  }

  .pathology-item:hover::after {
    transform: translateY(0);
    opacity: 0.55;
  }

  /* Enlace contenedor */
  .pathology-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 32px 28px 24px;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 2;
  }

  /* Logo decorativo en marca de agua */
  .pathology-logo-deco {
    position: absolute;
    top: 50%;
    right: -36px;
    width: 175px;
    height: 175px;
    object-fit: contain;
    opacity: 0.07;
    pointer-events: none;
    z-index: 1;
    transform: translateY(-50%);
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.35s ease;
    filter: saturate(0.4) brightness(0.85);
  }

  .pathology-item:hover .pathology-logo-deco {
    transform: translateY(-50%) scale(1.12);
    opacity: 0.18;
  }

  /* Contenido interno */
  .pathology-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .pathology-title {
    font-size: 19.5px;
    font-weight: 700;
    color: #1a3a2a;
    margin: 0 0 10px;
    line-height: 1.32;
    transition: color 0.3s ease;
  }

  .pathology-item:hover .pathology-title {
    color: #007231;
  }

  .pathology-desc {
    font-size: 14.5px;
    color: #415a4b;
    line-height: 1.62;
    margin: 0 0 20px;
    font-weight: 400;
  }

  /* Fila inferior con tags y micro-acción */
  .pathology-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }

  /* Treatment Tags */
  .treatment-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 600;
    padding: 3.5px 11px;
    border-radius: 9999px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: transform 0.2s ease;
  }

  .tag-kine {
    background: #dcf5e7;
    color: #1a6b3a;
    border: 1px solid rgba(26, 107, 58, 0.18);
  }

  .tag-quiro {
    background: #d0eff5;
    color: #0e6680;
    border: 1px solid rgba(14, 102, 128, 0.18);
  }

  .tag-acu {
    background: #fef5d7;
    color: #8a6200;
    border: 1px solid rgba(138, 98, 0, 0.18);
  }

  /* Micro indicador de acción que aparece al hover */
  .action-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    color: #007231;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
  }

  .pathology-item:hover .action-hint {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- Banner Footer Inferior ---- */
  .pathologies-footer {
    margin-top: 56px;
    position: relative;
    z-index: 2;
  }

  .pathologies-footer-inner {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(211, 246, 232, 0.55));
    border: 2px solid rgba(0, 114, 49, 0.12);
    border-radius: 24px;
    padding: 30px 38px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 640px) {
    .pathologies-footer-inner {
      flex-direction: row;
      gap: 24px;
    }
  }

  .pathologies-footer-inner::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 90px;
    background-image: url('/pix/pasto.webp');
    background-repeat: repeat-x;
    background-position: bottom center;
    background-size: auto 90px;
    opacity: 0.18;
    pointer-events: none;
    transform: translateY(45px);
    transition:
      transform 0.6s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.45s ease;
    z-index: 0;
  }

  .pathologies-footer-inner:hover::after {
    transform: translateY(0);
    opacity: 0.52;
  }

  .pathologies-footer-icon,
  .pathologies-footer-text,
  .pathologies-footer-btn {
    position: relative;
    z-index: 2;
  }

  .pathologies-footer-icon {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #007231, #1e6f40);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(0, 114, 49, 0.25);
  }

  .pathologies-footer-icon svg {
    width: 26px;
    height: 26px;
    color: #ffffff;
  }

  .pathologies-footer-text {
    flex: 1;
    font-size: 15.5px;
    color: #2d5a45;
    margin: 0;
    line-height: 1.5;
    text-align: center;
  }

  @media (min-width: 640px) {
    .pathologies-footer-text {
      text-align: left;
    }
  }

  .pathologies-footer-text strong {
    color: #1a3a2a;
    display: block;
    font-size: 17.5px;
    margin-bottom: 3px;
    font-weight: 700;
  }

  .pathologies-footer-btn {
    flex-shrink: 0;
    white-space: nowrap;
    background: linear-gradient(135deg, #005a26, #1e6f40);
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0, 90, 38, 0.3);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease, background 0.3s ease;
  }

  .pathologies-footer-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 10px 28px rgba(0, 90, 38, 0.4);
    background: linear-gradient(135deg, #00471e, #175a34);
  }
</style>

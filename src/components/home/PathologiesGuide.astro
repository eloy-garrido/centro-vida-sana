---
import { pathologiesData } from '../../data/pathologies';
import { professionals } from '../../data/professionals';
---

<section id="patologias" class="py-20 lg:py-28 bg-canvas-muted/50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 lg:mb-18">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-ink-muted mb-3">
        Guía de Dolencias y Síntomas
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-semibold text-ink-primary tracking-tight mb-4">
        ¿Qué Dolor o Malestar Tienes?
      </h2>
      <p class="text-base sm:text-lg text-ink-secondary leading-relaxed">
        No necesitas saber qué técnica solicitar de antemano. Identifica tu síntoma y te guiaremos hacia el especialista y tratamiento adecuado.
      </p>
    </div>

    <!-- Pathologies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pathologiesData.map(item => {
        let badgeClass = '';
        let borderHoverClass = '';
        let targetPhone = professionals.felipe.phone;
        let proName = professionals.felipe.name;

        if (item.discipline === 'quiropraxia') {
          badgeClass = 'bg-petrol-light text-petrol border-petrol-border';
          borderHoverClass = 'hover:border-petrol';
          targetPhone = professionals.felipe.phone;
          proName = professionals.felipe.name;
        } else if (item.discipline === 'acupuntura') {
          badgeClass = 'bg-sage-light text-sage border-sage-border';
          borderHoverClass = 'hover:border-sage';
          targetPhone = professionals.eduardo.phone;
          proName = professionals.eduardo.name;
        } else {
          badgeClass = 'bg-gradient-to-r from-petrol-light via-surface to-sage-light text-ink-primary border-surface-border font-bold';
          borderHoverClass = 'hover:border-ink-muted';
          targetPhone = professionals.felipe.phone;
          proName = 'Felipe & Eduardo';
        }

        const waUrl = `https://wa.me/${targetPhone.replace('+', '')}?text=${encodeURIComponent(item.whatsappMessage)}`;

        return (
          <div class={`rounded-2xl bg-surface border border-surface-border p-6 shadow-soft ${borderHoverClass} transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1`}>
            <div>
              <div class="mb-4">
                <span class={`inline-block px-3 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider border ${badgeClass}`}>
                  {item.badgeLabel}
                </span>
              </div>

              <h3 class="font-serif text-xl font-bold text-ink-primary mb-2 leading-snug group-hover:text-petrol transition-colors">
                {item.name}
              </h3>

              <p class="text-xs font-semibold text-ink-muted mb-3">
                {item.subtitle}
              </p>

              <p class="text-xs text-ink-secondary leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <div class="pt-4 border-t border-surface-border">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-press w-full inline-flex items-center justify-between py-2.5 px-3.5 rounded-xl bg-canvas border border-surface-border hover:bg-surface text-xs font-semibold text-ink-primary group-hover:border-ink-secondary transition-colors cursor-pointer"
              >
                <span>Consultar por este dolor</span>
                <svg class="w-4 h-4 text-ink-muted group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Banner de Atención Combinada -->
    <div class="mt-12 max-w-4xl mx-auto p-6 sm:p-8 rounded-3xl bg-surface border-2 border-surface-border shadow-soft flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">¿Tu dolor es complejo o recurrente?</span>
        <h4 class="font-serif text-xl font-bold text-ink-primary">
          Evaluación Dual: Quiropraxia + Acupuntura en conjunto
        </h4>
        <p class="text-xs text-ink-secondary max-w-xl">
          Para dolores crónicos severos como ciática aguda o fibromialgia, coordinamos sesiones combinadas donde ambos profesionales sincronizan tu plan de recuperación.
        </p>
      </div>
      <a
        href="https://wa.me/56973700616?text=Hola,%20quisiera%20consultar%20por%20una%20evaluaci%C3%B3n%20combinada%20de%20Quiropraxia%20y%20Acupuntura."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-press shrink-0 px-6 py-3 rounded-xl bg-ink-primary text-white text-xs font-semibold shadow-soft hover:bg-black transition-colors"
      >
        Consultar Plan Combinado
      </a>
    </div>

  </div>
</section>
